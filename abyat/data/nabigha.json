 عالمٍ بالطّعنِ، كرّارِ"],["وظلّ، في سبعة ٍ منها لحِقنَ به","يكُرّ بالرّوقِ فيها كَرّ إسوارِ"],["حتى إذا قَضَى منها لُبانَتَهُ","وعادَ فيها بإقبالٍ وإدبارِ"],["انقضّ ، كالكوكبِ الدريّ ، منصلتاً","يهوي ، ويخلطُ تقريباً بإحضارِ"],["فذاكَ شبْهُ قَلوصى ، إذ أضَرّ بها","طولُ السرى والسرى من بعد أسفارِ"]],"src":"https://ar.wikisource.org/wiki/%D8%B9%D9%88%D8%AC%D9%88%D8%A7_%D9%81%D8%AD%D9%8A%D9%88%D8%A7_%D9%84%D9%86%D8%B9%D9%85_%D8%AF%D9%85%D9%86%D8%A9_%D8%A7%D9%84%D8%AF%D8%A7%D8%B1"},"nabigha-0042":{"t":"فإن يك عامر قد قال جهلا","v":[["فإنْ يَكُ عامِرٌ قد قالَ جَهلاً","فإنّ مَظِنّةَ الجَهْلِ الشّبابُ"],["فكُنْ كأبيكَ، أو كأبي بَراءٍ","توافقكَ الحكومةُ والصوابُ"],["ولا تَذهَبْ. بحِلمِكَ، طامِياتٌ","منَ الخيلاءِ، ليسَ لهنّ بابُ"],["فإنكَ سوفَ تحلمُ، أو تناهى","إذا ما شبتَ، أو شابَ الغرابُ"],["فإن تكُنِ الفَوارِسُ، يومَ حِسْيٍ","أصابوا، مِنْ لِقائِكَ، ما أصابوا"],["فما إنْ كانَ مِنْ نَسَبٍ بَعيدٍ","ولكنْ أدرَكوكَ، وهُمْ غِضابُ"],["فوارسُ، منْ منولةَ، غيرُ ميلٍ","و مرةً، فوقَ جمعهمُ العقابُ"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D8%A5%D9%86_%D9%8A%D9%83_%D8%B9%D8%A7%D9%85%D8%B1_%D9%82%D8%AF_%D9%82%D8%A7%D9%84_%D8%AC%D9%87%D9%84%D8%A7"},"nabigha-0043":{"t":"فإن يكون قد قضى من خله وطرا","v":[["فإن يكون قد قضَى، من خِلّه وطراً","فإنّني منك لمّا أقضِ أوطاري"],["يدني عليهنّ دفاً، ريشهُ هدمٌ","و جؤجؤاً، عظمه، من لحمه، عارِ"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D8%A5%D9%86_%D9%8A%D9%83%D9%88%D9%86_%D9%82%D8%AF_%D9%82%D8%B6%D9%89_%D9%85%D9%86_%D8%AE%D9%84%D9%87_%D9%88%D8%B7%D8%B1%D8%A7"},"nabigha-0045":{"t":"قالت بنو عامر : خالوا بني اسد","v":[["قالتْ بنو عامرٍ: خالوا بني اسدٍ","يا بؤسَ للجَهْلِ، ضَرّاراً لأقوامِ"],["يأبى البلاءُ، فلا نبغي بهمْ بدلاً","و لا نريدُ خلاءً بعدَ إحكامِ"],["فصالِحُونا جَميعاً، إنْ بَدا لكُمُ","و لا تقولوا لنا أمثالها، عامِ"],["إني لأخشَى عليكمْ أن يكونَ لكُمْ","من أجلِ بَغضائِهِمْ، يوْمٌ كأيّامِ"],["تَبدو كَواكِبُهُ، والشّمسُ طالعةٌ","لا النورُ نورٌ، ولالإظلامُ إظلامُ"],["أو تَزْجُرُوا مُكْفَهِراً لا كِفاءَ له","كاللّيْلِ يخلِطُ أصراماً بأصْرامِ"],["مستحقبي حلقِ الماذيّ، يقدمهم","سشمُّ العرانينِ، ضرابونَ للهامِ"],["لهمْ لواءٌ بكفيْ ماجدٍ بطلٍ","لا يَقطَعُ الخَرْقَ إلاّ طَرْفُهُ سامِ"],["يَهدي كتائبَ خُضرا، ليس يَعصِمها","إلاّ ابتدارٌ، إلى موتٍ، بإللجامِ"],["كم غادرَتْ خَيلُنا منكم، بُمعتركٍ","للخامعاتِ، أكفاً بعدَ أقدامِ"],["يا ربّ ذاتِ خليلٍ قد فجعنَ بهِ","ومُؤتَمِينَ، وكانوا غَيرَ أيتْامِ"],["والخَيلُ تَعْلَمُ أنّا، في تجاوُلِها","عندَ الطعانِ، أولو بؤسى وإنعامِ"],["و لوا، وكبشهمُ يكبو لجبهتهِ","عندَ الكُماةِ صَريعاً، جوفُهُ دامِ"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D8%A7%D9%84%D8%AA_%D8%A8%D9%86%D9%88_%D8%B9%D8%A7%D9%85%D8%B1_%3A_%D8%AE%D8%A7%D9%84%D9%88%D8%A7_%D8%A8%D9%86%D9%8A_%D8%A7%D8%B3%D8%AF"},"nabigha-0046":{"t":"كأن الظعن حين طفون ظهرا","v":[["كأنّ الظُّعنَ، حينَ طَفَوْنَ ظُهراً","سَفِينُ البَحرِ يَمّمْنَ القَراحاَ"],["قفا، فتبينا أعريتناتٍ","يوخي الحيُّ، أمْ أموا لباحا"],["كأنّ، على الحدوجِ، نعاجَ رملٍ","زهاها الذعرُ، أو سمعتْ صياحاَ"]],"src":"https://ar.wikisource.org/wiki/%D9%83%D8%A3%D9%86_%D8%A7%D9%84%D8%B8%D8%B9%D9%86_%D8%AD%D9%8A%D9%86_%D8%B7%D9%81%D9%88%D9%86_%D8%B8%D9%87%D8%B1%D8%A7"},"nabigha-0047":{"t":"كأن قتودي والنسوع جرى بها","v":[["كأنَّ قتودي، والنسوعُ جرى بها","مصكٌّ، يباري الجونَ، جأبٌ معقربُ"],["رعى الروضَ حتى نشتِ الغدرُ والتوتْ","برِجْلاتِها، قِيعانُ شرجٍ وأيهَبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%83%D8%A3%D9%86_%D9%82%D8%AA%D9%88%D8%AF%D9%8A_%D9%88%D8%A7%D9%84%D9%86%D8%B3%D9%88%D8%B9_%D8%AC%D8%B1%D9%89_%D8%A8%D9%87%D8%A7"},"nabigha-0048":{"t":"كتمتك ليلا بالجمومين ساهرا","v":[["كتمتكَ ليلاً بالجمومينَ ساهرا","وهَمّينِ: هَمّاً مُستَكنّاً وظاهرَا"],["أحاديثَ نَفسٍ تَشتَكي ما يَريبُها","وَوِرْدُ هُمومٍ لم يَجِدْنَ مَصادِرَا"],["تُكَلّفُني أنْ يَفعَلَ الدّهرُ هَمّها","و هل وجدتْ قبلي على الدهرِ قادرا؟"],["ألَمْ تَرَ خَيرَ النّاسِ أصْبَحَ نَعْشُهُ","على فِتيَةٍ، قد جاوَزَ الحَيَّ، سائِرَا"],["و نحنُ لديهِ، نسألُ اللهَ خلدهُ","يردّ لنا ملكاً، وللأرضِ، عامرا"],["ونحنُ نُرَجّي الخلُدَ إن فازَ قِدحنُا","و نرهبُ قدحَ الموتِ إن جاء قامرا"],["لكَ الخيرُ إن وارتْ بك الأرضُ واحداً","و اصبحَ جدُّ الناسِ يظلعُ، عاثرا"],["وردتْ مطايا الراغبينَ، وعريتْ","جيادكَ، لا يحفي لها الدهرُ حافرا"],["رأيتُكَ تَرعاني بعينٍ بَصيرَةٍ","وتَبعَثُ حُرّاساً عليّ ونَاظِرَا"],["و ذلكَ منْ قولٍ أتاكَ أقولهُ","ومِنْ دَسّ أعدائي إليكَ المآبِرَا"],["فآلَيتُ لا آتيكَ، إن جئتُ، مُجْرماً","و لا أبتغي جاراً، سواكَ، مجاورا"],["فأهْلي فِداءُ لامْرِىءٍ، إنْ أتَيتُهُ","تَقَبّلَ مَعرُوفي، وسَدّ المَفاقِرَا"],["سأكعمُ كلبي أن يربيكَ نبحهُ","وإن كنتُ أرعى مُسحَلانَ فحامرَا"],["و حلتْ بيوتي في يفاعٍ ممنعٍ","تَخالُ به راعي الحَمولةِ طائِرَا"],["تزلّ الوعولُ العصمُ عن قذفاتهِ","وتُضحي ذُراهُ، بالسحابِ، كوافِرَا"],["حِذاراً على أنْ لا تُنالَ مَقادَتي","و لا نسوتي حتى يمتنَ حرائرا"],["أقولُ، وإن شطتْ بيَ الدارُ عنكمُ","غذا ما لقينا من معدٍ مسافرا"],["ألِكنْي إلى النّعمانِ حيثُ لَقيتَهُ","فأهْدَى لهُ اللَّهُ الغُيوثَ البَواكِرَا"],["و صصبحهُ فلجٌ ولا زالَ كعبهُ","على كلّ من عادى من الناس، ظاهرا"],["و ربَّ عليهِ اللهُ أحسنَ صنعهِ","وكانَ لهُ، على البَريّةِ، ناصِرَا"],["فألْفَيتُهُ يَومْاً يُبِيدُ عَدُوَّهُ","وبَحْرَ عَطاءٍ، يَستَخِفّ المَعابِرَا"]],"src":"https://ar.wikisource.org/wiki/%D9%83%D8%AA%D9%85%D8%AA%D9%83_%D9%84%D9%8A%D9%84%D8%A7_%D8%A8%D8%A7%D9%84%D8%AC%D9%85%D9%88%D9%85%D9%8A%D9%86_%D8%B3%D8%A7%D9%87%D8%B1%D8%A7"},"nabigha-0049":{"t":"كليني لهم يا أميمة ناصب","v":[["كليني لهمٍ ، يا أميمة َ ، ناصبِ","و ليلٍ أقاسيهِ ، بطيءِ الكواكبِ"],["تطاولَ حتى قلتُ ليسَ بمنقضٍ","و ليسَ الذي يرعى النجومَ بآيبِ"],["و صدرٍ أراحَ الليلُ عازبَ همهِ","تضاعَفَ فيه الحزْنُ من كلّ جانبِ"],["عليَّ لعمرو نعمة ٌ ، بعد نعمة ٍ","لوالِدِه، ليست بذاتِ عَقارِبِ"],["لئِن كانَ للقَبرَينِ: قبرٍ بجِلّقٍ","وقبرٍ بصَيداء، الذي عندَ حارِبِ"],["وللحارِثِ الجَفْنيّ، سيّدِ قومِهِ","لَيَلْتَمِسَنْ بالجَيْشِ دارَ المُحارِبِ"],["و ثقتُ له النصرِ ، إذ قيلَ قد غزتْ","كتائبُ منْ غسانَ ، غيرُ أشائبِ"],["بنو عمه دنيا ، وعمرو بنُ عامرٍ","أولئِكَ قومٌ، بأسُهُم غيرُ كاذبِ"],["إذا ما غزوا بالجيشِ ، حلقَ فوقهمْ","عَصائبُ طَيرٍ، تَهتَدي بعَصائبِ"],["يُصاحِبْنَهُمْ، حتى يُغِرْنَ مُغارَهم","مِنَ الضّارياتِ، بالدّماءِ، الدّوارِبِ"],["تراهنّ خلفَ القوْمِ خُزْراً عُيُونُها","جُلوسَ الشّيوخِ في ثيابِ المرانِبِ"],["جوَانِحَ، قد أيْقَنّ أنّ قَبيلَهُ","إذا ما التقى الجمعانِ ، أولُ غالبِ"],["لُهنّ علَيهِمْ عادة ٌ قد عَرَفْنَها","إذا عرضَ الخطيّ فوقَ الكواثبِ"],["على عارفاتٍ للطعانِ ، عوابسٍ","بهنّ كلومٌ بين دامٍ وجالبِ"],["إذا استُنزِلُوا عَنهُنّ للطّعنِ أرقلوا","إلى الموتِ ، إرقالَ الجمالِ المصاعبِ"],["فهمْ يتساقونَ المنية َ بينهمْ","بأيديهمُ بيضٌ ، رقاُ المضاربِ"],["يطيرُ فضاضاً بينها كلُّ قونسٍ","ويتبَعُها مِنهُمْ فَراشُ الحواجِبِ"],["ولا عَيبَ فيهِمْ غيرَ أنّ سُيُوفَهُمْ","بهنّ فلولٌ منْ قراعِ الكتائبِ"],["تورثنَ منْ أزمانِ يومِ حليمة ٍ","إلى اليومِ قد جربنَ كلَّ التجاربِ"],["تَقُدّ السَّلُوقيَّ المُضاعَفَ نَسْجُهُ","وتُوقِدُ بالصُّفّاحِ نارَ الحُباحِبِ"],["لهمٌ شيمة ٌ ، لم يعطها اللهُ غيرهمْ","منَ الجودِ، والأحلامُ غيرُ عَوازِبِ"],["محلتهمْ ذاتُ الإلهِ ، ودينهمْ","قويمٌ ، فما يرجونَ غيرَ العواقبِ"],["رقاقُ النعالِ ، طيبٌ حجزاتهمْ","يُحيَوّنْ بالريحانِ يومَ السبَّاسِبِ"],["تُحَيّيهم بيضُ الولائِدِ بينَهُم","وأكسِية الأضريج فوق المشاجِبِ"],["يصونونَ أجساداً قديماً نعيمُها","بخَالصَةِ الأرْدَانِ خُضرِ المناكِبِ"],["ولا يحسِبُونَ الخيرَ لا شَرّ بعدهُ","ولا يحسِبُون الشرّ ضربةَ لازبِ"],["حَبَوتُ بها غسّانَ إذْ كنتُ لاحقاً","بقَومي وإذْ أعْيَت عليَّ مذاهبي"]],"src":"https://ar.wikisource.org/wiki/%D9%83%D9%84%D9%8A%D9%86%D9%8A_%D9%84%D9%87%D9%85_%D9%8A%D8%A7_%D8%A3%D9%85%D9%8A%D9%85%D8%A9_%D9%86%D8%A7%D8%B5%D8%A8"},"nabigha-0050":{"t":"لا يبعد الله جيرانا تركتهم","v":[["لا يُبْعِدِ اللَّهُ جيراناً، تركْتُهُمُ","مثلَ المَصابيحِ، تجلو لَيلةَ الظُّلَمِ"],["لا يبرمونَ، إذا ما الأفقُ جللهُ","بردُ الشتاءِ، منَ الإمحالِ، كالأدم"],["همُ الملوكُ وأبناءُ الملوكِ لهمْ","فضْلٌ على النّاسِ، في اللأواء والنِّعمِ"],["أحْلامُ عادٍ، وأجسادٌ مُطَهَّرَةٌ","منَ المعقةِ والآفاتِ والإثمِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%A7_%D9%8A%D8%A8%D8%B9%D8%AF_%D8%A7%D9%84%D9%84%D9%87_%D8%AC%D9%8A%D8%B1%D8%A7%D9%86%D8%A7_%D8%AA%D8%B1%D9%83%D8%AA%D9%87%D9%85"},"nabigha-0051":{"t":"لعمرك ما خشيت على يزيد","v":[["لعَمْرُكَ، ما خَشيتُ على يَزيدٍ","مِنَ الفَخْرِ المُضَلّلِ، ما أتاني"],["كأنّ التّاجَ، مَعصُوباً عليهِ","لأذوادٍ أُصِبْنَ بذي أبَانِ"],["فحسبكَ أن تهاضَ بمحكماتٍ","يَمُرّ بها الرّوِيّ على لِساني"],["فقَبْلَكَ ما شُتِمْتُ وقاذَ عُوني","فما نَزُرَ الكَلامُ ولا شَجاني"],["يصدّ الشاعرُ الثنيانُ عني","صدودَ البكرِ عن قرمٍ هجانِ"],["أثرتَ الغيّ، ثمّ نزعتَ عنهُ","كمَا حادَ الأزَبُّ عن الظِّعانِ"],["فإنً يقدرً عليكَ أبو قبيسٍ","تمطَّ بكَ المعيشةُ في هوانِ"],["و تخضبْ لحيةٌ، غدرتْ وخانتْ","بأحمرَ، من نجيعِ الجوفِ، آني"],["وكنتَ أمِينَةُ، لوْ لم تَخُنْهُ","و لكنْ لا أمانةَ لليمانِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%B9%D9%85%D8%B1%D9%83_%D9%85%D8%A7_%D8%AE%D8%B4%D9%8A%D8%AA_%D8%B9%D9%84%D9%89_%D9%8A%D8%B2%D9%8A%D8%AF"},"nabigha-0052":{"t":"لعمري لنعم المرء من آل ضجعم","v":[["لعمري، لنعمَ المرءُ من آلِ ضجعمٍ","تزورُ ببُصرى، أو ببُرقةِ هارِبِ"],["فتى، لم تلدهُ بنتُ أمٍ قريبةٍ","فيضوي، وقد يضوى رديدُ الأقاربِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%B9%D9%85%D8%B1%D9%8A_%D9%84%D9%86%D8%B9%D9%85_%D8%A7%D9%84%D9%85%D8%B1%D8%A1_%D9%85%D9%86_%D8%A2%D9%84_%D8%B6%D8%AC%D8%B9%D9%85"},"nabigha-0053":{"t":"لقد قلت للنعمان يوم لقيته","v":[["لقد قلتُ للنّعمانِ، يوْمَ لَقيتُهُ","يُريدُ بني حُنّ، ببُرقَةِ صادِرِ"],["تجنبْ بني حنّ، فإنّ لقاءهمْ","كريهٌ، وإنْ لم تَلقَ إلاّ بصابِرِ"],["عِظامُ اللُّهىَ، أوْلادُ عُذْرَةَ إنّهُمْ","لهاميمُ، يستلهونها بالحناجرِ"],["و همْ منعوا وادي القرى من عدوهم","بجمعٍ مبيرٍ للعدوّ المكاثرِ"],["منَ الوارداتِ الماءِ بالقاعِ تستقي","بأعجازها، قبلَ استقاءِ الخناجرِ"],["بُزاخِيّةٍ ألْوَتْ بلِيفٍ، كأنّهُ","عفاءُ قلاصٍ، طارَ عنها، تواجرُ"],["صغارِ النوى مكنوزةٍ ليسَ قشرها","إذا طارَ قِشرُ التَّمْرِ، عنها بطائِرِ"],["هُمُ طَرَدوا عَنها بَلِيّاً، فأصبْحتْ","بَلِيُّ بوادٍ، من تِهامةَ، غائِرِ"],["و هم منعوها من قضاعةَ كلها","و من مضرَ الحمراءِ، عند التغاورِ"],["و هم قتلوا الطائيَّ بالحجر، عنوةً","أبا جابرٍ، واستَنكَحوا أُمَّ جابرِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%82%D8%AF_%D9%82%D9%84%D8%AA_%D9%84%D9%84%D9%86%D8%B9%D9%85%D8%A7%D9%86_%D9%8A%D9%88%D9%85_%D9%84%D9%82%D9%8A%D8%AA%D9%87"},"nabigha-0054":{"t":"لقد نهيت بني ذبيان عن أقر","v":[["لقد نهيتُ بني ذبيانَ عن أقرٍ","وعنَ ترَبُّعِهِمْ في كلّ أصْفارِ"],["وقلتُ: يا قومُ، إن اللّيثَ مُنقَبِضٌ","على براثنهِ، للوثبةِ الضاري"],["لا أعْرِفَنْ رَبْرَباً حُوراً مَدامِعُها","كأنّ أبكارها نعاجُ دوارِ"],["ينْظرْنَ شزْراً إلى من جاء عن عُرُضٍ","بأوجهٍ منكراتِ الرقّ، أحرارِ"],["خَلَفَ العضاريطِ لا يوقَينَ فاحشةً","مستمسكاتٍ بأقتابٍ وأكوارِ"],["إما عُصِيتُ، فإنّي غيرُ مُنفَلِتٍ","مني اللصابُ، فجنبا حرةِ النارِ"],["أو أضعُ البيتَ في سوداءِ مظلمةٍ","تقيدُ العيرَ، لا يسري بها الساري"],["تدافعُ الناسَ عنا، حينَ نركبها","من المظالمِ تدعى أمّ صبارِ"],["ساق الرفيداتِ من جوش ومن عظمٍ","و ماشَ منْ رهطِ ربعيٍ وحجارِ"],["قَرْمَيْ قُضاعةَ حَلاً حَولَ حُجرته","مَدّا عليهِ بسُلاّفٍ أنْفارِ"],["حتى استقلّ بجمعٍ، لا كفاءَ له","ينفي الوحوشَ عن الصحراءِ جرارِ"],["لا يَخفِضُ الرِّزّ عن أرضٍ ألَمّ بها","ولا يَضِلُّ على مصباحِهِ السّاري"],["وعَيّرَتْني بَنُو ذُبيانَ خَشْيَتَهُ","وهل عليّ بأنْ أخشاكَ مِنْ عَارِ؟"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%82%D8%AF_%D9%86%D9%87%D9%8A%D8%AA_%D8%A8%D9%86%D9%8A_%D8%B0%D8%A8%D9%8A%D8%A7%D9%86_%D8%B9%D9%86_%D8%A3%D9%82%D8%B1"},"nabigha-0055":{"t":"ليهنئ بني ذبيان أن بلادهم","v":[["ليهنئ بني ذبيانَ أنّ بلادهمْ","خلتْ لهمُ من كلّ مولى وتابعِ"],["سوى أسدٍ يحمونها كلّ شارقٍ","بألفَيْ كَمّيٍ ذي سِلاحٍ، ودارِعِ"],["قُعُوداً على آلِ الوجيهِ ولاحقٍ","يقيمونَ حولياتها بالمقارعِ"],["يهزونَ أرماحاً طوالاً متونها","بأيْدٍ طوالٍ، عارياتِ الأشاجِعِ"],["فدَعْ عَنكَ قوْماً لا عِتابَ عَلَيهِمُ","هُمُ ألحَقُوا عَبسْاً بأرضِ القعاقِعِ"],["و قد عسرتْ، من دونهمْ بأكفهمْ","بنو عامرٍ عسرَ المخاضِ الموانعِ"],["فما أنا في سهمٍ، ولا نصرِ مالكٍ","و مولاهمُ عبدِ بنِ سعدٍ، بطامعِ"],["إذا نزَلوا ذا ضَرْغَدٍ، فعُتائِداً","يُغَنّيِهمُ فيها نَقيقُ الضفادِعِ"],["قُعُوداً لَدَى أبياتِهِمْ يَشْمِدونَها","رمى اللهُ في تلكَ الأنوفِ الكوانعِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%8A%D9%87%D9%86%D8%A6_%D8%A8%D9%86%D9%8A_%D8%B0%D8%A8%D9%8A%D8%A7%D9%86_%D8%A3%D9%86_%D8%A8%D9%84%D8%A7%D8%AF%D9%87%D9%85"},"nabigha-0056":{"t":"ماذا رزئنا به من حية ذكر","v":[["ماذا رُزِئْنا بهِ من حَيّةٍ ذكَرٍ","نَضناضَةٍ بالرّذايا، صِلِّ أصلالِ"],["لا يهنئِ الناسَ ما يرعونَ من كلاءٍ","و ما يسوقونَ من أهلٍ ومنْ مالِ"],["بعدَ ابنِ عاتكةَ الثاوي على أبوى","أضحى ببلدةٍ لا عَمٍّ ولا خالِ"],["سهلِ الخليفةِ، مشاءٍ بأقدمهِ","إلى ذواتِ الذّرى، حمّالِ أثْقالِ"],["حسبُ الخليلينِ نأويُ الأرضِ بينهما","هذا عليها، وهذا تحتَها بالي"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7%D8%B0%D8%A7_%D8%B1%D8%B2%D8%A6%D9%86%D8%A7_%D8%A8%D9%87_%D9%85%D9%86_%D8%AD%D9%8A%D8%A9_%D8%B0%D9%83%D8%B1"},"nabigha-0058":{"t":"معلقة النابغة الذبياني","v":[["يا دارَ مَيّةَ بالعَليْاءِ فالسَّنَد","أقْوَتْ وطَالَ عليها سالفُ الأبَدِ"],["رُدَّتْ عليَهِ أقاصيهِ،ولَبَّدَهُ","ضَرْبُ الوليدةِ بالمِسْحاة ِ في الثَّأَدِ"],["خلَّتْ سَبيلَ أتيٍّ كانَ يَحبسُهُ","ورَفَّعتْهُ إلى السَّجْفينِ فالنَّضَدِ"],["أمسَتْ خَلاءً وأمسَى أهلُها احْتمَلُوا","أخْنَى عَليها الذي أخْنَى على لُبَدِ"],["فعَدِّ عَمَّا ترَى إذْ لا ارتِجاعَ لهُ","وانْمِ القُتُودَ على عَيْرانةٍ أُجُدِ"],["مَقْذوفةٍ بدَخيس النَّحْضِ بازِلُها","له صَريفٌ صَريفَ القَعْوِ بالمَسَدِ"],["كأنَّ رَحْلي وقد زالَ النّهارُ بنا","يَومَ الجَليلِ على مُستأنِسٍ وحَدِ"],["مِن وَحشِ وَجرةَ مَوشيٍّ أكارِِعهُ","طَاوِي المَصيرِ كَسِيفِ الصَّيقَلِ الفَرَدِ"],["سَرتْ عليه مِن الجَوزاءِ سَاريةٌ","تُزجي الشَّمالُ عليهِ جامِدَ البَرَدِ"],["فَارتاعَ مِن صَوتِ كلابٍ فباتَ لهُ","طَوْعَ الشَّوامتِ مِن خَوْفٍ ومِن صَرَدِ"],["وكانَ ضُمْرانُ مِنهُ حيثُ يُوزِعُهُ","طَعنَ المُعارِكِ عند المَحجَرِ النَّجُدِ"],["شكَّ الفَريصةَ بالمِدْرَى فأنفَذَها","طَعنَ المُبَيطِرِ إذ يَشفي مِن العَضَدِ"],["كأنّهُ خارجًا من جَنبِ صَفْحَتَهِ","سَفُّودُ شَرْبٍ نَسُوهُ عِندَ مُفْتَأدِ"],["فظَلَّ يَعجَمُ أعلَى الرَّوْقِ مُنقبضًا","في حَالكِ اللَّوْنِ صدقٍ غَيرِ ذي أوَدِ"],["لمَّا رأى واشقٌ إقعاصَ صاحبِهِ","ولا سَبيلَ إلى عَقلٍ ولا قَوَدِ"],["قالتْ له النفسُ :إنِّي لا أرَى طَمعًا","وإنَّ مَوْلاكَ لم يَسْلمْ ولم يَصِدِ"],["فَتلكَ تُبلِغُني النُّعمانَ أنَّ لهُ","فضلاً على النَّاسِ في الأدنَى وفي البَعَدِ"],["ولا أرَى فاعِلاً في النَّاسِ يُشبِهُهُ","ولا أُحاشِي مِن الأقْوَامِ من أحَدِ"],["إلاّ سُليمانَ إذ قالَ الإلهُ لهُ","قًُمْ في البريَّةِ فاحْدُدْها عنِ الفَنَدِ"],["وخيِّسِ الجِنَّ إنّي قد أَذِنْتُ لهمْ","يَبْنُونَ تَدْمُرَ بالصُّفَّاحِ والعَمَدِ"],["فمَنْ أطاعَكََ فانفَعْهُ بطاعتهِ","كما أطاعَكَ وادْلُلْهُ على الرَّشَّدِ"],["ومنْ عَصاكَ فعاقِبْهُ مُعاقَبَةً","تَنْهَى الظَّلومَ ولا تَقعُدْ على ضَمَدِ"],["إلاّ لِمثْلِك َ، أوْ مَنْ أنتَ سَابِقُهُ","سبقَ الجوادِ إذا اسْتَولَى على الأمَدِ"],["أعطَى لفارِهَةٍ حُلوٍ توابِعُها","منَ المَواهِبِ لا تُعْطَى على نَكَدِ"],["الواهِبُ المائَةَ المعْكاءَ زيَّنَها","سَعْدانُ توضِحُ في أوْبارِها اللِّبَدِ"],["والراكضَاتِ ذُيولَ الرَّيْطِ فَنَّقَها","بَرْدُ الهَواجرِ كالغزلانِ بالجَردِ"],["والخَيلَ تَمزَغُ غربًا في أعِنَّتِها","كالطَّيرِ تَنجو من الشُّؤْبوبِ ذي البَرَدِ"],["والأُدمُ قدْ خُيِّسَتْ فُتلاً مَرافِقُها","مَشدودَةً برِحَالِ الحِيِرة ِ الجُدَدِ"],["واحْكمْ كَحُكمِ فَتاة ِ الحيِّ إذْ نَظَرتْ","إلى حَمامِ شِراعٍ وَارِدِ الثَّمَدِ"],["فلا لَعَمْرُ الذي مَسَّحتُ كَعبتَهُ","وما هُريقَ على الأنْصابِ من جَسَدِ"],["والمؤمنِ العائِذاتِ الطّيرَ تمسَحُها","رُكْبانَ مكَّة َ بينَ الغَيْلِ والسَّعَدِ"],["ما إنْ أتيتُ بشَيءٍ أنتَ تَكْرهُهُ","إذًا فلا رَفَعَتْ سَوْطي إليَّ يَدِي"],["إلاّ مقالة َ أقوامٍ شَقيتُ بها","كانَتْ مقالَتُهُمْ قَرْعًا على الكَبِدِ"],["إذًا فَعاقبني ربِّي مُعاقبةً","قَرَّتْ بها عَينُ منْ يأتيكَ بالفَنَدِ"],["هذا لأبرأَ مِنْ قَوْلٍ قُذِفْتُ بِهِ","طَارَتْ نَوافِذُهُ حَرًّا على كَبِدي"],["أُنْبِئْتُ أنَّ أبا قابوسَ أوْعَدَني","ولا قَرارَ على زَأْرٍ منَ الأسَدِ"],["مَهْلاً فِداءٌ لك الأقوامِ كُلّهُمُ","وما أُثَمِّرُ من مالٍ ومنْ وَلَدِ"],["لا تَقْذِفْني بِرُكْنٍ لا كَفاءَ لهُ","وإنْ تَأثَّفَكَ الأعداءُ بالرَّفَدِ"],["فما الفُراتُ إذا هَبَّ الرِّياحُ لهُ","تَرمي أواذيُّهُ العبْرَينِ بالزَّبَدِ"],["يَمُدُّهُ كلُّ وادٍ مُتْرَعٍ لَجِبٍ","فيهِ رِكامٌ من اليَنْبوتِ والخَضَدِ"],["يظَلُّ مِن خَوفِهِ المَلاَّحُ مُعتَصِمًا","بالخَيْزرانَةِ بَعدَ الأيْنِ والنَّجَدِ"],["يومًا بِأجْوَدَ منهُ سَيْبَ نافِلَةٍ","ولا يَحُولُ عَطاءُ اليومِ دونَ غَدِ'"],["هذا الثَّناءُ فإنْ تَسمَعْ به حَسَنًا","فلم أُعرِّض أبَيتَ اللّعنَ بالصَّفَدِ"],["ها إنَّ ذي عِذرَة ٌ إلاَّ تكُنْ نَفَعَتْ","فإنَّ صاحبَها مُشاركُ النَّكَدِ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%B9%D9%84%D9%82%D8%A9_%D8%A7%D9%84%D9%86%D8%A7%D8%A8%D8%BA%D8%A9_%D8%A7%D9%84%D8%B0%D8%A8%D9%8A%D8%A7%D9%86%D9%8A"},"nabigha-0059":{"t":"من مبلغ عمرو بن هند آية","v":[["من مبلغٌ عمرو بنَ هندٍ آيةٍ","ومنَ النَّصيحَةِ كثرةُ الإنذارِ"],["لاأعرِفَنّكَ عارِضاً لرِماحنِا","في جفّ تغلب، واديَ الامرارِ"],["يا لهفَ أمّي، بعدَ أسرَةِ جَعوَلٍ","ألاّ أُلاقيَهم ورهطَ عِرارِ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D9%86_%D9%85%D8%A8%D9%84%D8%BA_%D8%B9%D9%85%D8%B1%D9%88_%D8%A8%D9%86_%D9%87%D9%86%D8%AF_%D8%A2%D9%8A%D8%A9"},"nabigha-0061":{"t":"نات بسعاد عنك نوى شطون","v":[["ناتْ بسعادَ عنكَ نوى شطونُ","فبانَتْ، والفؤادُ بها رَهينُ"],["و حلتْ في بني القينِ بن جسرٍ","فقد نبغتً لنا ، منهم ، شؤونُ"],["تأوّبني، بِعَمَّلَة َ، اللّواتي","مَنَعْنَ النّومَ، إذ هَدأت عيونُ"],["كأنّ الرحلَ شدّ بهِ خذوفٌ","من الجَوناتِ، هاديَة ٌ عَنونُ"],["منَ المستعرضاتِ بعينِ نخلٍ","كأنّ بَياضَ لَبّتِهِ سَدينُ"],["كقوسِ الماسخيّ ، أرنّ فيها","منَ الشّرعيّ، مَربوعٌ مَتينُ"],["إلى ابنِ مُحَرِّقٍ أعمَلْتُ نَفسي","و راحلتي ، وقد هدتِ العيونُ"],["اتيتكَ عارياً خلقاً ثيابي","على خوفٍ ، تظنّ بيَ الظنونُ"],["فألْفَيْتُ الأمانَة َ لم تَخُنْهَا","كذلك كانَ نُوحٌ لا يخونُ"]],"src":"https://ar.wikisource.org/wiki/%D9%86%D8%A7%D8%AA_%D8%A8%D8%B3%D8%B9%D8%A7%D8%AF_%D8%B9%D9%86%D9%83_%D9%86%D9%88%D9%89_%D8%B4%D8%B7%D9%88%D9%86"},"nabigha-0064":{"t":"هذا غلام حسن وجهه","v":[["هذا غُلامٌ حَسَنٌ وجهُهُ","مستقبلُ الخيرِ، سريعُ التمامْ"],["للحارِثِ الأكبر، والحارثِ","الأصغرِ، والأعرجِ خيرِ الأنامْ"],["ثمّ لهندٍ، ولهندٍ، وقد","أسرع، في الخيراتِ، منه إمامْ"],["خمسةُ آبائِهِمُ، ما هُمُ؟","همْ خيرُ من يشربُ صوبَ الغمام"]],"src":"https://ar.wikisource.org/wiki/%D9%87%D8%B0%D8%A7_%D8%BA%D9%84%D8%A7%D9%85_%D8%AD%D8%B3%D9%86_%D9%88%D8%AC%D9%87%D9%87"},"nabigha-0065":{"t":"و استبق ودك للصديق ولا تكن","v":[["و استبقِ ودكَ للصديقِ، ولا تكن","قتباً يعضّ بغاربٍ، ملحاحا"],["فالرفقُ يمنٌ، والأناةُ سعادةٌ","فتأنّ في رفقٍ تنالُ نجاحاَ"],["واليأسُ ممّا فاتَ يُعقِبُ راحَةً","ولربّ مَطعَمةٍ تَعودُ ذُباحا"],["يعدُ ابنَ جَفنَةَ وابن هاتكِ عَرشه","و الحارثينِ، بأن يزيدَ فلاحا"],["ولقد رأى أنّ الذين هوَ غالَهُمْ","قد غالَ حميرَ قيلها الصباحاَ"],["والتَّبّعينِ، وذا نُؤاسٍ، غُدوَةً","و علا أذينةَ، سالبَ الأرواحا"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D8%A7%D8%B3%D8%AA%D8%A8%D9%82_%D9%88%D8%AF%D9%83_%D9%84%D9%84%D8%B5%D8%AF%D9%8A%D9%82_%D9%88%D9%84%D8%A7_%D8%AA%D9%83%D9%86"},"nabigha-0066":{"t":"و إن يرجع النعمان نفرح ونبتهج","v":[["و إنْ يرجعِ النعمانُ نفرحْ ونبتهجْ","ويأتِ مَعَدّاً مُلكُها وربيعُهَا"],["ويَرْجعِ إلى غسّانَ، مُلكٌ وسؤدُدٌ","و تلكَ المنى، لو أننا نستطيعها"],["وإنْ يَهْلِكِ النّعمانُ تُعرَ مَطَيّهُ","و يلقَ، إلى جنبِ الفناءِ، قطوعها"],["و تنحطْ حصانٌ، آخرَ الليل، نحطةً","تقضقضُ منها، أو تكادُ ضلوعها"],["على إثرِ خيرِ الناس، إن كانَ هالكاً","و إنْ كانَ في جنبِ الفتاةِ ضجيعها"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D8%A5%D9%86_%D9%8A%D8%B1%D8%AC%D8%B9_%D8%A7%D9%84%D9%86%D8%B9%D9%85%D8%A7%D9%86_%D9%86%D9%81%D8%B1%D8%AD_%D9%88%D9%86%D8%A8%D8%AA%D9%87%D8%AC"},"nabigha-0068":{"t":"وأعيار صوادر عن حماتا","v":[["وأعيارٍ صوادِرَ عن حَماتا","لِبَينِ الكَفرِ والبُرَقِ الدّواني"],["ألا زعمتْ بنو عبسٍ بأني","ألا كَذَبُوا، كبيرُ السنّ فانِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A3%D8%B9%D9%8A%D8%A7%D8%B1_%D8%B5%D9%88%D8%A7%D8%AF%D8%B1_%D8%B9%D9%86_%D8%AD%D9%85%D8%A7%D8%AA%D8%A7"},"nabigha-0070":{"t":"وعريت من مال وخير جمعته","v":[["وعُرّيتُ مِن مالٍ وخيرٍ جَمَعْتُهُ","كما عُرّيتْ، ممّا تُمرّ، المغازِلُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%B9%D8%B1%D9%8A%D8%AA_%D9%85%D9%86_%D9%85%D8%A7%D9%84_%D9%88%D8%AE%D9%8A%D8%B1_%D8%AC%D9%85%D8%B9%D8%AA%D9%87"},"nabigha-0071":{"t":"وما حاولتما بقياد خيل","v":[["وما حاوَلتُما بقيادِ خَيلٍ","يصولُ الوَرْدُ فيها والكُمَيتُ"],["إلى ذُبيانَ، حتى صبّحَتْهُمْ","و دونهمُ الربائعُ والخبيتُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%A7_%D8%AD%D8%A7%D9%88%D9%84%D8%AA%D9%85%D8%A7_%D8%A8%D9%82%D9%8A%D8%A7%D8%AF_%D8%AE%D9%8A%D9%84"},"nabigha-0072":{"t":"يا عام! لم أعرفك تنكر سنة","v":[["يا عامِ! لم أعرِفك تنكِرُ سُنّةً","بعدَ الذينَ تتَابَعوا بالمَرْصَدِ"],["لو عاينتكَ كماتنا بطوالةٍ","بالحَزْوَريّة، أو بلابةِ ضرغدِ"],["لثويتَ في قدٍّ، هنالك، موثقاً","في القومِ، أو لَثَوَيْتَ غيرَ موَسَّدِ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%B9%D8%A7%D9%85%21_%D9%84%D9%85_%D8%A3%D8%B9%D8%B1%D9%81%D9%83_%D8%AA%D9%86%D9%83%D8%B1_%D8%B3%D9%86%D8%A9"},"nabigha-0073":{"t":"يا مانع الضيم أن يغشى سراتهم","v":[["يا مانعَ الضّيمِ أن يَغشَى سَراتَهُمُ","و حاملَ الإصرِ عنهم، بعدما غرقوا"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%85%D8%A7%D9%86%D8%B9_%D8%A7%D9%84%D8%B6%D9%8A%D9%85_%D8%A3%D9%86_%D9%8A%D8%BA%D8%B4%D9%89_%D8%B3%D8%B1%D8%A7%D8%AA%D9%87%D9%85"},"nabigha-0074":{"t":"يقولون: حصن ثم تأبى نفوسهم","v":[["يقولون: حِصنٌ، ثم تأبَى نفوسُهم","و كيفَ بحصنٍ، والجبالُ جموحُ"],["ولم تَلفظِ الموتَى القُبورُ، ولم تَزلْ","نجومُ السماءِ، والأديمُ صَحيحُ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D9%82%D9%88%D9%84%D9%88%D9%86%3A_%D8%AD%D8%B5%D9%86_%D8%AB%D9%85_%D8%AA%D8%A3%D8%A8%D9%89_%D9%86%D9%81%D9%88%D8%B3%D9%87%D9%85"},"nabigha-0075":{"t":"يوما حليمة كانا من قديمهم","v":[["يومَا حَليمةَ كانَا من قَديمِهِمُ","و عينُ باغٍ، فكانَ الأمرُ ما ائتمرا"],["يا قومُ إنّ ابنَ هندٍ غيرُ تارِكِكُمْ","فلا تكونوا، لأدنَى وقعَةٍ، جَزَرَا"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D9%88%D9%85%D8%A7_%D8%AD%D9%84%D9%8A%D9%85%D8%A9_%D9%83%D8%A7%D9%86%D8%A7_%D9%85%D9%86_%D9%82%D8%AF%D9%8A%D9%85%D9%87%D9%85"}}}