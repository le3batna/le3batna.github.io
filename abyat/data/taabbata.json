{"poet":{"id":"taabbata","short":"تأبط شرًّا","name":"تأبط شرًّا (ثابت بن جابر الفهمي)","en":"Ta'abbata Sharran","era":"pre-islamic"},"poems":{"taabbata-0001":{"t":"أبعد قتيل العوص آسي على فتى","v":[["أَبَعْدَ قَتِيلِ الْعَوْصِ آسِي عَلَى فَتىً","وصاحبِهِ أو يأمُلُ الزَّادَ طارقُ"],["أَأَطْرِدُ نَهْبَاً آخِرَ الَّليْلِ أَبْتَغِي","عُلاَلَةَ يَوْمٍ أَوْ تَعُوق الْعَوَائِقُ"],["لَنِعْمَ فَتىً نِلْتُمْ كَأَنَّ رِدَاءَهُ","على سَرحةٍ من سرحِ دومةَ شانقُ"],["لأَطْرُدَ نَهْبَاً أَوْ نَرُودَ بِفِتْيَةٍ","بأيْمَانِهم سُمرُ القنَى والفتائقُ"],["مساعِرةٌ شُعثٌ كأنَّ عيونَهُم","حَرِيقُ الْغَضَا تُلْفَى عَلَيْهَا شَقَائِقُ"],["فعدُّوا شهورَ الحُرمِ ثمَّ تعرَّفوا","قتيلَ أناسٍ أو فتاةً تعانقُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%A8%D8%B9%D8%AF_%D9%82%D8%AA%D9%8A%D9%84_%D8%A7%D9%84%D8%B9%D9%88%D8%B5_%D8%A2%D8%B3%D9%8A_%D8%B9%D9%84%D9%89_%D9%81%D8%AA%D9%89"},"taabbata-0004":{"t":"إذا أفزعوا أم الصبيين نفضوا","v":[["إذَا أفْزَعُوا أُمَّ الصَّبِيَّيْنِ نَفضُوا","غَفَارِيَّ شُعْثاً صَافَةً لَمْ تُرَجَّلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D8%A3%D9%81%D8%B2%D8%B9%D9%88%D8%A7_%D8%A3%D9%85_%D8%A7%D9%84%D8%B5%D8%A8%D9%8A%D9%8A%D9%86_%D9%86%D9%81%D8%B6%D9%88%D8%A7"},"taabbata-0005":{"t":"إذا الحرب أولتك الكليب فولها","v":[["إذا الحربُ أولَتكَ الكليبَ فوَلِّها","كَلِيبَكَ وَاعْلَمْ أَنَّهَا سَوْفَ تَنْجَلِي"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D8%A7%D9%84%D8%AD%D8%B1%D8%A8_%D8%A3%D9%88%D9%84%D8%AA%D9%83_%D8%A7%D9%84%D9%83%D9%84%D9%8A%D8%A8_%D9%81%D9%88%D9%84%D9%87%D8%A7"},"taabbata-0006":{"t":"إذا المرء لم يحتل وقد جد جده","v":[["إذا المرءُ لم يحتل وقد جدَّ جِدُّهُ","أَضَاعَ وَقَاسَى أمْرَهُ وَهْوَ مُدْبِرُ"],["لكن أخو الحزمِ الذي ليسَ نازِلاً","بِهِ الخطْبُ إلاَّ وَهْوَ لِلْقَصْدِ مُبْصِرُ"],["فذاكَ قريعُ الدّهرِ ما عاشَ حوَّلٌ","إذْا سُدَّ مِنْهُ مَنْخِرٌ جَاشَ مَنْخِرُ"],["أَقُولُ لِلْحَيْانٍ وَقَدْ صَفِرَتْ لَهُمْ","وِطَابِي وَيَوْمِي ضَيِّقُ الجُحْرِ مَعْوِرُ"],["هما خُطَّتا إما إسارٌ ومنَّةٌ","وإما دمَّ والقتلُ بالحرِّ أجدرٌ"],["وأخرى أصادي النَّفسَ عنها وإنَّها","لَمَوْرِدُ حَزْمٍ إنْ فَعَلْتُ وَمَصْدَرُ"],["فرَشْتُ لَهَا صَدْرِي فَزَلَّ عَنِ الصَّفَا","به جؤجؤ عبلٌ ومتنٌ مخصّرُ"],["فَخَالَطَ سَهْلَ الأرْضِ لَمْ يَكْدَح الصَّفَا","به كدحةً والموتُ خَزيانُ ينظرُ"],["فأبتُ إلى فهمٍ ولم أكُ آيباً","وَكَمْ مِثْلِهَا فَارَقْتُهَا وَهْيَ تَصْفِرُ"],["فَإنَّكَ لَوْ قَايَسْتَ بِاللِّصْبِ حِيلَتِي","بِلُقْمَانَ لَمْ يُقْصِر بِيَ الدَّهْرَ مُقْصِرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D8%A7%D9%84%D9%85%D8%B1%D8%A1_%D9%84%D9%85_%D9%8A%D8%AD%D8%AA%D9%84_%D9%88%D9%82%D8%AF_%D8%AC%D8%AF_%D8%AC%D8%AF%D9%87"},"taabbata-0007":{"t":"إذا خلفت باطنتي سرار","v":[["إِذَا خَلَّفْتُ بَاطِنَتَيْ سَرَارٍ","وبطنَ هضاضَ حيثُ غذا صباحُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D8%AE%D9%84%D9%81%D8%AA_%D8%A8%D8%A7%D8%B7%D9%86%D8%AA%D9%8A_%D8%B3%D8%B1%D8%A7%D8%B1"},"taabbata-0008":{"t":"إذا وجر عظيم فيه شيخ","v":[["إذَا وَجْرٌ عَظِيمٌ فِيهِ شَيْخٌ","منَ السُّوادانِ يُدعى الشَّرَّتينِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D9%88%D8%AC%D8%B1_%D8%B9%D8%B8%D9%8A%D9%85_%D9%81%D9%8A%D9%87_%D8%B4%D9%8A%D8%AE"},"taabbata-0009":{"t":"أغرك مني يا بن فعلة علتي","v":[["أغَرَّكَ مِنِّي يَا بْنَ فَعْلَةَ عِلَّتِي","عَشِيَّةَ أَنْ رَابَتْ عَلَيَّ رَوَائِبِي"],["وموقدُ نيرانٍ ثلاثٍ فَشَرّها","وألأمها إذ قُدتُها غيرَ عازبِ"],["سَلَبْتَ سِلاَحِي بَائِساً وَشَتَمْتَنِي","فيا خَيرَ مسلُوبٍ ويا شرَّ سالبِ"],["فإن أكُ لم أخضِبكَ فيها فإنّها","نيوبُ أساويدٍ وشولُ عقاربِ"],["ويا ركبةَ الحمراءِ شرَّةََ ركبةٍ","وكادتْ تكونُ شرّ ركبةَ راكبِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%BA%D8%B1%D9%83_%D9%85%D9%86%D9%8A_%D9%8A%D8%A7_%D8%A8%D9%86_%D9%81%D8%B9%D9%84%D8%A9_%D8%B9%D9%84%D8%AA%D9%8A"},"taabbata-0010":{"t":"أقسمت لا أنسى وإن طال عيشنا","v":[["أقسمتُ لا أنسى وإن طالَ عيشُنا","صَنِيعَ لُكَيْزٍ وَالأحَلِّ بن قُنْصُلِ"],["نَزَلْنَا بِهِ يَوْماً فسَاءَ صَبَاحُنَا","فإنَّك عمري قد ترى أيَّ منزلِ"],["بَكى إذْ رَآنَا نَازِلِينَ بِبَابِهِ","وكيفَ بكاءُ ذي القليلِ المسبَّلِ"],["فلا وأبيهِ ما نزلنا بعامرٍ","ولا عامرٌ حتَّى الرئيسِ بن قوقلِ"],["ولا بالشَّليل ربُّ مروانَ قاعداً","بأحْسَنَ عَيْشٍ وَالنُّفَاثِيّ نَوْفَلِ"],["ولا ابنِ وَهِيبٍ كَاسِبِ الحَمْدِ وَالعُلاَ","وَلاَ ابنِ ضَبَيْعٍ وَسْطَ آلِ المُخَبَّلِ"],["ولا ابن حُلَيْسٍ قَاعِداً في لِقَاحِهِ","وَلاَ ابنِ جُرَيٍّ وَسْطَ آلِ المُغَفَّلِ"],["ولا ابنِ رِياحٍ بالزُّلَيْفَاتِ دَارُهُ","رياح بنِ سعدٍ لا رياحِ بنِ معقلِ"],["أُولَئِكَ أعْطَى لِلوَلاَئِدِ خِلْفَةً","وَأدْعَى إلى شَحْمِ السَّدِيفِ المُرَعْبَلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%82%D8%B3%D9%85%D8%AA_%D9%84%D8%A7_%D8%A3%D9%86%D8%B3%D9%89_%D9%88%D8%A5%D9%86_%D8%B7%D8%A7%D9%84_%D8%B9%D9%8A%D8%B4%D9%86%D8%A7"},"taabbata-0011":{"t":"ألا أبلغ بني فهم بن عمرو","v":[["ألا أبلغْ بني فهم بنِ عمروٍ","عَلَى طُولِ التَّنَائِي والمقَالَهْ"],["مَقَالَ الكَاهِنِ الْجَامِيّ لَمَّا","رَأَى أَثَرِي وَقَدْ أَنْهَبْتُ مَالَهْ"],["أرَى قَدَمَيَّ وَقْعُهمَا حَثِيثٌ","كتحليل الظَّليم دعا رئالهْ"],["أرَى بِهِمَا عَذَابَاً كُلَّ يَوْمٍ","لخثعمَ أو بَجِيلةَ أو ثمالهْ"],["وشرّاً كانَ صبَّ على هُذيلٍ","إذَا عَلَقَتْ حِبالُهُمْ حِبَالَهْ"],["وَيَوْمُ الأَزْدِ مِنْهُمْ شَرُّ يَوْمٍ","إذَا بَعدُوا فَقَدْ صَدَّقْتَ فَالَهْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D8%A3%D8%A8%D9%84%D8%BA_%D8%A8%D9%86%D9%8A_%D9%81%D9%87%D9%85_%D8%A8%D9%86_%D8%B9%D9%85%D8%B1%D9%88"},"taabbata-0013":{"t":"ألا تلكما عرسي منيعة ضمنت","v":[["ألا تلكُما عِرسي منيعةُ ضمّنت","مِنَ الله إثْماً مُسْتَسِراً وَعالنا"],["تقولُ تركتُ صاحباً لكَ ضائعاً","وَجِئْتَ إَلَيْنَا فَارِقاً مُتَبَاطِنا"],["إذَا مَا تَرَكْتُ صَاحِبِي لِثَلاَثَةٍ","أَوْ اثْنَيْنِ مِثْلَيْنَا فَلاَ أُبْتُ آمِنا"],["وما كنتُ أبَّاءً على الخلّ إذْ دعا","وَلا المَرْءِ يَدْعُونِي مُمِرّاً مُدَاهِنَا"],["وَكَرِّي إذَا أُكْرِهْتُ رَهْطاً وَأَهْلَهُ","وأرضاً يكونُ العوصُ فيها عُجاهنا"],["ولمَّا سمعتُ العوصَ تدعو تنعَّرتْ","عَصَافِيرُ رَأسِي مِنْ غُوَاةِ فَراتِنَا"],["ولم أنتظر أن يدهموني كأنّهمْ","وَرَائِي نَحْلٌ فِي الخَلِيَّةِ وَاكِنَا"],["وَلاَ أَنْ تُصِيبَ النَّافِذاتُ مَقَاتِلِي","وَلَمْ أَكُ بِالشّدِ الذَّلِيقِ مَدَاينا"],["فَأَرْسَلْتُ مثنياً عَنِ الشَّرِّ عَاطِفاً","وَقُلْتُ تَزَحْزَحْ لاَ تَكُونَنَّ حَائِنَا"],["وحثحثتُ مشعوفَ النَّجَاءِ كأنّني","هِجَفٌّ رَأى قَصْراً سَمَالاً وَداجِنَا"],["من الحُصِّ هَزروفٌ كأنَّ عِفاءهُ","إذا استدرجَ الفيفاء مدَّ المغابنا"],["أزَجُّ زَلوجٌ هذرفيٌّ زفازفٌ","هِزَفُّ يَبُذُّ النَّاجِيَاتِ الصَّوَافِنَا"],["فَزَحْزَحْتُ عَنْهُمْ أَوْ تَجِئْنِي مَنِيَّتِي","بغبراءَ أو عرفاءَ تغدُو الدَّفائنا"],["كَأنِّي أَرَاها الْمَوْتَ لاَ دَرَّ دَرُّهَا","إذا أمكنتْ أنيابها والبراثنا"],["وقالتْ لأُخرى خلفَها وبناتِها","حَتُوفٌ تُنَقِّي مُخَّ مَنْ كَانَ وَاهِنَا"],["أَخَالِيجُ ورّادٍ عَلَى ذِي مَحَافِلٍ","إذا نزعوا مَدُّوا الدَّلاَ والشَّواطنا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D8%AA%D9%84%D9%83%D9%85%D8%A7_%D8%B9%D8%B1%D8%B3%D9%8A_%D9%85%D9%86%D9%8A%D8%B9%D8%A9_%D8%B6%D9%85%D9%86%D8%AA"},"taabbata-0014":{"t":"ألا عجب الفتيان من أم مالك","v":[["أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","تَقُولُ أَرَاكَ الْيَوْمَ أَشْعَثَ أَغْبَرَا"],["تبُوعاً لآثار السَّريَّة بعدما","رَأَيْتُكَ بَرَّاقَ الْمَفَارِقِ أيْسَرَا"],["فقلتُ لها:يومَانِ يومُ إقامةٍ","أهزُّ به غُصناً منَ البانِ أخضَرا"],["ويومٌ أهزُّ السَّيف في جيدِ أغيدٍ","لَهُ نَسْوَةٌ لَمْ تَلْقَ مِثْلِي أَنْكَرَا"],["يخفنَ عليهِ وهوَ ينزِعُ نفسَهُ","لقد كنتُ أبَّاءَ الظُّلامةِ قَسوَرَا"],["وَقَدْ صِحْتُ فيِ آثَارِ حَوْمٍ كَأنَّهَا","عَذَارَى عُقَيْلٍ أَوْ بَكَارَةُ حِمْيَرَا"],["أبعدَ النَّفاثيِّينَ آملُ طُرفةً","وآسى عَلَى شيءٍ إذا هوَ أدبَرا"],["أُكفكفُ عَنهُم صُحبتي وإخالُهم","مِنَ الذُّلِّ يَعْراً بِالتَّلاَعَةِ أعْفَرَا"],["فَلَوْ نَالَتِ الكَفَّانِ أَصْحَابَ نَوْفَلٍ","بمهمهةٍ من بطنِ ظَرءٍ فعَرعرا"],["وَلَمَّا أبى اللَّيْثِيُّ إلاَّ تَهَكُّماً","بعِرضي وكان العِرضُ عِرضي أوفَرَا"],["قُلْتُ لَهُ حَقَّ الثَّنَاءُ فَإنَّنِي","سأذهبُ حتَّى لم أجِد متأخَّرا"],["وَلَمَّا رَأَيْتُ الْجَهْلَ زَادَ لَجاجَةً","يَقُولُ فَلاَ يَأْلُوكَ أَنْ تَتَشَوَّرَا"],["دَنَوْتُ لَهُ حَتَّى كَأَنَّ قَمِيصَهُ","تشرَّبَ من نَضح الأخادعِ عُصُفرا"],["فمَن مبلغٌ ليثَ بنَ بكرٍ بأنَّنا","ترَكَنا أخاهُم يومَ قرنٍ معفَّرا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D8%B9%D8%AC%D8%A8_%D8%A7%D9%84%D9%81%D8%AA%D9%8A%D8%A7%D9%86_%D9%85%D9%86_%D8%A3%D9%85_%D9%85%D8%A7%D9%84%D9%83"},"taabbata-0016":{"t":"ألا هل أتى الحسناء أن حليلها","v":[["ألا هل أتى الحسناءَ أنَّ حليلها","تَأَبَّطَ شَرّاً وَاكْتَنَيْتُ أَبَا وَهْبِ"],["فَهَبْهُ تَسَمَّى اسْمِي وَسَمَّاني باسْمِهِ","فَأَيْنَ لَهُ صَبْرِي عَلَى مُعْظَمِ الخَطْبِ"],["وأينَ لهُ بأسٌ كبأسي وَسَورَتي","وأينَ لَهُ في كُلِّ فَادِحةٍ قَلبي"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D9%87%D9%84_%D8%A3%D8%AA%D9%89_%D8%A7%D9%84%D8%AD%D8%B3%D9%86%D8%A7%D8%A1_%D8%A3%D9%86_%D8%AD%D9%84%D9%8A%D9%84%D9%87%D8%A7"},"taabbata-0018":{"t":"إني إذا حمي الوطيس وأوقدت","v":[["إنِّي إِذَا حَمِيَ الوَطِيسُ وَأُوْقِدَتْ","لِلْحَرْبِ نَارُ كَرِيهَةٍ لَمْ أَنْكُلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86%D9%8A_%D8%A5%D8%B0%D8%A7_%D8%AD%D9%85%D9%8A_%D8%A7%D9%84%D9%88%D8%B7%D9%8A%D8%B3_%D9%88%D8%A3%D9%88%D9%82%D8%AF%D8%AA"},"taabbata-0020":{"t":"تأبط شرا ثم راح أو اغتدى","v":[["تَأبَّطَ شَرّاً ثُمَّ رَاحَ أَوْ اغْتَدَى","يُوَائِمُ غُنْماً أَوْ يَشِيفُ عَلَى ذَحْلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%A3%D8%A8%D8%B7_%D8%B4%D8%B1%D8%A7_%D8%AB%D9%85_%D8%B1%D8%A7%D8%AD_%D8%A3%D9%88_%D8%A7%D8%BA%D8%AA%D8%AF%D9%89"},"taabbata-0021":{"t":"ترجي نساء الأزد طلعة ثابت","v":[["تُرجّي نساءُ الأزدِ طلعةَ ثابتٍ","أَسِيراً وَلَمْ يَدْرِينَ كَيْفَ حَوِيلِي"],["فإنَّ الأُلَى أَوْصَيْتُمْ بَيْنَ هَارِبٍ","طريدٍ ومسفوحِ الدِّماءِ قتيلِ"],["وَخَدْتُ بِهِمْ حَتَّى إذَا طَالَ وَخْدُهُمْ","وَرَابَ عَلَيْهِمْ مَضْجَعِي وَمَقِيلِي"],["مَهَدْتُ لَهُمْ حَتَّى إذَا طَالَ رَوْعُهُمْ","إلى المهدِ خاتلتُ الضِّيا بختيلِ"],["فلمَّا أحسُّوا النَّومَ جاءوا كأنَّهُمْ","سِبَاعٌ أضَافَتْ هَجْمَةً بِسَلِيلِ"],["فقلَّدْتُ سوَّارَ بن عمرو بنِ مالكٍ","بِأسْمَرَ جَسْر القُّذَّتَيْنِ طَمِيلِ"],["فَخَرَّ كَأنَّ الْفِيلَ أَلْقَى جِرَانَهُ","عليه بريّان القواءِ أسيلِ"],["وَظَلَّ رَعَاَعُ الْمَتْنِ مِنْ وَقْعِ حَاجِزٍ","يخِرُّولو نهنهتُ غيرَ قليلِ"],["لأُبتُ كما أبا ولو كنتُ قارناً","لجئتُ وما مالكتُ طولَ زميلي"],["فسرُّكَ ندماناكَ لمّا تتابعَا","وأنَّكَ لمْ ترجعْ بعوصِ قتيلِ"],["ستأتي إلى فهمٍ غنيمةُ خلسةً","وفي الأزدِ نوحُ ويلةٍ بعويلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%B1%D8%AC%D9%8A_%D9%86%D8%B3%D8%A7%D8%A1_%D8%A7%D9%84%D8%A3%D8%B2%D8%AF_%D8%B7%D9%84%D8%B9%D8%A9_%D8%AB%D8%A7%D8%A8%D8%AA"},"taabbata-0022":{"t":"تعتعت حضني حاجز وصحابه","v":[["تَعْتَعْتُ حِضْنَيْ حَاجِزٍ وَصِحَابَهُ","وقد نبذوا خُلقانَهم وتشنَّعوا"],["أظنُّ وإن صادفتُ وعثاً وإن جرى","بِي السَّهْلُ أَوْ مَتْنٌ مِنَ الأرْضِ مَهْيعُ"],["أُجَارِي ظِلاَلَ الطَّيْرِ لو فَاتَ واحدٌ","ولو صدقوا قالوا بلى أنتَ أسرعُ"],["فمن كانَ من فتيانِ قيسٍ وخِندفٍ","أَطَافَ بِهِ الْقَنَّاصُ مِنْ حَيْثُ أُفْزِعُوا"],["يحُبْ ثلاثاً بين يومٍ وليلةٍ","وآبَ مُرِيحاً وَهْوَ أَشْوَشُ أَرْوَعُ"],["وَلَوْ كَانَ قِرْنِي وَاحِداً لَكَفَيْتُهُ","وما ارتجَعوا لو كانَ في القوم مَطمعُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%B9%D8%AA%D8%B9%D8%AA_%D8%AD%D8%B6%D9%86%D9%8A_%D8%AD%D8%A7%D8%AC%D8%B2_%D9%88%D8%B5%D8%AD%D8%A7%D8%A8%D9%87"},"taabbata-0023":{"t":"تقول سليمى لجاراتها","v":[["تقولُ سُليمى لجاراتِها","أَرَى ثَابِتاً يَفَناً حَوْقَلاَ"],["لَهَا الْوَيْلُ مَا وَجَدَتْ ثَابِتاً","أَلَفَّ الْيَدَيْنِ وَلاَ زُمَّلاَ"],["يفوتُ الجيادَ بتقريبهِ","ويكسُو هواديَها القسطلا"],["إلَى أَنْ حَدَا الصُّبْحُ أَثْنَاءَهُ","وَمَزَّقَ جِلْبَابَهُ الأَلْيَلاَ"],["عَلَى شَيْمِ نَارٍ تَنَوَّرْتُهَا","فَبِتُّ لَهَا مُدْبِراً مُقْبِلاَ"],["فَأصْبَحْتُ وَالْغُولُ لِي جَارَةٌ","فَيَا جَارَتَا أَنْتِ مَا أَهْوَلاَ"],["وَطَالَبْتُهَا بُضْعَهَا فَالْتَوَتْ","بِوَجْهٍ تَهَوَّلَ فَاسْتَغْوَلاَ"],["فقلتُ لها يا انظري كي تريْ","فولّت فكنتُ لها أغوَلا"],["فطارَ بقحفِ ابنةِ الجنِّ ذو","سَفَاسِقَ قَدْ أَخْلَقَ الْمِحْملاَ"],["إذا كلَّ أمهيتُهُ بالصَّفا","فَحَدَّ وَلَمْ أَرِهِ صَيْقَلاَ"],["غَظَاءَةُ قَفْرٍ لَهَا حُلَّتَا","نِ مِنْ وَرَقِ الطَّلْحِ لَمْ تُغْزلاَ"],["فمن سالَ أين ثوت جارتي","فإنَّ لها باللِّوى منزلا"],["وكنتُ إذا ما هممتُ اعتزمتُ","وأحرِ إذا قلتُ أنْ أفعَلا"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D9%82%D9%88%D9%84_%D8%B3%D9%84%D9%8A%D9%85%D9%89_%D9%84%D8%AC%D8%A7%D8%B1%D8%A7%D8%AA%D9%87%D8%A7"},"taabbata-0024":{"t":"جزى الله فتيانا على العوص أمطرت","v":[["جَزَى اللَّهُ فِتْيَاناً عَلَى العَوْصِ أَمْطَرَتْ","سماؤهمُ تحتَ العجاجة بالدمِ"],["وَقَدْ لاَحَ ضَوْءُ الْفَجرِ عَرْضاً كَأَنَّهُ","بلمحتهِ أقرابُ أبلقَ أدهمِ"],["فَإنَّ شَفَاءَ الدَّاءِ إدْرَاكُ نُحْلَةٍ","صياحٌ على آثارِ حومٍ عرمرمِ"],["وضاربتهمْ بالسَّفحِ إذ عارضتُهم","قبائلُ من أبناءِ بشرٍ وخثعم"],["ضراباً غدا منهُ ابنُ حاجزَ هارباً","ذُرَى الصَّخْرِ فِي جَدْرِ الرَّجِيلِ المُرَيَّمِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AC%D8%B2%D9%89_%D8%A7%D9%84%D9%84%D9%87_%D9%81%D8%AA%D9%8A%D8%A7%D9%86%D8%A7_%D8%B9%D9%84%D9%89_%D8%A7%D9%84%D8%B9%D9%88%D8%B5_%D8%A3%D9%85%D8%B7%D8%B1%D8%AA"},"taabbata-0026":{"t":"على الشنفرى ساري الغمام فرائح","v":[["عَلَى الشَّنْفَرَى سَارِي الْغَمَام فَرَائِحٌ","غَزِيرُ الكُلَى أَوْ صَيِّبُ الْمَاءِ بَاكِرُ"],["عَلَيْكَ جَدَاءٌ مِثْلُ يَوْمِكَ بِالْحَيَا","وَقَدْ رَعَفَتْ مِنِّي السُّيُوفُ البَوَاتِرُ"],["ويومُكَ يوم العَيكتينِ وعَطفةٌ","عَطَفتَ وقد مسَّ القلوبَ الحَنَاجِرُ"],["تُجيلُ سلاحَ الموتِ فيهم كأنَّهم","لِشَوْكَتِكَ الحُدَّى ضَئِينٌ نَوَافِرُ"],["وطعنةِ خلسٍ قد طعنتَ مُرشَّةٍ","لها نفذٌ تَضِلُّ فيها المَسَابِرُ"],["يظلُّ لها الآسي أميماً كأنَّهُ","نَزِيفٌ هَرَاقَتْ لُبَّهُ الْخَمْرُ سَاكِرُ"],["وإنَّكَ لَوْ لاَقَيْتَنِي بَعْدَ مَا تَرَى","وهل يُلقَين من غيَّبتهُ المقابرُ"],["لألفيتَني في غارةٍ أُدَّعى لها","إلَيْكَ وَإمَّا رَاجِعاً أَنَا ثَائِرُ"],["وإنْ تَكُ مَأْسُوراً وَظِلْتَ مُخَيِّماً","وَأَبْلَيْتَ حَتَّى مَا يَكِيدُكَ وَاتِرُ"],["وَحَتَّى رَمَاكَ الشَّيْبُ في الرَّأْسِ عَانِساً","وخَيرُكَ مبسُوطٌ وزادُكَ حَاضرُ"],["وَأَجْمَلُ مَوْتِ الْمَرْءِ إِذْ كَانَ مَيِّتاً","وَلاَ بُدَّ يَوْماً مَوْتُهُ وَهْوَ صَابِرُ"],["فَلاَ يَبْعَدَنَّ الشَّنْفَرَى وَسِلاَحُهُ","الْحَدِيدُ وَشَدُّ خَطْوِهِ مُتَوَاتِرُ"],["إذَا رَاعَ رَوْعَ الْمَوْتِ رَاعَ وَإنْ حَمَى","حمى معهُ حرٌّ كريمٌ مصابرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%B9%D9%84%D9%89_%D8%A7%D9%84%D8%B4%D9%86%D9%81%D8%B1%D9%89_%D8%B3%D8%A7%D8%B1%D9%8A_%D8%A7%D9%84%D8%BA%D9%85%D8%A7%D9%85_%D9%81%D8%B1%D8%A7%D8%A6%D8%AD"},"taabbata-0027":{"t":"فإن تصرميني أو تسيئي جنابتي","v":[["فإن تصرِميني أو تُسِيئي جنابَتي","فإنِّي لصرَّامُ المُهينِ جُذامِرُ"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D8%A5%D9%86_%D8%AA%D8%B5%D8%B1%D9%85%D9%8A%D9%86%D9%8A_%D8%A3%D9%88_%D8%AA%D8%B3%D9%8A%D8%A6%D9%8A_%D8%AC%D9%86%D8%A7%D8%A8%D8%AA%D9%8A"},"taabbata-0028":{"t":"فيوما بغزاء ويوما بسرية","v":[["فَيَوْماً بِغُزَّاءٍ وَيَوْماً بِسُرْيَةٍ","ويوماً بخشخاشٍ منَ الرَّجلِ هيضلِ"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D9%8A%D9%88%D9%85%D8%A7_%D8%A8%D8%BA%D8%B2%D8%A7%D8%A1_%D9%88%D9%8A%D9%88%D9%85%D8%A7_%D8%A8%D8%B3%D8%B1%D9%8A%D8%A9"},"taabbata-0031":{"t":"لعمر أبينا ما نزلنا بعامر","v":[["لَعَمْرِ أبِينَا مَا نَزلْنَا بِعَامِرٍ","ولاَ عامرٍ ولاَ النُّفاثيُّ نوفلِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%B9%D9%85%D8%B1_%D8%A3%D8%A8%D9%8A%D9%86%D8%A7_%D9%85%D8%A7_%D9%86%D8%B2%D9%84%D9%86%D8%A7_%D8%A8%D8%B9%D8%A7%D9%85%D8%B1"},"taabbata-0032":{"t":"لقد قال الخلي وقال حلسا","v":[["لقدْ قالَ الخليُّ وقالَ حُلساً","بِظَهْرِ اللَّيْلِ شُدَّ بِهِ الْعَكُومُ"],["لَطِيْفٍ مِنْ سُعَادَ عَنَاكَ مِنْهَا","مُراعَاةُ النُّجُومُ وَمَنْ يَهِيمُ"],["وَتِلْك لَئِنْ عُنِيتَ بِهَا رَدَاحٌ","مِنَ النسِّوَانِ مَنْطِقُهَا رَخِيمُ"],["نَيَافُ الْقُرْطِ غَرَّاءُ الثَّنَايَا","وريداءُ الشَّبابِ ونِعمُ خيمُ"],["وَلَكِنْ فَاتَ صَاحِبَ بَطْنِ رَهْوٍ","وصاحبهُ فأنتَ به زعيمُ"],["أُوَاخِذُ خُطَّةً فِيهَا سَواءً","أبيتُ وليلُ داثرِها نؤومُ"],["ثَأَرْتُ بِهِ وَمَا افْتَرَقَتْ يَدَاهُ","فَظَلَّ لَهَا بِنَا يَوْمٌ غَشُومُ"],["نَحِزُ رِقَابَهُمْ حَتَّى نَزَعْنَا","وَأَنْفُ الْمَوْتِ مِنْخَرُهُ رَثِيمُ"],["وَإنْ تَقَعِ النُّسُورُ عَلَيَّ يَوْماً","فَلَحْمُ الْمُعْتَفَى لَحْمٌ كَرِيمُ"],["وَذِي رَحِم أَحَالَ الدَّهْرُ عَنْهُ","فَلَيْسَ لَهُ لِذِي رَحِمٍ حَرِيمُ"],["أصابَ الدَّهرُ آمنَ مِروتيهِ","فَألْقَاهُ المُصَاحِبُ والْحَمِيمُ"],["مددتُ لهُ يميناً من جناحي","لَهَا وَفْرٌ وَكَافِيَةٌ رَحُومُ"],["أُواسيهِ على الأيامِ إنِّي","إذا قعَدتْ بهِ اللُّؤَمَا أَلُومُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%82%D8%AF_%D9%82%D8%A7%D9%84_%D8%A7%D9%84%D8%AE%D9%84%D9%8A_%D9%88%D9%82%D8%A7%D9%84_%D8%AD%D9%84%D8%B3%D8%A7"},"taabbata-0033":{"t":"ما لك من ... سليب الخلة","v":[["مَا لَكَ مِنْ... سليب الخُلَّةْ","عَجَزْتَ عَنْ جَارِيَةٍ رِفَلَّهْ"],["تَمْشِي إِلَيْكَ مِشْيَةَ هِرَكلَّهْ","كَمِشْيَةِ الأرْخِ تُرِيدُ العَلَّهْ"],["لو أنَّها راعيةٌ في ثلّةْ","تَحِمْلُ قِلعَينِ لِها قبلَّهْ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7_%D9%84%D9%83_%D9%85%D9%86_..._%D8%B3%D9%84%D9%8A%D8%A8_%D8%A7%D9%84%D8%AE%D9%84%D8%A9"},"taabbata-0034":{"t":"متى تبغني ما دمت حيا مسلما","v":[["مَتى تَبْغِني مَا دُمْتُ حَيّاً مُسَلّماً","تَجِدْنِي مَعَ الْمُسْتَرعِلِ المُتَعَبْهِلِ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%AA%D9%89_%D8%AA%D8%A8%D8%BA%D9%86%D9%8A_%D9%85%D8%A7_%D8%AF%D9%85%D8%AA_%D8%AD%D9%8A%D8%A7_%D9%85%D8%B3%D9%84%D9%85%D8%A7"},"taabbata-0035":{"t":"واذهب صريم كي نحلن بعدها","v":[["وَاذْهَبْ صُرَيْمُ كَيْ نَحُلَّنْ بَعْدَهَا","صَغْوَا وَحُلَّنْ بِالْجَمِيعِ الْحَوْشَبَا"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A7%D8%B0%D9%87%D8%A8_%D8%B5%D8%B1%D9%8A%D9%85_%D9%83%D9%8A_%D9%86%D8%AD%D9%84%D9%86_%D8%A8%D8%B9%D8%AF%D9%87%D8%A7"},"taabbata-0036":{"t":"وإنك لا بزا منعت ولا يدا","v":[["وإنك لا بزّاً منعتَ ولا يداً","وإنَّ السُّيوفَ بالأكفِّ شوارعُ"],["غداةَ تقولُ قد ملكتم فأسجحُوا","وَإنِّي لِمَا أَسْلَكْتُمُونِي لَتَابِعُ"],["فوالله لولا ابنا كلابٍ وعامرٌ","بعوا أمرَ غياّتٍ همُ والأقارعُ"],["لجامعتُ أمراً ليسَ فيهِ هوادةٌ","ولا غُضَّةٌ وليسَ فيها تنازُعُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A5%D9%86%D9%83_%D9%84%D8%A7_%D8%A8%D8%B2%D8%A7_%D9%85%D9%86%D8%B9%D8%AA_%D9%88%D9%84%D8%A7_%D9%8A%D8%AF%D8%A7"},"taabbata-0037":{"t":"وإني لمهد من ثنائي فقاصد","v":[["وإنِّي لمُهدٍ من ثنائي فقاصدٌ","به لابن عمِّ الصِّدقِ شُمسِ بن مالكِ"],["أهزُّ بهِ في ندوةِ الحيِّ عِطفهُ","كَمَا هَزَّ