{"poet":{"id":"ibn-khafaja","short":"ابن خفاجة","name":"ابن خفاجة الأندلسي","en":"Ibn Khafaja","era":"andalusian"},"poems":{"ibn-khafaja-0002":{"t":"أبى البرق إلآ أنيحن فؤاد","v":[["أبى البرقُ إلآّ أنيحنّ فؤادُ","ويَكحَلَ، أجفانَ المحبّ، سُهادُ"],["فبِتّ وَلي، من قانىءِ الدّمعِ، قهوَةٌ","تدارُ ومن إحدى يديّ وسادُ"],["تنوحُ لي الورقاءُ وهيَ خليةٌ","ويَنهَلّ دَمعُ المُزنِ، وهوَ جَمادُ"],["وقد كانَ في خَدّيّ للشُّهبِ مَلعَبٌ","فقَد صارَ فيهِ للورِادِ طِرادُ"],["و ليلٍ كما مدّ الغرابُ جناحَهُ","و سالَ على وجهِ السجِلّ مدادُ"],["به من وَميضِ البرقِ، واللّيلُ فَحمةٌ","شرارٌ ترامىو الغمامُ زنادُ"],["سريتُ بهِ أحييهِ لا حيّةُ السُّرى","تموتُ ولا ميتُ الصباحِ يعادُ"],["يُقَلّبُ منّي العَزمُ إنسانَ مُقلَةٍ","لها الأفقُ جفنٌ والظلامُ سوادُ"],["بخرقٍ لقلبِ البرقِ خفقةُ روعةٍ","بهِ، ولجَفنِ النّجمِ فيهِ سُهادُ"],["سَحيقٍ، ولا غَيرَ الرّياحِ رَكائِبٌ","هناكَ ولا غيرض الغمامِ مزادُ"],["كأني وأحشاءُ البلادِ تجنّني","سَريرَةُ حُبٍ، والظّلامُ فؤادُ"],["أجوبُ جيوبَ البيدِ والصبحُ صارمٌ","لهُ الليلُ غمدٌ والمجرّ نجادُ"],["وفي مُصطَلى الآفاقِ جَمرُ كواكِبٍ","علاها من الفجرِ المطلِّ رمادُ"],["ولمّا تفرّى، من دُجى اللّيل، طِحلِبٌ","و أعرضَ من ماءِ الصباحِ ثمادُ"],["حننتُ وقد ناحَ الحمامُ صبابةً","و شُقّ من الليلِ البهيمِ حدادُ"],["على حِينَ شَطّتْ، بالحبَائبِ، نيّةٌ","وحالَتْ فَيافٍ، بَينَنا، وبِلادُ"],["عشيّةَ لا مثلَ الجوادِ ذخيرةٌ","و لا مثلَ رقراقِ الحديدِ عتادُ"],["إذا زارَ خَطْبٌ خَفّرَتني ثَلاثَةٌ","سنانٌ، وعضبٌ صارِمٌ، وجَوادُ"],["فبِتّ، ولا غَيرَ الحُسامِ مُضاجِعٌ","و لا غيرَ ظهرِ الأعوجيّ مهادُ"],["معانقَ خلٍّ لا يخلّ وإنما","مكانُ ذراعيهِ عليّ نجادُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%A8%D9%89_%D8%A7%D9%84%D8%A8%D8%B1%D9%82_%D8%A5%D9%84%D8%A2_%D8%A3%D9%86%D9%8A%D8%AD%D9%86_%D9%81%D8%A4%D8%A7%D8%AF"},"ibn-khafaja-0003":{"t":"أجبت وقد نادى الغرام فأسمعا","v":[["أجبتُ وقد نادى الغرامُ فأسمعا","عشيةَ غنّاني الحمامُ فرجعا"],["فقُلتُ، ولي دَمعٌ تَرَقرَقَ، فانهَمَى","يَسيلُ، وصَبرٌ قد وَهَى، فتَضَعضَعَا"],["ألا هل إلى أرضِ الجزيرةِ أوبةٌ","فأسكُنَ أنْفاساً وأهدأ مَضْجَعَا"],["و أغدو بواديها وقد نضحَ الندى","مَعاطِفَ هاتيكَ الرّبَى، ثمّ أقشَعَا"],["أغزلُ فيه للغزالةِ سنّةً","تَحُطّ الصَّبا عَنها، من الغيمِ، بُرقُعَا"],["و قد فضّ عقدَ القطرِ في كلّ تلعةٍ","نَسيمٌ تَمَشّى بينَها، فتَضَوّعَا"],["وباتَ سَقيطُ الطّلّ يَضرِبُ سَرحَةً","ترفّ بواديها وينضحُ أجراعا"],["و أينَ فنا دارٍ إليّ حبيبةٍ","وحَسبُكَ مُصطافاً، هناك، وَمربَعَا"],["لقد تركتني بينَ جفنٍ جفا الكرى","و جنبٍ تقلّى لا يلائمُ كضجعا"],["أُقَلّبُ طرفي في السماءِ لعلّني","أشيمُ سنا برقٍ هناك تطلعا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%AC%D8%A8%D8%AA_%D9%88%D9%82%D8%AF_%D9%86%D8%A7%D8%AF%D9%89_%D8%A7%D9%84%D8%BA%D8%B1%D8%A7%D9%85_%D9%81%D8%A3%D8%B3%D9%85%D8%B9%D8%A7"},"ibn-khafaja-0004":{"t":"أرأيت أي بنية","v":[["أرأيتَ أيَّ بنيةٍ","تعزى إلى الروضِ النضيرِ"],["أهدَى الرّبيعُ صَغيرَةً","منها، تَهَشّ إلى الكَبيرِ"],["فلَثَمتُها كَلَفاً بها","و الشيخُ يكلفُ بالصغيرِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B1%D8%A3%D9%8A%D8%AA_%D8%A3%D9%8A_%D8%A8%D9%86%D9%8A%D8%A9"},"ibn-khafaja-0005":{"t":"أرقت وقد نام الحلي لنازح","v":[["أرقتُ وقد نامَ الحليّ لنازحٍ","تشظّتْ حصاةُ القلبِ في حبّه صَدعَا"],["وما شاقَني إلاّ وميضُ غَمامَةٍ","تطَلّعَ من نجدٍ، فحَيّا اللِّوَى رَبْعَا"],["أشيمُ سناهُ والسماءُ مغيمةٌ","كما اغرورقتْ عيني لرؤيته دمعا"],["فذَكّرَني، واللّيلُ يَندى جَناحُهُ","بمعَطِفِهِ خَفقاً، ومَبسِمِهِ لَمعَا"],["ومَسحَبِ ذيلٍ للسّحابِ بذي الغَضا","بَرُودِ رُضابِ الماءِ، أحوى لمى المرعَى"],["فقلْ في أتيٍّ قد تهادى كأنهُ","إذا ما ثنى أعطافهُ حيّةٌ تسعى"],["و ماءِ مسيلِ سائلٍ لقرارةٍ","فبَينا ترَى منهُ حُساماً ترَى دِرْعَا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B1%D9%82%D8%AA_%D9%88%D9%82%D8%AF_%D9%86%D8%A7%D9%85_%D8%A7%D9%84%D8%AD%D9%84%D9%8A_%D9%84%D9%86%D8%A7%D8%B2%D8%AD"},"ibn-khafaja-0006":{"t":"أطل وقد خط في خده","v":[["أطَلّ، وقَد خُطّ في خَدّهِ","من الشَّعرِ، سطرٌ دَقيقُ الحروفِ"],["فقُلتُ أرى الشّمسَ مكسُوفَةً","فقُوموا نُصَلّي صَلاةَ الكُسُوفِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B7%D9%84_%D9%88%D9%82%D8%AF_%D8%AE%D8%B7_%D9%81%D9%8A_%D8%AE%D8%AF%D9%87"},"ibn-khafaja-0007":{"t":"أفي كل يوم رجفة لملمة","v":[["أفي كلّ يومِ رجفةٌ لِمُلمةٍ","بفَقدِ خَليلٍ، يملأُ العَينَ، مؤنسِ"],["أبيتُ لَهُ تَندَى جُفُونيَ لَوعَةً","كما دمعتْ تحتَ الحيا عينُ نرجسِ"],["و حسبي إذا ما أوجعتني كربةٌ","بمُؤنِسِ يَعقُوبٍ ومُنقِذِ يُونُسِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%81%D9%8A_%D9%83%D9%84_%D9%8A%D9%88%D9%85_%D8%B1%D8%AC%D9%81%D8%A9_%D9%84%D9%85%D9%84%D9%85%D8%A9"},"ibn-khafaja-0010":{"t":"ألا إنها سنتزيد فأنقص","v":[["ألا إنها سنٌّتزيدُ فأنقصُ","ونَفضَةُ حُمّى تَعتَرِيني فأرقُصُ"],["فَها أنا أمحُو ما جنَيَتُ بعَبْرَتِي","و أنظرُ في ما قد عملتُ أمحّصُ"],["و ألمحُ أعقابَ الأمورِ فأرعوي","و يُعمى عليّ الأمرُ طوراُ فأفحصُ"],["ويا رُبّ ذَيلٍ للشّبابِ سَحَبتُهُ","و ما كنتُ أدري أنهُ سيقلّصُ"],["و لمحةِ عيشٍ بينَ كأسٍ رويّةٍ","تدارُ وظبيٍ باللّوى يتقنّصُ"],["ألا بانَ عَيشٌ كانَ يَندَى غَضارَةً","فيا ليتَ ذاكَ العَيشَ لو كانَ يَنكصُ!"],["وعِزُّ شَبابٍ كان قد هانَ بُرهَةً","ألا إنها الأعلاقُ تغلو وترخصُ"],["فمن مبلغٌ تلكَ الليالي تحيةً","تُعَمّ بها طَوراً، وطوراً تُخَصَّصُ"],["على حِينَ لا ذاكَ الغَمامُ يُظِلّني","و لا بردُ تلكَ الريحِ يسري ويخلصُ"],["وقد طَلَعَتْ، للشّيبِ، بِيضُ كَواكِبٍ","أُقَلِّبُ فيها ناظري، أتَخَرّصُ"],["كأنْ لم أُقبّلْ صفحةَ الشمسِ ليلةً","و لم ينتعل بي دونها الشمسَ أخمصُ"],["ولا بتُّ معشوقاً تطيرُ بأضلعي","قطاةٌ لها بينَ الجوانحِ مفحصُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D8%A5%D9%86%D9%87%D8%A7_%D8%B3%D9%86%D8%AA%D8%B2%D9%8A%D8%AF_%D9%81%D8%A3%D9%86%D9%82%D8%B5"},"ibn-khafaja-0011":{"t":"ألا بكى الدر فوق حالية","v":[["ألا بَكَى الدّرُّ فوقَ حالِيَةٍ","حَلّى بها العِقدُ شرَّ ما حلّى"],["يرَى بها ما يمُرّ مِن حَلَقٍ","مُخَبّأ تحتَ مَنظَرِ الجُلّى"],["قد راقَ مرأى وساءَ مختبراً","فهلْ ترى أثمرتْ بها دفلى؟"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D8%A8%D9%83%D9%89_%D8%A7%D9%84%D8%AF%D8%B1_%D9%81%D9%88%D9%82_%D8%AD%D8%A7%D9%84%D9%8A%D8%A9"},"ibn-khafaja-0013":{"t":"ألا صمت الأجداث غني فلم تجب","v":[["ألا صمتِ الأجداثُ غنّي فلم تجبْ","و لم يغني أني رفعتُ لها صوتي"],["فَيا عَجَباً لي! كَيفَ آنَسُ بالمُنى","و غايةُ ما أدركتُ منها إلى الفوتِ؟"],["وهل من سُرورٍ، أو أمانٍ لعاقِلٍ","و مفضى عبورِ العابرينَ إلى الموتِ؟"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D8%B5%D9%85%D8%AA_%D8%A7%D9%84%D8%A3%D8%AC%D8%AF%D8%A7%D8%AB_%D8%BA%D9%86%D9%8A_%D9%81%D9%84%D9%85_%D8%AA%D8%AC%D8%A8"},"ibn-khafaja-0014":{"t":"ألا مضى عصر الصبا فانقضى","v":[["ألا مضَى عَصرُ الصِّبا، فانقَضَى","وحَبّذا عَصرُ شَبابٍ مَضَى"],["ثمّ مضى أحسبهُ كوكباً","مُنكَدِراً، أو بارِقاً مُومِضَا"],["فَما تَصَدّى يَنتَحي مُقبِلاً","حتى تولى ينثني معرضا"],["و مرّ لا يلوي وما ضرّمنْ","أعرضَ لوْ سلمَ أو عرّضا"],["و إنما ضاءَ بليلِ الصّبا","صُبحُ مَشيبٍ، ساءَني أنْ أضَا"],["لاحَ ففي عينيّ نورث الهدى","منهُ، وفي قَلبيَ نارُ الغَضَا"],["و ابيضّ من فودي بهِ أسودٌ","كنتُ أرى اللّيلَ بهِ أبْيَضا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D9%85%D8%B6%D9%89_%D8%B9%D8%B5%D8%B1_%D8%A7%D9%84%D8%B5%D8%A8%D8%A7_%D9%81%D8%A7%D9%86%D9%82%D8%B6%D9%89"},"ibn-khafaja-0017":{"t":"أما لديك حلاوه","v":[["أمَا لَدَيكَ حَلاوَهْ","أما عليكَ طلاوة؟"],["طايِبْ وداعِبْ ولاعِبْ","و دعْ سجايا البداوهْ"],["فإنّ أوحَشَ شَيءٍ","جساوةٌ في غباوه"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%85%D8%A7_%D9%84%D8%AF%D9%8A%D9%83_%D8%AD%D9%84%D8%A7%D9%88%D9%87"},"ibn-khafaja-0018":{"t":"أما واعتزاز السيف والضيف والندى","v":[["أما واعتزازِ السيفِ والضيفِ والندى","بخيرِ مليكٍ هشّ في صدرِ مجلسِ"],["بَدا بَينَ كَفٍ للسَّماحِ مُغيمَةٍ","تصوبُ ووجهٍ للطلاقةِ مشمسِ"],["لقد زفّ بنتاً للخميلةِ طلقةً","يَهُزّ إليها الدَّستُ أعطافَ مَغرِسِ"],["تَنُوبُ، عن الحَسناءِ والدّارِ، غُربَةٌ","فما شئتَ من لهوٍ بها وتأنسِ"],["تُشيرُ إليها كلُّ راحةِ سُوسَنٍ","و تشخصُ فيها كلُّ مقلةِ نرجسِ"],["فحَفّتْ بها رِيحٌ بَليلٌ وربوَةٌ","بمَسرَى غَمامٍ، جادَها، متَبَجِّسِ"],["فجاءت تروقُ العينَ في ماء نضرةٍ","تشنّ على أعطافها ثوبَ سندسٍ"],["وتَملأُ عَينَ الشّمسِ لألاءَ بَهجةٍ","وحُسنٍ، وأنفَ الرّيحِ طِيبَ تَنَفّسِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%85%D8%A7_%D9%88%D8%A7%D8%B9%D8%AA%D8%B2%D8%A7%D8%B2_%D8%A7%D9%84%D8%B3%D9%8A%D9%81_%D9%88%D8%A7%D9%84%D8%B6%D9%8A%D9%81_%D9%88%D8%A7%D9%84%D9%86%D8%AF%D9%89"},"ibn-khafaja-0019":{"t":"أما واهتصار غصون البلس","v":[["أما واهتِصارِ غُصونِ البَلَسْ","وقد قلّصَ الصّبحُ ذَيلَ الغَلَسْ"],["ومالَ يَسيلُ جَنَى شَهْدِهِ","كما سالَ رِيقُ حَبيبٍ نَعَسْ"],["لقد ساقَ، من رائقِ المُجتَلى","شهيَّ الجَنى، مُستَطابَ النَّفَسْ"],["فهِمتُ لَهُ بِبَياضِ الثّغُورِ","و أحببتُ فيهِ سوادَ اللعسْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%85%D8%A7_%D9%88%D8%A7%D9%87%D8%AA%D8%B5%D8%A7%D8%B1_%D8%BA%D8%B5%D9%88%D9%86_%D8%A7%D9%84%D8%A8%D9%84%D8%B3"},"ibn-khafaja-0020":{"t":"إن الليالي لا دهتك لعائثه","v":[["إنّ اللّيالي، لا دَهَتكَ، لَعائِثَهْ","فوقيتُ فيكَ يدَ الزمانِ العابثهْ"],["وسَلِمتُ من خِلٍّ يَعُودُ على النّوى","كرماً فتنفرجُ الخطوبُ الكارثةْ"],["فأرى بهِ للقلبِ قلباً ثانياً","عزاً وللعينينِ عيناً ثالثةْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86_%D8%A7%D9%84%D9%84%D9%8A%D8%A7%D9%84%D9%8A_%D9%84%D8%A7_%D8%AF%D9%87%D8%AA%D9%83_%D9%84%D8%B9%D8%A7%D8%A6%D8%AB%D9%87"},"ibn-khafaja-0021":{"t":"إن للجنة في الأندلس","v":[["إنّ للجَنّةِ، في الأندَلسِ","مجتلى حسنٍ وريّا نفسِ"],["فسنا صبحتها من شيبِ","و دُجى ظلمتها من لعسِ"],["فإذا ما هبّتِ الريحُ صباً","صحتُ: واشوقي إلى الأندلسِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86_%D9%84%D9%84%D8%AC%D9%86%D8%A9_%D9%81%D9%8A_%D8%A7%D9%84%D8%A3%D9%86%D8%AF%D9%84%D8%B3"},"ibn-khafaja-0024":{"t":"أهزك لا إني إخالك نابيا","v":[["أهزّكَ لا إني إخالكَ نابيا","و إن كنتَ مطرورَ الغرارِ يمانيا"],["و لكنّ هزّ السيفِ والسوطِ شيمتي","وإنْ رُعتُ سَبّاقاً ونَبّهتُ ماضِيا"],["و ما هزّ أعطافَ الكريمِ إلى العلى","كأروعَ شيحانٍ يهزّ العواليا"],["إذا السيفُ لم يشربْ يهِ الدمّ قانئاً","عَبيطاً، أبَى أن يَشربَ الماءَ صادِيَا"],["وقد نُطْتُ آمالي بِأبلَجَ واضِحٍ","يُجَشّمُها أمضَى من السّيفِ عارِيَا"],["وأكرمَ آثاراً من المزنِ غادياً","وأشهَرَ أوضاحاً من البَدرِ سارِيَا"],["فما الغُصُنُ المَطلُولُ أشرَفَ باسِماً","ومادَ، أُصَيلاناً، على الماءِ صافِيَا"],["بأليَنَ أعطافاً، وأحسَنَ هَشّةً","وأعطَرَ أخلاقاً، وأندى حَواشِيَا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%87%D8%B2%D9%83_%D9%84%D8%A7_%D8%A5%D9%86%D9%8A_%D8%A5%D8%AE%D8%A7%D9%84%D9%83_%D9%86%D8%A7%D8%A8%D9%8A%D8%A7"},"ibn-khafaja-0025":{"t":"أوجهك بسام وطرفي باكي","v":[["أوَجهُكَ بَسّامٌ وطَرفيَ باكي","وعَدلُكَ مَوجودٌ ومثليَ شاكي"],["وتأبَى اهتِضامي، في جَنابِكَ، همّةٌ","تَهُزّكَ هَزَّ الرّيحِ فَرعَ أراكِ"],["و قد نامَ مني ظالمٌ لي ذاعرٌ","فيا هبةَ السيفِ الحسامِ دراكِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%88%D8%AC%D9%87%D9%83_%D8%A8%D8%B3%D8%A7%D9%85_%D9%88%D8%B7%D8%B1%D9%81%D9%8A_%D8%A8%D8%A7%D9%83%D9%8A"},"ibn-khafaja-0026":{"t":"أي عيش أو غذاء أو سنه","v":[["أيّ عَيشٍ، أو غِذاءٍ، أو سِنَهْ","لابنِ إحدَى وثَمانينَ سَنَهْ"],["قلصَ الشيبُ يهِ ظلَّ امرئٍ","طالما جرّ صباهث رسنه"],["تارةً تسطو بهِ سيئةٌ","تسخنُ العينَ أخرى حسنهْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%8A_%D8%B9%D9%8A%D8%B4_%D8%A3%D9%88_%D8%BA%D8%B0%D8%A7%D8%A1_%D8%A3%D9%88_%D8%B3%D9%86%D9%87"},"ibn-khafaja-0028":{"t":"بشرى كما أسفر وجه الصباح","v":[["بُشرَى، كما أسفَرَ وجهُ الصّباحْ","واستشرفَ الرّائدُ برقاً ألاحْ"],["وارتَجَزَ الرّعدُ يَمُجّ النّدَى","رَيّا، ويَحدُو بمَطايا الرّياحْ"],["فدنّر الزهرُ متونَ الربى","ودَرهَمَ القَطرُ بُطونَ البِطاحْ"],["هبّت رواحاً وهي نفّاحةٌ","فطابَ ريحاً نشرُ ذاكَ الرواح"],["أفصحَ غرّيدٌ بهامطربٌ","نفّشَ، من طِرْسٍ، قُدَامى جَناحْ"],["فهل ترى أسمعَ غصنَ النقا","فهزّ من عطفيهِ هزَّ ارتياحْ؟"],["أم هل سرى ينعشُ ميتَ الربى","فمجّ ريق الطلّ ثغرُ الأقاحْ"],["عِزّ تَهادى بالقَنا هِزّةً","واختالَ بالجُردِ المَذاكي مِراحْ"],["فَطاوَلَ، النّجمَ، مَنارُ الهُدَى","وأحرَزَ الدّينُ مُعَلّى القِداحْ"],["والتأمَ الشِّعبُ، وما إنْ عَدا","رأيُ أمِيرِ المُؤمِنينَ الصَّلاحْ"],["خيرُ إمامٍ دامَ في عسكري","جَدٍّ وجِدٍ، ملءُ صَدرِ البَراحْ"],["يَعطِسُ عن أنفٍ حَميٍ لَهُ","أضرَعَ، خَدّيْ كلّ حيٍّ، كفاحْ"],["أرعَدَ في تُدميرَ زَجراً لها","فما لعنزينِ هناكَ انتطاحْ"],["وغَضّ، من أصواتِها، صَوتُهُ","إنّ زئيرَ الليثِ غيرُ النباحْ"],["و شدّ أزرَ ابنِ عصامٍ بما","حَبّرَ مِن ألفاظِ بِرٍ، فِصاحْ"],["في رقعةٍ تحملُ من رفعةٍ","لألاءَ أوضاحِ الوُجُوهِ الصِّباحْ"],["ميمونةٍ لو لمستْ جلمداً","صلداً لسالَ الماءيُ عنه فساحْ"],["فالمجدُ ممطورُ جنابِ المنى","و الملكُ خفاقُ جناحِ النجاحْ"],["يسفرُ عن بيضِ وجوهِ الظبى","بأساً، ويَرنُو عن عيونِ الرّماحْ"],["أبيضُ وضاحُ جبينِ العلى","جذلانُ مبسوطُ يمينِ السماحْ"],["فقلْ لمن ساجلهُ ضلّةً","ما سُدفَةُ اللّيلِ وضَوءُ الصّباحْ"],["كيفَ يكافيهِ وهل تستوي","خشونةُ الجدّ ولينُ المزاحْ؟"],["تميّزتْ من شيمةٍ شيمةٌ","إنّ الأجاجَ الصِّرْفَ غَيرُ القَراحْ"],["جالدتهُ من حاسرٍ دارعاً","كفاهُ حملُ الرأي حملَ السّلاحْ"],["وأينَ مِن بَحرٍ، طَما، أخضَرٍ","ما سالَ من أوشالِ بيضِ الصِّفاحْ"],["حمتْ ومن يقعدُ يهِ جدُّهُ","فكلّ زندٍ في يديهٍ شحاحْ"],["فلا تنم عننكَمن حاسدٍ","غضَّ حراناً من عنانِ الجماحْ"],["أمَضّهُ جُرحٌ دَخيلٌ بهِ","إنّ الرزايا من أمضّ الجراحْ"],["فرقرقَ العبرةَ في خجلةٍ","و ربما يمزجُ بالماءِ راحْ"],["ما صّ بالدمعةِ إلاّ هفا","فانظرْ تَجِدْ ثَمّ السِّوارَ الوِشاحْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D8%B4%D8%B1%D9%89_%D9%83%D9%85%D8%A7_%D8%A3%D8%B3%D9%81%D8%B1_%D9%88%D8%AC%D9%87_%D8%A7%D9%84%D8%B5%D8%A8%D8%A7%D8%AD"},"ibn-khafaja-0029":{"t":"بما حزته من شريف النظام","v":[["بما حُزتَهُ من شَرِيفِ النّظامِ","و أرهقتهُ من حواشي الكلامِ"],["تعالَ إلى الأنسِ في مجلسٍ","يهزّ به الشيخُ عطفيْ غلامِ"],["صَقيلٍ تَخَالُ بهِ بَيضَةً","تَروقُكَ تحتَ جَناحِ الظّلامِ"],["رطيبِ النسيمِ كأنّ الصبا","تجرِّرُ فيهِ ذيولَ الغمامِ"],["يكادُ سروراً بأضيافهِ","يهشّ فيلقاهمُ بالسلامِ"],["و عندي لمثلكَ من خاطبٍ","بَناتُ الحَمامِ وأُمّ المُدامِ"],["بناتٌ تنافسُ فيها الملوكُ","وتَلهو العَذارَى بها في الخِيامِ"],["فقد كدنَ يلقطنَ حبَّ القلوبِ","ويَشرَبنَ ماءَ عيونِ الكِرامِ"],["و صفراءَ طلقتُ بنتاً لها","و ما للكريمِ ومأتى الحرامِ"],["أمُصّ مَراشِفَها لَوعَةً","وأذكُرُ ما بَينَنا من ذِمامِ"],["فعُجْ تَتَصَفّحْ بَديعَ البَديعِ","وتَلمَحْ سَلامَةَ شِعرِ السَّلامي"],["وعِشْ تَتَثَنّى انثِناءَ القَضيبِ","سروراً، وتَسجَعُ سَجعَ الحمامِ"],["ويَحملُ ثوبُكَ خَطّيَّهُ","و ينطقُ عنكَ لسانُ الحسامِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D9%85%D8%A7_%D8%AD%D8%B2%D8%AA%D9%87_%D9%85%D9%86_%D8%B4%D8%B1%D9%8A%D9%81_%D8%A7%D9%84%D9%86%D8%B8%D8%A7%D9%85"},"ibn-khafaja-0030":{"t":"بهرت جمالا فرعت البصر","v":[["بهرتِ جَمالاً، فرُعْتِ البَصَرْ","و ذبتث سقاماً ففتُّ النظرْ"],["فصرتُ، إذا أمكَنَتْ لُقيَةٌ","أُريكِ السُّهَى، وتريني القَمَرْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D9%87%D8%B1%D8%AA_%D8%AC%D9%85%D8%A7%D9%84%D8%A7_%D9%81%D8%B1%D8%B9%D8%AA_%D8%A7%D9%84%D8%A8%D8%B5%D8%B1"},"ibn-khafaja-0031":{"t":"تفوت نجلا أبي جعفر","v":[["تفوتَ نجلا أبي جعفرٍ","فمن متعالٍ ومن منسفلْ"],["فهَذا يَمينٌ بها أكلُهُ","وهذا شِمالٌ بها يَغتَسِلْ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D9%81%D9%88%D8%AA_%D9%86%D8%AC%D9%84%D8%A7_%D8%A3%D8%A8%D9%8A_%D8%AC%D8%B9%D9%81%D8%B1"},"ibn-khafaja-0032":{"t":"تهاداني لذكركم ارتياح","v":[["تهاداني لذكركمُ ارتياحُ","فبِتُّ، وكلُّ جانحَةٍ جَناحُ"],["و دمعي جريةً مطرٌ توالى","و جسمي هزةً غصنٌ يراحُ"],["أإخواني، ولا إخوانَ صِدْقٍ","أصافي بعدكمُ إلاّ الصّفاحُ"],["لحُسنِ الصّبرِ دونَكُمُ حِرانٌ","وللعَبَراتِ بَعدَكُمُ جِماحُ"],["فديتكمُ بنفيس من كرمٍ","يَهُزّ بهم، مَعاطِفَهُ، السَّماحُ"],["أرى بِهِمِ النّجومَ، ولا ظَلامٌ","وأوضاحَ النّهارِ، ولا صَباحُ"],["تخايلُ نخوةٌ بهمِ المذاكي","وَتعسِلُ، هِزّةً، لهمُ الرّماحُ"],["لهم هممٌ كما شمختْ جبالٌ","و أخلاقٌ كما دمثتْ بطاحُ"],["وجارِيَةٍ رَكِبتُ بها ظَلاماً","يطيرُ من الرياح بها جناحُ"],["إذا الماءُ اطمأنّ فرقّ خصراً","علا من موجه ردفٌ رداحُ"],["و قد فغرَ الحمامُ هناكَ فاهُ","وأتلَعَ، جيدَهُ، الأجَلُ المُتاحُ"],["فما أدري أموجٌ أم قلوبٌ","و أنفاسٌ تصعذُ أم رياحُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D9%87%D8%A7%D8%AF%D8%A7%D9%86%D9%8A_%D9%84%D8%B0%D9%83%D8%B1%D9%83%D9%85_%D8%A7%D8%B1%D8%AA%D9%8A%D8%A7%D8%AD"},"ibn-khafaja-0033":{"t":"جرر ملاءة كل يوم شامس","v":[["جرّرْ ملاءةَ كلّ يومِ شامسِ","واسحَبْ ذُؤابَةَ كلّ لَيلٍ دامِسِ"],["واطلُعْ بكلّ فَلاةِ أرضٍ غُرّةً","غَرّاءَ، في وَجهِ الظّلامِ العابِسِ"],["وانزلْ بها ضيفاً لليثٍ خادرٍ","يَقريكَ، أو جاراً لظَبيٍ كانِسِ"],["وإذا طَعِمتَ فمن قَنيصٍ فِلذَةً","وإذا شَرِبتَ فمن غَمامٍ راجِسِ"],["والرّيحُ تَلْوي عِطفَ كلّ أراكَةٍ","ليَّ السرى وهناً لعطفِ الناعسِ"],["و سلِ الغنى من ظهرِ طرفٍ أشقرٍ","يطأُ القتيلَ وصدرِ رمحٍ داعسِ"],["و ارجمْ برأيكَ شدقَ ليثٍ ضاغمٍ","طَلَبَ الثَّراءَ، ونابَ صِلٍّ ناهِسِ"],["وارغَبْ بنَفسِكَ عن مَقامةِ فاضِلٍ","قد قامَ يَمثُلُ في خَصاصَةِ بائِسِ"],["فالحرّ مفتقرٌ إلى عزّ الغنى","فقرَ الحسامِ إلى يمينِ الفارسِ"],["و إذا عزمتَ فلا عثرتَ بحادثٍ","فركبتَ منهُ ظهرَ صعبٍ شامسِ"],["فافزَعْ إلى قاضي الجَماعَةِ، رَهْبَةً","تضعِ العنانَ بخيرِ راحةِ سائسِ"],["و استسقِ منهُ إن ظمئتَ غمامةً","يَخضَرّ عَنها كلُّ عُودٍ يابِسِ"],["فإذا رَوِيتَ بماءِ ذاكَ المُجتَلى","فَحَذارِ من أُلهوبِ ذاكَ الهاجِسِ"],["من آل حمدينَ الألى حليتَ بهمْ","قدماً صدورُ كتائبٍ ومدارسِ"],["من أسرةٍ نشأوا غمائمَ أزمةٍ","و لربما طلعوا بدورَ حنادسِ"],["متطلعينَ إلى الحروبِ كأنما","يستطيعونَ بها وجوهَ عرائسِ"],["و جروا بميدانِ المكارمِ والعلى","وكأنّما رَكِبوا ظُهُورَ رَوامِسِ"],["و جنوا ثمارَ النصرِ من غرسِ القنا","بأكفهمْ ولنعمَ غرسُ الغارسِ"],["فهم لبابُ المجدِ نجدةَ أنفسٍ","وذَكاءَ ألبابٍ، وطِيبَ مَغارِسِ"],["وهُمُ رِياضُ الحَزْنِ نُضرَةَ أوجُهٍ","وجَمالَ أردانٍ، وحُسنَ مَجالسِ"],["من كلّ أروَعَ راعَ كلَّ ضُبارِمٍ","بأساً، وذَلّلَ نَفسَ كلِّ مُنافِسِ"],["خلعَ الثناءُ عليهِ أكرمَ حليةٍ","يُزهَى بها، في الدّستِ، عِطفُ اللاّبِسِ"],["سلسُ الكلامِ على السماعِ كأنه","سِنَةٌ تَرَقرَقُ بَينَ جَفْنَيْ ناعِسِ"],["ما إن يُمازُ، من الشّهابِ، طَلاقَةً","حتى تمَدّ إليهِ كفُّ القابسِ"],["تَرَكَ الأعادي بينَ طَرْفٍ خاشِعٍ","لا يستقلّ وبينَ رأسٍ ناكسِ"],["وزَكا فلَم يُطرَفْ بنَظرَةِ خائِنٍ","يوماً، ولم يُعرَفْ بعَهدٍ خائِسِ"],["مُتَقَلِّبٌ ما بَينَ عَزمٍ غارِسٍ","للمكرُماتِ، وبَينَ حَزمٍ حارِسِ"],["وذكاءُ فَهْمٍ لو تَمَثّلَ صارِماً","لم يأتَمِنْ، ظُبَتَيهِ، عاتِقُ فارِسِ"],["ومَقامُ حُكمٍ عادِلٍ لا يَزدَري","فيهِ، المُعَلّى خَطُوهُ بالنّافسِ"],["و مجالُ حربٍ جرّ فيهِ لامةً","قد قامَ منها في غَديرٍ حامِسِ"],["يطأُ العِدى ما بينَ نصلٍ ضاحكٍ","تحتَ العَجاجِ، ووَجهِ طِرْفٍ عابسِ"],["في حَيثُ يَلعَبُ بالقَنَاةِ، شهَامَةً","لعبَ النّعامى بالقضيبِ المائسِ"],["أحسنْ بقرطبةٍ وقد حملتْ بهِ","حُسنَ الفَتاةِ ولُبسَ خُلقِ العانسِ"],["و تتوّجتْ بمنارِ علمٍ ساطعٍ","قد قامَ فوقَ قَرارِ دينٍ آنِسِ"],["وتَخايَلَتْ عِزّاً بهِ، في عِصمَةٍ","صحتْ بها من كلّ داءٍ ناخسِ"],["يُزهَى برَيطٍ، للصّبيحَةِ، أبيَضٍ","تندى وبُردٍ للعشيةِ وارسِ"],["فانهضْ أبا عبدِ الإلهِ بآملٍ","قد جابَ دونَكَ كلَّ خَرقٍ طامِسِ"],["عاجَ الرّجاءُ على عُلاكَ به، فلَمْ","يَعُجِ المَطيَّ برَسمِ رَبعٍ دارِسِ"],["فاشفَعْ لمُغتَرِبٍ رَجاكَ، على النّوَى","يمددْ إلى الحضراءِ راحةَ لامسِ"],["وامدُدْ إلَيهِ بكَفّ جَدٍ قائِمٍ","تَجذِبْ بِه من ضَبْعٍ جَدٍّ جالسِ"],["فلَرُبّ يَومٍ قد رَفَعتَ بهِ المُنى","و محوتَ فيهِ سواد ظنّ البائسِ"],["وبَقيتَ تَجتَلِبُ النّفُوسَ نَفاسَةً","وبَشاشَةً، ووُقيتَ عَينَ النّافِسِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AC%D8%B1%D8%B1_%D9%85%D9%84%D8%A7%D8%A1%D8%A9_%D9%83%D9%84_%D9%8A%D9%88%D9%85_%D8%B4%D8%A7%D9%85%D8%B3"},"ibn-khafaja-0034":{"t":"جميل يميل إلى مثله","v":[["جَميلٌ يَميلُ إلى مِثلِهِ","فيَشفَعُ مرآهُ في وَصلِه"],["رمى نابلٌ منهما نابلاً","يناغيهِو النبلُ من نبلهِ"],["و ينظرُ منهُ إلى جنبهِ","كما نظرَ الظبيُ من ظلهِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AC%D9%85%D9%8A%D9%84_%D9%8A%D9%85%D9%8A%D9%84_%D8%A5%D9%84%D9%89_%D9%85%D8%AB%D9%84%D9%87"},"ibn-khafaja-0035":{"t":"خذها إليك وإنها لنضيرة","v":[["خُذْها إلَيْكَ، وإنّها لَنَضِيرَةٌ","طَرَأتْ علَيْكَ قَلَيلَةَ النُّظرَاءِ"],["حملتْ وحسبكَ بهجةٌ من نفحةٍ","عبقَ العروسِ وخجلةَ العذراء"],["من كل وارِسةِ القَمِيصِ، كأنّما","نشأت تعلّ بريقةِ الصفراءِ"],["نجمتْ تروقُ تها نجومٌ حسبها","بالأيكةِ الخضراءِ من خضراءِ"],["وأتَتْكَ تُسفِرُ عَنْ وُجُوهٍ طَلْقَةٍ","و تنوبُمن لطفٍ عن السفراءِ"],["يَندَى بها وجهُ النَّديّ، وربّما","بسطتْ هناكَ أسرةَ السراءِ"],["فاستضحكتْ وجهَ الدجى مقطوعةٌ","جمَلَتْ جَمَالَ الغُرّةِ الغَرّاءِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AE%D8%B0%D9%87%D8%A7_%D8%A5%D9%84%D9%8A%D9%83_%D9%88%D8%A5%D9%86%D9%87%D8%A7_%D9%84%D9%86%D8%B6%D9%8A%D8%B1%D8%A9"},"ibn-khafaja-0037":{"t":"دن دين معتمل في الله مبتهل","v":[["دِنْ دِينَ مُعتَمِلٍ في الله مُبتَهِلٍ","وعَدِّ عن سرّ علمٍ، ثَمّ، مُختَزَنِ"],["ولا تَقِفْ بِطِوالِ الكُتبِ تَسألُها","فلَستَ تَحظَى بغَيرِ الهَمّ والحَزَنِ"],["وكُن، إذا التَقَتِ الأرماحُ، سافلَها","فربّما اندَقّ صدرُ العامِلِ اليَزَني"]],"src":"https://ar.wikisource.org/wiki/%D8%AF%D9%86_%D8%AF%D9%8A%D9%86_%D9%85%D8%B9%D8%AA%D9%85%D9%84_%D9%81%D9%8A_%D8%A7%D9%84%D9%84%D9%87_%D9%85%D8%A8%D8%AA%D9%87%D9%84"},"ibn-khafaja-0038":{"t":"رأيت بخاله في صحن خده","v":[["رأيتُ بخالِه، في صَحنِ خَدِّهْ","فؤادَ محبهِ في نارِ صدّه"],["فخفتُ وقصرُ نفسي فيه","فأعطانيهِ مِيثاقاً بوُدّهْ"],["و مرّ يجدّ بي فيهِ هواهُ","و قد لعبَ الصِّبا بقضيبِ قدّه"]],"src":"https://ar.wikisource.org/wiki/%D8%B1%D8%A3%D9%8A%D8%AA_%D8%A8%D8%AE%D8%A7%D9%84%D9%87_%D9%81%D9%8A_%D8%B5%D8%AD%D9%86_%D8%AE%D8%AF%D9%87"},"ibn-khafaja-0041":{"t":"رحلت عنكم ولي فؤاد","v":[["رَحَلتُ عَنكُم، ولي فؤادٌ","تَنفُضُ أضلاعُهُ حَنينا"],["أجودُ فيكم بعلقِ دمعٍ","كنتُ بهِ قَبلَكُم ضَنينَا"],["يثورُ في وجنتيّ جيشاً","و كانَ في جفنهِ كميناً"],["كأنّني، بعدَكُم، شِمالٌ","قد فارَقتْ منكُمُ يَمِينا"]],"src":"https://ar.wikisource.org/wiki/%D8%B1%D8%AD%D9%84%D8%AA_%D8%B9%D9%86%D9%83%D9%85_%D9%88%D9%84%D9%8A_%D9%81%D8%A4%D8%A7%D8%AF"},"ibn-khafaja-0042":{"t":"سرى يرتمي ركضا به كل موجة","v":[["سرى يرتمي ركضاً به كلََّ موجةٍ","تَرامَى بها بحرٌ مِنَ اللَّيلِ أخضَرُ"],["و لا صاحبق إلا طريرُ مهندٍ","ومُعتَدِلٌ لَدْنُ المَهَزّةِ أسمَرُ"],["وأطلَسُ زَوّارٌ معَ اللّيلِ، أغبَشٌ","سَرَى خَلفَ أستارِ الدّجَى، يَتَنَكّرُ"],["تثاءبَ من مسّ الطوى فهو يشتكي","فيعوي وقد لفّتهُ نكباءُ صرصرُ"],["ودونَ أمانِيهِ شَرارَةُ لَهذَمٍ","يقلّبث فيها مثلها حينَ ينظرُ"],["فمن جوعةٍ بغريهِ بي فهو مدنٍ","و من روعةٍ تثنيهِ عني فيقصرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%B3%D8%B1%D9%89_%D9%8A%D8%B1%D8%AA%D9%85%D9%8A_%D8%B1%D9%83%D8%B6%D8%A7_%D8%A8%D9%87_%D9%83%D9%84_%D9%85%D9%88%D8%AC%D8%A9"},"ibn-khafaja-0043":{"t":"طرق الرجال إلى المعالي جمة","v":[["طرقُ الرجالِ إلى المعالي جمةٌ","شَتّى، فَدانٍ قاصِدٌ، وبَعيدُ"],["و ابناكَ إن لم يمثلا في خلقةٍ","فكلاهما في ما يرومُ سديدُ"],["كرماص فهذا في مفارقِ عصرهِ","تاجٌ وذاكَ بصفحتيهِ فريدُ"],["كالرّمحِ، والقَلَمِ القَصِيرِ لنِسبَةٍ","وكِلاهُما في ما يَنُوبُ حَميدُ"]],"src":"https://ar.wikisource.org/wiki/%D8%B7%D8%B1%D9%82_%D8%A7%D9%84%D8%B1%D8%AC%D8%A7%D9%84_%D8%A5%D9%84%D9%89_%D8%A7%D9%84%D9%85%D8%B9%D8%A7%D9%84%D9%8A_%D8%AC%D9%85%D8%A9"},"ibn-khafaja-0045":{"t":"غازلته من حبيب وجهه فلق","v":[["غازَلتُهُ من حَبيبٍ، وجهُهُ فَلَقُ","فَما عَدا أنْ بَدا في خَدّهِ شَفَقُ"],["وارتَجّ يَعثُرُ في أذيالِ خَجْلَتِهِ","غصنٌ بعطفيهِ من إستبرقٍ ورقُ"],["تَخالُ خِيلانَهُ، في نورِ صَفحَتِهِ","كواكباً في شعاعِ الشمسِ تحترقُ"],["عجبتُ والعينُ ماءٌ والحشا لهبٌ","كيفَ التَقَتْ بهما، في جنّة، طُرُقُ"]],"src":"https://ar.wikisource.org/wiki/%D8%BA%D8%A7%D8%B2%D9%84%D8%AA%D9%87_%D9%85%D9%86_%D8%AD%D8%A8%D9%8A%D8%A8_%D9%88%D8%AC%D9%87%D9%87_%D9%81%D9%84%D9%82"},"ibn-khafaja-0046":{"t":"غيري من يعتد من أنسه","v":[["غَيرِيَ مَن يَعتَدّ، من أُنسِهِ","ما نالَ من ساقٍ ومن كأسِهِ"],["و شأنُ مثلي أنْ يُرى خالياً","بنفسهِ يبحثُ عن نفسهِ"]],"src":"https://ar.wikisource.org/wiki/%D8%BA%D9%8A%D8%B1%D9%8A_%D9%85%D9%86_%D9%8A%D8%B9%D8%AA%D8%AF_%D9%85%D9%86_%D8%A3%D9%86%D8%B3%D9%87"},"ibn-khafaja-0048":{"t":"قل للقبيح الفعال: يا حسنا","v":[["قل للقبيحِ الفعالِ: يا حسنا","ملأتَ جفنيّ ظلمةً وسنا"],["قاسَمَني طَرْفُكَ الضَّنَى، أفَلا","قاسَمَ، جَفنَيّ، ذلكَ الوَسَنَا؟"],["إنّي وإن كنتُ هَضبَةً، جَلَداً","أهتزّ للحسنِ لوعةً غصنا"],["قَسَوتُ بأساً ولِنتُ مَكرُمَةً","لم ألتَزِمْ حالَةً ولاَ سَنَنا"],["لَستُ أُحبّ الجمودَ في رَجُلٍ","تحسبُهُ من جموده وثنا"],["لم يَكحَلِ السّهدُ جفنَهُ كَلَفاً","ولا طوى جسمهُ الغرامُ ضنى"],["فمَن عَصَى داعيَ الهَوى فقَسَا","و كانَ جلداً من الصفا خشنا"],["فإنّني، والعَفافُ من شيَمي","آبَى الدّنايا وأعشَقُ الحَسَنَا"],["طوراً منيبُ وتارةً غزلٌ","أبكي الخَطايا وأندُبُ الدِّمَنَا"],["إذا اعترتْ خشيةٌ شكا فبكى","أوِ انتَحَتْ راحَةٌ دَنا فجَنَى"],["كأنّني غُصنُ بانَةٍ خَضِلٌ","تَثنيهِ رِيحُ الصَّبا هُنَا وهُنا"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D9%84_%D9%84%D9%84%D9%82%D8%A8%D9%8A%D8%AD_%D8%A7%D9%84%D9%81%D8%B9%D8%A7%D9%84%3A_%D9%8A%D8%A7_%D8%AD%D8%B3%D9%86%D8%A7"},"ibn-khafaja-0049":{"t":"قل للمقيم مع النفوس علاقة","v":[["قل للمقيمِ معَ النفوسِ علاقةً","يا راكِباً ظَهرَ المَطيّ بُراقَا"],["لِمْ صِرْتَ تَرغَبُ عَن سَجايا حُرّةٍ","قد كُنتَ مُقتَنياً لها أعلاقَا"],["أتمرّ لا تلوي على مثوى أخي","ثِقَةٍ، ولا تَقِفُ الرّكابَ فُواقَا؟"],["أتُرَى الوِزارَةَ غَيّرَتكَ خَليقَةً","إنّ الوزارةَ تنقلُ الأخلاقا"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D9%84_%D9%84%D9%84%D9%85%D9%82%D9%8A%D9%85_%D9%85%D8%B9_%D8%A7%D9%84%D9%86%D9%81%D9%88%D8%B3_%D8%B9%D9%84%D8%A7%D9%82%D8%A9"},"ibn-khafaja-0050":{"t":"قل ما تشاء بمحفل أو مجهل","v":[["قلْ ما تشاءُ بمحفلٍ أو مجهلٍ","واخزُنْ لسانَكَ عن مَقالٍ يُوبِقُ"],["إنّ الصغيرةَ قد تجرّ عظيمةً","و لربما أودى بشاهٍ بيدقُ"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D9%84_%D9%85%D8%A7_%D8%AA%D8%B4%D8%A7%D8%A1_%D8%A8%D9%85%D8%AD%D9%81%D9%84_%D8%A3%D9%88_%D9%85%D8%AC%D9%87%D9%84"},"ibn-khafaja-0051":{"t":"لاعب تلك الريح ذاك اللهب","v":[["لاعَبَ، تلكَ الرّيحَ، ذاكَ اللّهَبُ","فعادَ، عينَ الجِدّ، ذاكَ اللّعِبُ"],["وباتَ في مَسرَى الصَّبا يَتبَعُهُ","فَهوَ لها مُضطَرِمٌ، مُضطَرِبُ"],["ساهَرتُهُ أحسِبُهُ مُنتَشِياً","يهزّ عطفيهِ هناك الطربُ"],["لو جاءهُ منتقدٌ لما درى","ألَهَبٌ مُتّقِدٌ أمْ ذَهَبُ"],["تَلثُمُ منهُ الرّيحُ خَدّاً خَجِلاً","حيثُ الشرارُ أعينٌ ترتقبُ"],["في مَوقِدٍ، قد رَقرَقَ الصّبحُ به","ماءً علَيْهِ من نُجُومٍ حَبَبُ"],["منقسمٌ بينَ رمادٍ أزرقٍ","و بينَ جمرٍ خلفهُ يلتهبُ"],["كأنّما خَرّتْ سَماءٌ فَوقَهُ","و انكدرتْ ليلاً عليه شهبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%A7%D8%B9%D8%A8_%D8%AA%D9%84%D9%83_%D8%A7%D9%84%D8%B1%D9%8A%D8%AD_%D8%B0%D8%A7%D9%83_%D8%A7%D9%84%D9%84%D9%87%D8%A8"},"ibn-khafaja-0052":{"t":"لعمري لو أوضعت في منهج التقى","v":[["لعمريَ لو أوضعتُ في منهجِ التقى","لكانَ لنا في كلّ صالحةٍ نهجُ"],["فَما يَستَقيمُ الأمرُ، والمَلْكُ جائرٌ","و هل سيتقيمُ الظلُّ والعودُ معوجُّ؟"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%B9%D9%85%D8%B1%D9%8A_%D9%84%D9%88_%D8%A3%D9%88%D8%B6%D8%B9%D8%AA_%D9%81%D9%8A_%D9%85%D9%86%D9%87%D8%AC_%D8%A7%D9%84%D8%AA%D9%82%D9%89"},"ibn-khafaja-0054":{"t":"لك الله من سار إلي مسلم","v":[["لكَ اللهُ من سارٍ إليّ مسلمٍ","فنابَ وراءَ الليلِ عن أمّ سالمِ"],["يجولُ به ماءُ النضارةِ والندى","كما جالَ ماءُ البِشرِ في وجهِ قادِمِ"],["تنَفّسَ يُهدي، عن حَبيبٍ، تحيّةً","هَزَزنا لها، زَهواً، فُضولَ العَمائمِ"],["يُذكّرُنا رَيّا الأحبّةِ نَفحَةً","فنَذكُرُهُ بالدّمعِ سُقيا الغَمائِمِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%83_%D8%A7%D9%84%D9%84%D9%87_%D9%85%D9%86_%D8%B3%D8%A7%D8%B1_%D8%A5%D9%84%D9%8A_%D9%85%D8%B3%D9%84%D9%85"},"ibn-khafaja-0056":{"t":"ليهنك وافد أنس سرى","v":[["ليهنكَ وافدُ أنسٍ سرى","فسرّى وفصلُ سرورٍ طرقْ"],["فما شئتَ من ماءِ وردٍ بهِ","أراقَ، ومن ثَوبِ حُسنٍ أرَقّ"],["وسَوداءَ تَدمَى بهِ مَنْحَراً","كما اعترضَ الليلُ تحتَ الشفقْ"],["و أقسمُ لو مثلتْ ليلةً","لعِفتُ الكرَى واستطبتُ الأرَقْ"],["ستخلعُ من فروها ضحوةً","سوادَ الدجى عن بياضِ الفلقْ"],["فَيا حُسنَ خَصرٍ لها أحمَرٍ","ومِئزَرِ شَحمٍ علَيهِ يَقَقْ"],["وما رَفَلَتْ في قَميصِ الظّلام","ولا اشتملتْ برداءِ الغسقْ"],["و لكنْتسيلُ عليها القلوبُ","هوًى، وتذوبُ عَلَيها الحَدَقْ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%8A%D9%87%D9%86%D9%83_%D9%88%D8%A7%D9%81%D8%AF_%D8%A3%D9%86%D8%B3_%D8%B3%D8%B1%D9%89"},"ibn-khafaja-0057":{"t":"ما إن درى ذاك الذميم وقد شكا","v":[["ما إن درى ذاكَ الذميمُ وقد شكا","من نَيلِ مُمتَدِحٍ، ورَمحِ جَوَادِ"],["هل يشتكي وجعاً بهِ في سرةٍ","بالسينِ أم في صرّةٍ بالصادِ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7_%D8%A5%D9%86_%D8%AF%D8%B1%D9%89_%D8%B0%D8%A7%D9%83_%D8%A7%D9%84%D8%B0%D9%85%D9%8A%D9%85_%D9%88%D9%82%D8%AF_%D8%B4%D9%83%D8%A7"},"ibn-khafaja-0058":{"t":"من ليلة للرعد فيها صرخة","v":[["مِن لَيلَةٍ للرّعدِ فيها صَرخَةٌ","لا تُستَطابُ، وللحَيا إيقاعُ"],["خلعَت عليّ بها رداءَ غمامةٍ","ريحٌ تهلهلُهُ هناك صناعُ"],["والصّبحُ قد صَدَعَ الظّلامَ، كأنّهُ","وجه وضيء شفّ عنهُ قناع"],["فَرَفَلتُ في سَمَلِ الدّجى، وكأنّما","قزعُ السحابِ بجانبيهِ رقاعُ"],["و دفعتُ في صدر الدجى عن مطلبٍ","بيني وبينَ الدهرِ قراعُ"],["وقَبَضتُ ذَيلي رَغبَةً عن مَعشَرٍ","عوج الطباعِ كأنهم أضلاعُ"],["جارِينَ في شَوطِ العِنادِ، كأنّهمُ","سَيلٌ، تَلاطَمَ مَوجُهُ، دَفّاعُ"],["يَرمُونَ أعطافي بنَظرَةِ إحنَةٍ","وقدتْ كما تذكي العيونَ سباعُ"],["أفرغتُ من كلمي على أكبادهمْ","قَطراً، لهُ أسماعُهُمْ أقماعُ"],["و وصلتُ ما بيني وبينَ محمدٍ","حتى كأنّا مِعصَمٌ وذِراعُ"],["فظفرتُ منهُ عىل المشيبِ بصاحبٍ","خَلَفِ الشّبابِ، فلي إلَيهِ نِزاعُ"],["قد كنتُ أغلي في ابتياعِ وداده","لو أنّ أعلاقَ الوَدادِ تُباعُ"],["و إليكها غراءَ لولا حسنها","لم تُفتَقِ الأبصارُ والأسماعُ"],["عبقتْ بها في كلّ كفٍّ زهرةٌ","فتقتْ له من خمسها أقماعُ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D9%86_%D9%84%D9%8A%D9%84%D8%A9_%D9%84%D9%84%D8%B1%D8%B9%D8%AF_%D9%81%D9%8A%D9%87%D8%A7_%D8%B5%D8%B1%D8%AE%D8%A9"},"ibn-khafaja-0059":{"t":"ندى النسيم فما أرق وأعطرا","v":[["نَدّى النّسيمُ، فَما أرَقّ وأعطَرَا","وهَفا القَضِيبُ، فَما أغضَّ وأنضَرا"],["فزفضها بكراً إذا قبلتها","ألقَتْ، على وَجهي، قِناعاً أحمَرَا"],["و رفلتث بينَ قميصِ غيمٍ هلهلٍ","ورِداءِ شَمسٍ، قد تَمَزّقَ، أصفَرَا"],["والرّيحُ تَنخُلُ، مِن رَذاذٍ، لؤلؤاً","رطباًو تفتقُ من غمامٍ عنبرا"]],"src":"https://ar.wikisource.org/wiki/%D9%86%D8%AF%D9%89_%D8%A7%D9%84%D9%86%D8%B3%D9%8A%D9%85_%D9%81%D9%85%D8%A7_%D8%A3%D8%B1%D9%82_%D9%88%D8%A3%D8%B9%D8%B7%D8%B1%D8%A7"},"ibn-khafaja-0061":{"t":"و أسود يسبح في لجة","v":[["و أسودٍ يسبحُ في لجّةٍ","لا تكتمُ الحصباءَ غدرانها"],["كأنها في شكلها مقلةٌ","وذلكَ الأسوَدُ إنسانُها"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D8%A3%D8%B3%D9%88%D8%AF_%D9%8A%D8%B3%D8%A8%D8%AD_%D9%81%D9%8A_%D9%84%D8%AC%D8%A9"},"ibn-khafaja-0062":{"t":"و أشقر تضرم منه الوغى","v":[["و أشقرٍ تضرمُ منهُ الوغى","بشُعلَةٍ مِن شُعَلِ الباسِ"],["مِنْ جُلَّنارٍ ناضرٍ خَدُّهُ","و أذنهُمن ورقِ الآسِ"],["تَطلُعُ للغُرّةِ، في وَجهِهِ","حبابةٌ تضحكُ في كاسِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D8%A3%D8%B4%D9%82%D8%B1_%D8%AA%D8%B6%D8%B1%D9%85_%D9%85%D9%86%D9%87_%D8%A7%D9%84%D9%88%D8%BA%D9%89"},"ibn-khafaja-0063":{"t":"و أغيد في صدر الندي لحسنه","v":[["و أغيدَ في صدر النديّ لحسنهِ","حليّ وفي صدر القصيدِ سيبُ"],["منَ الهيفِ أما ردفهُ فمنعّمٌ","خَصيبٌ، وأمّا خَصرُهُ فجَديبُ"],["يرفّ بروضِ الحسنِ من نورِ وجهه","وقامتِهِ، نُوّارَةٌ وقَضِيبُ"],["جلاها وقد غنى الحمامُ عسيةً","عَجُوزاً عَلَيها، للحبَابِ، مَشيبُ"],["وجاءَ بها حَمراءَ، أمّا زُجاجُها","فنَورٌ، وأمّا مَوجُها فكَثيبُ"],["وغازَلَنا جَفنٌ، هناك، كنرجِسٍ","ومُبتَسَمٌ، للأقحُوانِ، شَنِيبُ"],["فَلِلّهِ ذَيلٌ، للتّصابِي، سحَبْتُهُ","وعيشٌ، بأطرافِ الشّبابِ، رَطيبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D8%A3%D8%BA%D9%8A%D8%AF_%D9%81%D9%8A_%D8%B5%D8%AF%D8%B1_%D8%A7%D9%84%D9%86%D8%AF%D9%8A_%D9%84%D8%AD%D8%B3%D9%86%D9%87"},"ibn-khafaja-0064":{"t":"و اغيد معسول اللمى والمراشف","v":[["و اغيدَ معسولِ اللّمى والمراشفِ","صَقيلِ المُحَلّى والحِلى والسّوالِفِ"],["أنَخْتُ بهِ، والبَرقُ يَهفُو جَناحه","وللدّيمَةِ الهَطلاءِ حَنّةُ عاطِفِ"],["فنادَ متُ حلوَ البرّ واللفظِ واللمى","جميلَ المحيا والحلى والعوارفِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D8%A7%D8%BA%D9%8A%D8%AF_%D9%85%D8%B9%D8%B3%D9%88%D9%84_%D8%A7%D9%84%D9%84%D9%85%D9%89_%D9%88%D8%A7%D9%84%D9%85%D8%B1%D8%A7%D8%B4%D9%81"},"ibn-khafaja-0066":{"t":"و ساق لخيل اللحظ في شأو حسنه","v":[["و ساقِ لخيلِ اللحظِ في شأوِ حسنه","جماحٌ وللصبرِ الجميلِ جرانُ"],["تَرى للصِّبا ناراً بخَدَّيهِ لَمْ يَثُرْ","لها، من سَوادَيْ عارِضَيهِ، دُخانُ"],["سَقاها، وقد لاحَ الهِلالُ عَشيّةً","كما اعوجّ في درعِ الكميّ سنانُ"],["عقاراً نماها الكرمُ فهيَ كريمةٌ","ولم تَزنِ بابنِ المُزنِ، فَهْيَ حَصانُ"],["و ضمّخَ ردعُ الشمسِ نحرَ حديقةٍ","عليهِ من الطّل السقيطِ جمانُ"],["و نمتْ بأسرارِ الرياضِ خميلةٌ","لها النَّورُ ثَغرٌ والنّسيمُ لِسانُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D8%B3%D8%A7%D9%82_%D9%84%D8%AE%D9%8A%D9%84_%D8%A7%D9%84%D9%84%D8%AD%D8%B8_%D9%81%D9%8A_%D8%B4%D8%A3%D9%88_%D8%AD%D8%B3%D9%86%D9%87"},"ibn-khafaja-0067":{"t":"و عشي أنس أضجعني نشوة","v":[["و عشيِّ أنسٍ أضجعني نشوةٌ","فيهِ تمهدُ مضجعي وتدمثُ"],["خلعتْ عليّ بهِ الأراكةُ ظلّها","والغُصنُ يُصغي، والحَمامُ يُحدّثُ"],["و الشمسُ تجنحُ للغروبِ مريضةً","والرّعدُ يَرقي، والغِمَامَةُ تَنفُثُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D8%B9%D8%B4%D9%8A_%D8%A3%D9%86%D8%B3_%D8%A3%D8%B6%D8%AC%D8%B9%D9%86%D9%8A_%D9%86%D8%B4%D9%88%D8%A9"},"ibn-khafaja-0068":{"t":"و ليل طرقت المالكية تحته","v":[["و ليلٍ طرقتُ المالكيةَ تحتهُ","أجَدَّ، على حُكمِ الشّبابِ، مَزارَا"],["فَخالَطتُ أطرافَ الأسِنّةِ أنجُماً","ودُستُ لِهالاتِ البُدورِ دِيارَا"],["فلَمْ يَكُ إلاّ رَشفَةٌ واعتِناقَةٌ","و يعجبني أنّي أعفّ إزارا"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D9%84%D9%8A%D9%84_%D8%B7%D8%B1%D9%82%D8%AA_%D8%A7%D9%84%D9%85%D8%A7%D9%84%D9%83%D9%8A%D8%A9_%D8%AA%D8%AD%D8%AA%D9%87"},"ibn-khafaja-0069":{"t":"و محمولة فوق المناكب عزة","v":[["و محمولةٍ فوقَ المناكبِ عزةً","لها نسببٌ في روضةِ الحزنِ معرقُ"],["رأيتُ بمَرآها المُنى كَيفَ تَلتَقي","و شملَ رياحِ الطيبِ وهي تفرقُ"],["يضاحكها ثغرٌ من الشمس واضحٌ","ويَلحَظُها طَرفٌ، من الماءِ، أزرَقُ"],["و تجلى بها للماءِ والنارِ صورةٌ","تَرُوقُ، فطَرْفي حَيثُ يَغرَقُ يُحرقُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D9%85%D8%AD%D9%85%D9%88%D9%84%D8%A9_%D9%81%D9%88%D9%82_%D8%A7%D9%84%D9%85%D9%86%D8%A7%D9%83%D8%A8_%D8%B9%D8%B2%D8%A9"},"ibn-khafaja-0070":{"t":"و مخطوط السواد كأن دمعا","v":[["و مخطوطِ السوادِ كأنّ دمعاً","جرى ودماً هناك على حدادِ"],["إذا التبستْ وجوهُ الحكمِ يوماً","قضَى، فمَضَى على نَهجِ السَّدادِ"],["فأيّ بياضِ نعمى ليس يعزى","لمشتملٍ بسربالِ السوادِ"],["تَلَوّى، فالتَمَحتُ بهِ ضَمِيراً","دخيلَ السّمّر ممذوقَ الودادِ"],["يُجِيبُ، وما سألتُ لهُ مُجيباً","فَيا عَجَباً لإفصاحِ الجَمادِ!"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D9%85%D8%AE%D8%B7%D9%88%D8%B7_%D8%A7%D9%84%D8%B3%D9%88%D8%A7%D8%AF_%D9%83%D8%A3%D9%86_%D8%AF%D9%85%D8%B9%D8%A7"},"ibn-khafaja-0071":{"t":"و مرتبع حططت الرحل منه","v":[["و مرتبعٍ حططتُ الرحلَ منهُ","بحيثُ الظلُّ والماءُ القراحُ"],["يُحَرِّمُ، حُسنَ مَنظَرِهِ، مَليكٌ","يُحَرِّمُ، مُلكَهُ، القَدَرُ المُتاحُ"],["فجريهُ ماءِ جدولهِ بكاءٌ","عليهِ وشدوُ طائرهِ نياحُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D9%85%D8%B1%D8%AA%D8%A8%D8%B9_%D8%AD%D8%B7%D8%B7%D8%AA_%D8%A7%D9%84%D8%B1%D8%AD%D9%84_%D9%85%D9%86%D9%87"},"ibn-khafaja-0072":{"t":"و معشوقة الحسن ممشوقة","v":[["و معشوقةِ الحسنِ ممشوقةٍ","يَهيمُ بها الطَّرفُ والمَعطِسُ"],["لها نضرةٌ سمتها نظرةً","وتَكلَفُ، بالأنفُسِ، الأنفُسُ"],["فمن ماءِ جفني لها مكرعٌ","فَسيحٌ، ومن راحتي مَغرِسُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D9%85%D8%B9%D8%B4%D9%88%D9%82%D8%A9_%D8%A7%D9%84%D8%AD%D8%B3%D9%86_%D9%85%D9%85%D8%B4%D9%88%D9%82%D8%A9"},"ibn-khafaja-0074":{"t":"و مقنع بخلا بنضرة حسنه","v":[["و مقنّعٍ بخلاً بنضرةِ حسنهِ","أمسى هلالاً وهو بدرُ تمامِ"],["قبّلتُ منهُ أقحوانةَ مبسمٍ","رَقّتْ وَراءَ كُمامَةٍ لِثُمامِ"],["ولَثَمتُ حُمرَةَ وجنَةٍ تَندى حياً","فكرعتُ في بردٍ بها وسلامِ"],["وبكلّ مَرقَبَةٍ مَناخُ غَمامَةٍ","مثلُ الضّريبِ بها لِحاحُ لُغامِ"],["رعدتْ فرجعتِ الرغاءَ مطيةٌ","لم تدرِ غيرَ البرقِ خفقَ زمامِ"],["أوحتْ هناك إلى الرُّبَى: أن بشّري","بالرّيّ فَرعَ أراكَةٍ وبَشامِ"],["و كفى بلمحِ البرقِ غمزةَ حاجبٍ","و بصوتِ ذاكَ الرعدِ رجعَ كلامِ"],["في لَيلَةٍ خصِرَتْ صَباها، فاصطلى","فيها أخو التقوى بنارِ مدامِ"],["و أحمّ مسودّ الأديمِ كأنّما","خلعتْ على عطفيه جلدةُ حامْ"],["ذاكي لسانِ النّارِ، بَحسِبُ أنّهُ","بَرقٌ، تَمزَّق عنهُ جَيبُ غَمامِ"],["فكأنّ بَدءَ النّارِ، في أطرافِه","شفقٌ لوى يدهُ بذيلِ ظلامِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88_%D9%85%D9%82%D9%86%D8%B9_%D8%A8%D8%AE%D9%84%D8%A7_%D8%A8%D9%86%D8%B6%D8%B1%D8%A9_%D8%AD%D8%B3%D9%86%D9%87"},"ibn-khafaja-0075":{"t":"وأبيض عضب حالف النصر صاحبا","v":[["وأبيَض عَضبٍ حالَفَ النّصرَ صاحباً","يكادُ، ولم يُستَلَّ، يَمضِي فيَفتُكَ"],["يبشرهُ يالنصرِ إرهافُ نصلهِ","فيَهتَزّ في كفّ الكَميّ ويَضحَكُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A3%D8%A8%D9%8A%D8%B6_%D8%B9%D8%B6%D8%A8_%D8%AD%D8%A7%D9%84%D9%81_%D8%A7%D9%84%D9%86%D8%B5%D8%B1_%D8%B5%D8%A7%D8%AD%D8%A8%D8%A7"},"ibn-khafaja-0076":{"t":"وأخطل لو تعاطى سبق برق","v":[["وأخطَلَ، لو تَعَاطَى سَبْقَ بَرْقٍ","لَطارَ مِنَ الفِجاءِ بهِ جنَاحُ"],["يَسُوفُ الأرضَ، يَسألُ عَن بَنيها","فتُخبِرُ، أنفَهُ عَنهُ، الرّياحُ"],["أقَبّ، إذا طَرَدتَ بهِ قَنيصاً","تنكبَ قوسهُ الأجلُ المتاحُ"],["أطلّ برأسهِ ليلٌ بهيمٌ","فشَدّ، على مَخانِقِهِ، صَباحُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A3%D8%AE%D8%B7%D9%84_%D9%84%D9%88_%D8%AA%D8%B9%D8%A7%D8%B7%D9%89_%D8%B3%D8%A8%D9%82_%D8%A8%D8%B1%D9%82"},"ibn-khafaja-0077":{"t":"وأطلس ملء جانحتيه خوف","v":[["وأطلَسَ، ملءُ جانِحَتَيهِ خوفٌ","لأشوسَ ملءٌ شدقيهِ سلاحُ"],["يُجاهِرُنا، يَطيرُ حَذارَ طاوٍ","لهُ رَكضٌ يَغَصّ بهِ البَراحُ"],["و أعجبُ أنْ تقلصَ ذيلُ ليلٍ","أحمَّ وقد أجدَ يه الرواحُ"],["يجولُ بحيثُ يكشرُ عن نصالٍ","مُؤلَّلَةٍ، وتَحمِلُهُ رِماحُ"],["وطَوراً يَرتَقي حُدبَ الرّوابي","و آونةً تسيلُ يهِ البطاحُ"],["جَرَى شَدّاً، وللصّبحِ التِماعٌ","بحيثُ جرى وللبرقِ التماحُ"],["فخَلْخَلَهُ، وسَوّرَهُ وميضٌ","جرى معهُ وطوّقهُ صباحُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A3%D8%B7%D9%84%D8%B3_%D9%85%D9%84%D8%A1_%D8%AC%D8%A7%D9%86%D8%AD%D8%AA%D9%8A%D9%87_%D8%AE%D9%88%D9%81"},"ibn-khafaja-0078":{"t":"وأغر يسفر للعوالي والعلى","v":[["وأغَرَّ يُسفِرُ، للعَوالي والعُلى","عن حرّ وجهٍ بالحياءِ ملثمِ"],["يسري فيمسحُ للدجى عن صفحةٍ","غَرّاءَ، تَصدَعُ كلَّ لَيلٍ مُظلِمِ"],["جذلانَ تحسبُ وجههُ متهللاً","في هَبوَةِ الهَيجاءِ، غُرّةَ أدهَمِ"],["زرّ الحديدُ عليهِ جيبَ حمامةٍ","ورقاءَ في غبشِ العجاجِ الأقنمِ"],["فكأنّ جلدَةَ حَيّةٍ خُلِعَتْ بهِ","يومَ الكريهةِ فوقَ عطفيْ ضيغمِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A3%D8%BA%D8%B1_%D9%8A%D8%B3%D9%81%D8%B1_%D9%84%D9%84%D8%B9%D9%88%D8%A7%D9%84%D9%8A_%D9%88%D8%A7%D9%84%D8%B9%D9%84%D9%89"},"ibn-khafaja-0079":{"t":"وخميلة قد أخملت سربالها","v":[["وخَميلَةٍ قد أخمَلَتْ سِربالَها","كفّا صَناعٍ، تَستَهِلّ، هَتُونِ"],["طَوَتِ السُّرَى، والبَرقُ سوطٌ خافقٌ","بيَدِ الدُّجى، والرّيحُ ظَهرُ أمُونِ"],["بُشرَى تهَادَى في وِشاحٍ مُذْهَبٍ","قَلِقٍ، وتَسحَبُ من ذُيولٍ جُونِ"],["طبعتْ على النوارِ بيضَ دراهمٍ","مدّتْ إليكَ بها بَنانُ غُصُونِ"],["فَرَفَلتُ، حيثُ تَعَثّرَتْ بي نَشوَةٌ","في ثوبِ وَشيٍ، للرّبيعِ، مَصُونِ"],["والأرضُ تسفُرُ عن وُجوهِ محاسنٍ","بيضٍ، وتَنظُرُ عن عُيونٍ عِينِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%AE%D9%85%D9%8A%D9%84%D8%A9_%D9%82%D8%AF_%D8%A3%D8%AE%D9%85%D9%84%D8%AA_%D8%B3%D8%B1%D8%A8%D8%A7%D9%84%D9%87%D8%A7"},"ibn-khafaja-0080":{"t":"وخيرية بين النسيم وبينها","v":[["وخِيرِيّةٍ، بَينَ النّسيمِ وَبَينَها","حديثٌ إذا جنَّ الظلامُ يطيبُ"],["لها نفسٌ يسري مع الليلٍ عاطرٌ","كأنّ له سِرّاً، هناكَ، يَريبُ"],["يدبّ معَ الإمساءِ حتى كأنما","له خلفَ أستارِ الظلامِ حبيبُ"],["ويَخفَى معَ الإصباحِ، حتى كأنّما","يَظَلّ علَيهِ، للصّباحِ، رَقيبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%AE%D9%8A%D8%B1%D9%8A%D8%A9_%D8%A8%D9%8A%D9%86_%D8%A7%D9%84%D9%86%D8%B3%D9%8A%D9%85_%D9%88%D8%A8%D9%8A%D9%86%D9%87%D8%A7"},"ibn-khafaja-0081":{"t":"ورداء ليل بات فيه معانقي","v":[["ورداءِ لَيلٍ باتَ، فيهِ مُعانقي","طيفٌ ألمّ لظبيةِ الوعساءِ"],["فجمعتُ بينَ رضابهِ وشرابهِ","وشربتُ من ريقٍ ومن صهباءِ"],["ولَثَمتُ، في ظَلماءِ لَيلَةِ وَفْرَةٍ","شفقاً هناك لوجنةٍ حمراءِ"],["واللّيلُ مُشمَطُّ الذّوائِبِ، كَبرَةً","خرفٌ يدبّ على عصا الجوزاءِ"],["ثمّ انثنى والسكرُ يسحبُ فرعهُ","ويَجُرّ، من طَرَبٍ، فُضُولَ رِدَاءِ"],["تندى بفيهِ أقحوانةُ أجرعِ","قد غازلتها الشمسُ غبَّ سماءِ"],["و تميسُ في أثوابهِ ريحانةٌ","كرعتْ على ظمإٍبجدولِ ماءِ"],["نفاحةُ الأنفاسِ إلا أنها","حذَرَ النّوى، خَفّاقَةُ الأفياءِ"],["فلَوَيتُ مَعطِفهَا اعتِناقاً، حسبُها","فيهِ، بقَطرِ الدّمعِ، من أنواءِ"],["و الفجرُ ينظرُ من وراءِ غمامةٍ","عن مُقلَةٍ كُحِلَتْ بها زَرقاءِ"],["فرَغِبتُ عن نُورِ الصّباحِ لنَوْرَةٍ","أغرى لها ببنفسجِ الظلماءِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%B1%D8%AF%D8%A7%D8%A1_%D9%84%D9%8A%D9%84_%D8%A8%D8%A7%D8%AA_%D9%81%D9%8A%D9%87_%D9%85%D8%B9%D8%A7%D9%86%D9%82%D9%8A"},"ibn-khafaja-0082":{"t":"وصدر ناد نظمنا","v":[["وصدرِ نادٍ نظمنا","بهِ القوافيَ عقدا"],["في منزلٍ قد سحبنا","بظِلّهِ، العِزَّ بُردَا"],["قد طَنّبَ المَجدُ بَيتاً","فيهِ، وعَرّسَ وفدَا"],["تذكو به الشهبُ جمراً","ويَعبَقُ اللّيلُ نَدّا"],["وقَد تَأرّجَ نَوْرٌ","عضّ يخالطُ وردا"],["كما تبسّمَ ثغرٌ","عَذبٌ، يُقَبّلُ خَدّا"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%B5%D8%AF%D8%B1_%D9%86%D8%A7%D8%AF_%D9%86%D8%B8%D9%85%D9%86%D8%A7"},"ibn-khafaja-0083":{"t":"وصهوة عزم قد تمطيت والدجى","v":[["وصَهوَةِ عزمٍ قد تمطّيتُ، والدّجَى","مُكِبّ، كأنّ الصّبحَ، في صَدرهِ، سرُّ"],["وقد ألحَفَتني، شعَملَةَ الظلّ، شمألٌ","يُقَلقِلُ أحشاءَ الأراكِ بها ذُعرُ"],["وأشرَفَ طَمّاحُ الذّؤابَةِ، شامخٌ","تنطّقَ بالجوزاءِ ليلاً له خصرُ"],["وقُورٌ على مَرّ اللّيالي، كأنّما","يصيخُ إلى نجوى وفي أذنهِ وقرُ"],["تمهدَ منهُ كلُّ ركنٍ ركانةً","فَقَطّبَ إطراقاً، وقد ضَحِكَ البَدرُ"],["ولاذَ بهِ نَسرُ السّماءِ، كأنّما","يَحِنّ ألى وَكرٍ بهِ ذلكَ النّسرُ"],["فلَم أدرِ مِن صَمتٍ لَهُ، وسكينَةٍ","أكبَرَةُ سِنٍ وقّرَتْ منهُ أمْ كِبرُ؟"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%B5%D9%87%D9%88%D8%A9_%D8%B9%D8%B2%D9%85_%D9%82%D8%AF_%D8%AA%D9%85%D8%B7%D9%8A%D8%AA_%D9%88%D8%A7%D9%84%D8%AF%D8%AC%D9%89"},"ibn-khafaja-0084":{"t":"وكأس أنس قد جلتها المنى","v":[["وكأسِ أنسٍ قد جَلَتها المُنى","فباتَتِ النّفسُ بها مُعرِسَهْ"],["طافَ بها أسوَدُ مُحدَودِبٌ","يُطرِبُ مَن يَلهُو بهِ مَجلِسَهْ"],["فخلتهُ من سبجٍ ربوةً","قد أنبتت من ذهبٍ نرجسهْ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%83%D8%A3%D8%B3_%D8%A3%D9%86%D8%B3_%D9%82%D8%AF_%D8%AC%D9%84%D8%AA%D9%87%D8%A7_%D8%A7%D9%84%D9%85%D9%86%D9%89"},"ibn-khafaja-0085":{"t":"ومائسة تزهى وقد خلع الحيا","v":[["ومائِسَةٍ تُزهَى، وقد خَلَعَ الحَيا","عليها، حُلًى حُمراً، وأرديةً خُضرَا"],["يذوبُ لها ريقُ الغمامةِ فضّةً","ويَجمُدُ، في أعطافِها، ذهَباً نَضرَا"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%A7%D8%A6%D8%B3%D8%A9_%D8%AA%D8%B2%D9%87%D9%89_%D9%88%D9%82%D8%AF_%D8%AE%D9%84%D8%B9_%D8%A7%D9%84%D8%AD%D9%8A%D8%A7"},"ibn-khafaja-0087":{"t":"ومرقرق الإفرند أبرق بهجة","v":[["ومُرَقْرَقِ الإفْرِنْدِ أبرَقَ بَهجَةً","و دجا فأطلعَ في الظلامِ ضياءَ"],["كسَفَتْ بهِ، للشّمسِ، حسناً، آيَةٌ","تَستَوقِفُ الرّائي لها، حِربَاءَ"],["وتَخَتّمَتْ، مِن فَصّهِ بغَمامَةٍ","كَفٌّ تَكونُ على السّماحِ سماءَ"],["قد صيغَ صيغةَ حكمةٍ أصتى لها","نفسَ الحكيمِ وضاجعَ العذراءَ"],["ما إنْ تَرِفّ لهَا بنَفْسَجَةٌ بِهِ","حتى يرقَّ لها فتجري ماءَ"],["و كأنما نظرتْ بهِ يومَ النوى","عن مُقلَةٍ، بَهِتَتْ لها، كَحلاءَ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%B1%D9%82%D8%B1%D9%82_%D8%A7%D9%84%D8%A5%D9%81%D8%B1%D9%86%D8%AF_%D8%A3%D8%A8%D8%B1%D9%82_%D8%A8%D9%87%D8%AC%D8%A9"},"ibn-khafaja-0088":{"t":"ومرقرق الإفرند يمضي في العدا","v":[["ومُرَقرَقِ الإفرِندِ يَمضِي في العِدا","أبداً، فيَفتُكُ ما أرادَ ويَنسُكُ"],["فكأنهُ والماءُ يضحكُ فوقهُ","جذلانُ يبكي للسرورِ ويضحكُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%B1%D9%82%D8%B1%D9%82_%D8%A7%D9%84%D8%A5%D9%81%D8%B1%D9%86%D8%AF_%D9%8A%D9%85%D8%B6%D9%8A_%D9%81%D9%8A_%D8%A7%D9%84%D8%B9%D8%AF%D8%A7"},"ibn-khafaja-0089":{"t":"ومشرف الهادي طويل السرى","v":[["ومُشرِفِ الهادي، طويلِ السُّرَى","ضافي سَبيبِ الذّيلِ والعُرفِ"],["يُصَرِّفُ الفارِسُ، في لِبدِهِ","طِرْفاً بهِ أسرَعَ من طَرْفِ"],["مُؤدَّباً لو كانَ مُستَعبَداً","لم يعبدِ اللهَ على حرفِ"],["من أنجمِ السعدِ ولكنّهُ","يومَ الوَغى، من أنجُمِ القَذفِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%B4%D8%B1%D9%81_%D8%A7%D9%84%D9%87%D8%A7%D8%AF%D9%8A_%D8%B7%D9%88%D9%8A%D9%84_%D8%A7%D9%84%D8%B3%D8%B1%D9%89"},"ibn-khafaja-0090":{"t":"ومعين ماء البشر أبرق هشة","v":[["وَمعينُ ماءِ البِشرِ أبرَقَ هَشّةً","فكرعتُ من صفحاتهِ في مشربِ"],["متهللٌ يندى حياءً وجهه","فتَراهُ بينَ مُفَضَّضٍ ومُذَهَّبِ"],["أضنى الحسامَ حسادةً ففرندهُ","دمعٌ تَرَقرَقَ، فوقَهُ، لم يَسكُبِ"],["خَيّمتُ منهُ بينَ طَودٍ باذخٍ","نالَ السماكَ وبينَ وادٍ معشبِ"],["تهفو بهِ نارُ القرى فكأنها","مهما عشا ضيفٌ لسانُ المعربِ"],["حمراءُ نازعتِ الرياحَ رداءها","وَهناً، وزاحمَتِ السّماءَ بمنكِبِ"],["ضربتْ سماءً من دخانٍ فوقها","لم يُدرَ فيها شُعلَةٌ مِن كَوكَبِ"],["وتَنَفّسَتْ عن كلّ نفحَةِ جَمرَةِ","باتَتْ لها رِيحُ الجَنُوبِ بِمَرْقَبِ"],["قد أهبت فتذهبت فكأنها","لسكونِ شرّ شرارها لم تلهبِ"],["تذكو وراءَ رمادها فكأنها","شَقراءُ، تَمرَحُ في عَجاجٍ أكهبِ"],["و الليلُ قد ولّى يقلّص بردهُ","كدّاً، ويَسحبُ ذيلَهُ في المغرِبِ"],["و كأنما نجمُ الثريا سحرةً","كفّ تُمَسِّحُ عن مَعَاطِفِ أشهَبِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%B9%D9%8A%D9%86_%D9%85%D8%A7%D8%A1_%D8%A7%D9%84%D8%A8%D8%B4%D8%B1_%D8%A3%D8%A8%D8%B1%D9%82_%D9%87%D8%B4%D8%A9"},"ibn-khafaja-0091":{"t":"ومهفهف طاوي الحشا","v":[["ومُهَفهفٍ طاوي الحَشا","خنثِ المعاطفِ والنظرْ"],["ملأ العُيُونَ بصُورَةٍ","تُلِيَتْ مَحاسِنُها سُوَرْ"],["فإذا رَنَا، وإذا مَشَى","وإذا شَدَا، وإذا سَفَرْ"],["فضَحَ الغَزَالَةَ، والغَمَامَةَ","و الحمامةَ والقمرْ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D9%87%D9%81%D9%87%D9%81_%D8%B7%D8%A7%D9%88%D9%8A_%D8%A7%D9%84%D8%AD%D8%B4%D8%A7"},"ibn-khafaja-0096":{"t":"يا جامعا بمساوية وطلعته","v":[["يا جامعاً بمساويةِ وطلعتهِ","بينَ السوادين: من ظلمٍ ومن ظلّمِ"],["أمثلُهُ جسداً في مثلهِ حسداً","لقد تألفَ بينَ النارِ والفحمِ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%AC%D8%A7%D9%85%D8%B9%D8%A7_%D8%A8%D9%85%D8%B3%D8%A7%D9%88%D9%8A%D8%A9_%D9%88%D8%B7%D9%84%D8%B9%D8%AA%D9%87"},"ibn-khafaja-0099":{"t":"يا رب قطر جامد حلى به","v":[["يا رُبّ قَطرٍ جامِدٍ حَلّى بهِ","نَحرَ الثّرَى، بَرَدٌ تَحدّرَ صائبُ"],["حصبَ الأباطحَ منهُ ماءٌ جامدٌ","غَشّى، البلادَ بهِ، عَذابٌ ذائِبُ"],["فالأرضُ تَضحَكُ عن قلائدِ أنجمٍ","نُثِرَتْ بها، والجَوُّ جَهْمٌ قاطِبُ"],["فكأنما زنتِ البسيطةُ تحتهُ","فأكبّ يرجمها الغمامُ الحاصبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%B1%D8%A8_%D9%82%D8%B7%D8%B1_%D8%AC%D8%A7%D9%85%D8%AF_%D8%AD%D9%84%D9%89_%D8%A8%D9%87"},"ibn-khafaja-0101":{"t":"يا ليل وجد بنجد","v":[["يا ليلَ وجدٍ بنجدٍ","أمَا لطَيفِكَ مَسرَى؟"],["وما لدَمعي طَليقاً","وأنجُمُ اللّيلِ أسرَى؟"],["وقد طَمَى بحرُ لَيلٍ","لم يُعقِبِ المَدَّ جَزرَا"],["لا يَعبُرُ الطّرفُ، فيهِ","غيرَ المجرةِ جسرا"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%84%D9%8A%D9%84_%D9%88%D8%AC%D8%AF_%D8%A8%D9%86%D8%AC%D8%AF"},"ibn-khafaja-0102":{"t":"يا مترفا يمشي الهوينا غرة","v":[["يا مُترَفاً يَمشِي الهُوَينا، غِرّةً","و يهزّ أعطافَ القضيبِ المورقِ"],["جَمَعَتْ ذُؤابتُهُ ونُورُ جَبينِهِ","بَينَ الدُّجُنّةِ والصّباحِ المُشرِقِ"],["هل كانَ عندك أنّ عندي لوعةً","يَنبُو لها طَرفُ السّنانِ الأزرَقِ؟"],["طالَتْ مُراقَبَةُ الخَيالِ، ودونَهُ","رَعيُ الدّجَى، فمتى أنامُ فنَلتَقي"],["ما بَينَ نَحرٍ بالدُّموعِ مُقَلَّدٍ","فرحاً وجيدٍ بالعناقِ مطوّقِ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%85%D8%AA%D8%B1%D9%81%D8%A7_%D9%8A%D9%85%D8%B4%D9%8A_%D8%A7%D9%84%D9%87%D9%88%D9%8A%D9%86%D8%A7_%D8%BA%D8%B1%D8%A9"},"ibn-khafaja-0103":{"t":"يا منية النفس حسبي من تشكيك","v":[["يا مُنيَةَ النّفسِ حَسبي، من تَشكّيكِ","أنّي أُصابُ، وكفُّ الدّهرِ تَرميكِ"],["ولو تَسامَحَ خَطبٌ في فِدائِكِ بي","لكنتُ مهما عرا خطبٌ أفديكِ"],["وكيفَ أُعفي بلَيلٍ تَسهَرينَ بهِ","أو أستَسِيغُ شَراباً ليسَ يُروِيكِ؟"],["هنيدَ أوجعتِ قلباً قد أقمتِ يهِ","ما بالُ طَرفي، وما يُدريكِ، يَبكيكِ"],["فرُبّ لُؤلؤِ دَمعٍ كنتُ أذخَرُهُ","عِلقاً أُغالي بهِ، أرخَصتُهُ فيكِ"],["و إن نأى بكِ ربعٌ غيرُ مقتربٍ","أوِ احتَواكِ حِجابٌ فيهِ يُقصِيكِ"],["فإنّ كلّ نَسيمٍ، خاضَهُ أرَجٌ","رسولُ شوقٍ أتى عني يحييكِ"],["ورُبّما شَفَعَتْ لي غَفوَةٌ نَسَخَتْ","أخرى الظلامِ فباتَ الطيفُ يدنيكِ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%85%D9%86%D9%8A%D8%A9_%D8%A7%D9%84%D9%86%D9%81%D8%B3_%D8%AD%D8%B3%D8%A8%D9%8A_%D9%85%D9%86_%D8%AA%D8%B4%D9%83%D9%8A%D9%83"},"ibn-khafaja-0104":{"t":"يا نزهة النفس يا مناها","v":[["يا نزهةَ النفسِ يا مناها","يا قُرّةَ العَينِ يا كَراها"],["أما ترى لي رضاكَ أهلاً","و هذه حالتي تراها"],["فاستَدرِكِ الفَضلَ، يا أباهُ","في رمقِ النفسِ يا أخاها"],["قَسَوتَ قَلباً ولِنتَ عِطفاً","وعِفتَ من تَمرَةٍ نَواها"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%86%D8%B2%D9%87%D8%A9_%D8%A7%D9%84%D9%86%D9%81%D8%B3_%D9%8A%D8%A7_%D9%85%D9%86%D8%A7%D9%87%D8%A7"}}}