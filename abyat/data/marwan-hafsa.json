{"poet":{"id":"marwan-hafsa","short":"مروان بن أبي حفصة","name":"مروان بن أبي حفصة","en":"Marwan ibn Abi Hafsa","era":"abbasid"},"poems":{"marwan-hafsa-0002":{"t":"إذا أم طفل راعها جوع طفلها","v":[["إذا أمُّ طفلٍ راعها جوعُ طفلها","دعتهُ بإسمِ الفضل فاعتصمَ الطفلُ"],["ليحيا بكَ الإسلامُ إنكَ عزةُ","وإنَّكَ مِنْ قوْمٍ صَغِيرُهُمُ كَهْلُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D8%A3%D9%85_%D8%B7%D9%81%D9%84_%D8%B1%D8%A7%D8%B9%D9%87%D8%A7_%D8%AC%D9%88%D8%B9_%D8%B7%D9%81%D9%84%D9%87%D8%A7"},"marwan-hafsa-0003":{"t":"إذا بلغتنا العيس يحيى بن خالد","v":[["إذا بَلَّغَتْنَا العِيسُ يَحيى بنَ خَالدٍ","أخَذْنَا بِحَبْلِ اليُسْر وانْقَطَعَ العُسْرُ"],["سَمَتْ نَحْوَهُ الأبْصارُ مِنَّا ودُونَهُ","مفاوزُ تغتال النياقَ بها السفرُ"],["فإنْ نشكر النعمى التي عمنا بها","فَحقَّ عَلَيْنَا مَا بَقينَا لَهُ الشُّكْرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D8%A8%D9%84%D8%BA%D8%AA%D9%86%D8%A7_%D8%A7%D9%84%D8%B9%D9%8A%D8%B3_%D9%8A%D8%AD%D9%8A%D9%89_%D8%A8%D9%86_%D8%AE%D8%A7%D9%84%D8%AF"},"marwan-hafsa-0004":{"t":"إذا ما تذكرت النظيم ومطرقا","v":[["إذا ما تذكرتُ النَّظيمَ وَمُطرِقاً","حننتُ وأبكاني النظيم ومطرقُ"],["تَحنُ قلُوصي نحوَ صنعاء إذ رأتْ","سماء الحيا من نحو صنعاء تبرق"],["تحن إلى مرعى بصنعاء مخصب","وشرب رواء ماؤه لا يرنق"],["وقد وثقت أن سوف يصبح ربها","إذا وردت أحواض معنٍ ويعبق"],["نؤم شريكياً تهلل بالحيا","مَخَائلُهُ للشَّائِمينَ فَتَصْدُقُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D9%85%D8%A7_%D8%AA%D8%B0%D9%83%D8%B1%D8%AA_%D8%A7%D9%84%D9%86%D8%B8%D9%8A%D9%85_%D9%88%D9%85%D8%B7%D8%B1%D9%82%D8%A7"},"marwan-hafsa-0005":{"t":"أرى القلب أمسى بالأوانس مولعا","v":[["أرى القلبَ أمسى بالأوانسِ مولعاً","وإنْ كَان مِنْ عَهْدِ الصِّبا قَدْ تَمَتَّعَا"],["ولما سرى الهم الغربي قريتهُ","قَرِى مَنْ أزالَ الشَّكَّ عَنْهُ وأزْمَعَا"],["عزمتُ فعجلتُ الرحيل ولمْ أكنْ","كَذي لَوْثَةِ لاَ يُطْلِعُ الهَمَّ مَطْلَعَا"],["فَأمَّتْ رِكَابي أرْضَ مَعْنٍ ولم تَزَلْ","إلى أرضِ معنٍ حيثما كانَ نزعا"],["نجائبُ لولاَ أنها سخرتْ لنا","أبَتْ عِزَّةً مِنْ جَهْلَها أنْ تُوزَّعا"],["كسونا رحال الميس منها غوارباً","تَدَارَكَ فيها النَّيُّ صَيْفاً ومَرْبَعاً"],["فما بلغتْ صنعاء حتى تواضعتْ","ذراها وزال الجهل عنها وأقلعا"],["وما الغيثُ إذ عم البلادَ بصوبهِ","على الناس منْ معروفِ معنٍ بأوسعا"],["تَدَارَكَ مَعْنٌ قُبَّةَ الدِّينِ بَعْدَما","خَشِينَا عَلَى أوْتَادِها أنْ تُنَزَّعَا"],["أقام على الثغر المخوفِ وهاشمٌ","تَسَاقَى سِمَاماً بالأسِنَّةِ مُنْقَعَا"],["مقامَ امرئ يأبى سوى الخطه دنيةً","بها العارَ أبقى والحفيظةَ ضيعا"],["وَمَا أحْجَمَ الأعْداءُ عَنْكَ بَقِيَّةً","عليكَ ولكنْ امْ يروا فيكَ مطعما"],["رأوْا مُخدِراً قَدْ جَرَّبُوهُ وَعايَنُوا","لدى غيله منهم مجرا ومصرعاً"],["إذا عَجَمْتُهُ الحَرْبُ لَمْ تُوهِ عَظْمَهُ","وفل شبا منها فأسرعا"],["وَلَيْسَ بِثَانِيه إذا شَدَّ أنْ يَرَى","لدى نحره زرقَ الأسنةِ شرعا"],["لهُ راحتان الحتف والغيثُ فيهما","أبَى الله إلاَّ أنْ تَضُرَّ وَتَنْفَعَا"],["لَقَدْ دوَّخَ الأعْدَاءَ مَعْنٌ فأصْبَحُوا","وامنعهم لا يدفع الذل مدفعا"],["نجيبُ مناجيبٍ وسيدُ سادةٍ","ذُرَا المَجْدِ مِنْ فَرْعَى نِزَارٍ تَفَرَّعَا"],["فَبَانَتْ خِصالُ الخَيْرِ فيه وأُكْمِلَتْ","وما كملت خمس سنوه وأربعا"],["لقد أصبحت في كل شرق ومغرب","بسيفك أعناق المربين خضعا"],["وطئت خدود الحضرميين وطأة","لها هُدَّ رُكْنَا عِزِّهِمْ فَتَضَعْضَعَا"],["فأقْعَوْا عَلى الأذْبابِ إقْعَاءَ مَعْشَرٍ","يَرَوْنَ لُزُومَ السِّلْمِ أبْقَى وأوْدَعَا"],["فلو مدتِ الأيدي إلى الحربِ كلها","لكفوا وما مدوا إلى الحرب إصبعا"],["رأيت رجالاً يوم مكة أجلبوا","عَلَيْكَ فَرامُوا مِنْكَ طَوْداً مُمَنَّعَا"],["غَلَى غَيْرِ شَيْءٍ غَيْرَ أنْ كُنْتَ مِنْهُمُ","أعَفَّ وأعْطَى للجَزيلِ وأشّجَعَا"],["فأصبحت كالعضب الحسام وأصبحوا","عَبادِيدَ شَتَّى شَمْلُهُمْ قَدْ تَصَدَّعَا"],["أخَذْتُ بِحَبْلٍ مِنْ حِبَالك مُحصَدٍ","متينٍ أبتْ منهُ القوى أنْتقطعا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B1%D9%89_%D8%A7%D9%84%D9%82%D9%84%D8%A8_%D8%A3%D9%85%D8%B3%D9%89_%D8%A8%D8%A7%D9%84%D8%A3%D9%88%D8%A7%D9%86%D8%B3_%D9%85%D9%88%D9%84%D8%B9%D8%A7"},"marwan-hafsa-0006":{"t":"أسلم بن عمرو وقد تعاطيت خطة","v":[["أسلم بن عمرو وقد تعاطيت خطة","تقصر عنهابعد طول عنائكا"],["وإني لسباق إذ الخيل كلفت","مدى مائة أو غاية فوق ذلكا"],["فَدَعْ سَابقاً إنْ عَاوَدَتْكَ عَجَاجةٌ","سنابكه أو هينَ منكَ سنابكا"],["رَأيْتَ امْرَأً نَالَ اللُّهَا فَحَسَدْتَهُ","فلم يبق إلا أن تموت بدائكا"],["طَلَبْتَ مِنَ المَهْدِيِّ شَطْرَ حِبَائِهِ","فَقَال لك المَهْدِيُّ لَسْتَ هُنَالِكَا"],["فَمَا أعْوَلَت أُمٌّ عَلَى ابنٍ ولا بَكَى","عَلَى يُوسُفٍ يَعْقُوبُ مِثْلَ بُكَائِكَا"],["غضضتَ على كفيك حتى كأنما","رُزِئْتَ الذي أُعْطِيتُ مِنْ صُلْبِ مَالِكَا"],["حبيت بأوقار البغال وإنما","سَرابُ الضُّحى ما تَدَّعي مِنْ حِبَائِكَا"],["وَمَا نِلْتَ حَتَّى شِبْتَ إلاَّ عَطِيَّةً","تَقُومُ بها مَصْرُورةً في رِدَائِكَا"],["وَمَا عِبْتَ مِنْ قَسَمِ المُلوكِ لِشاعِرٍ","به خُصَّ عَفَواً مِن أُولى وأُولِئكَا"],["فَأْقْسِمُ لَوْلاَ ابنُ الرَّبيعِ وَرفْدُهُ","لما ابتلن الدلو التي في رشائكا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B3%D9%84%D9%85_%D8%A8%D9%86_%D8%B9%D9%85%D8%B1%D9%88_%D9%88%D9%82%D8%AF_%D8%AA%D8%B9%D8%A7%D8%B7%D9%8A%D8%AA_%D8%AE%D8%B7%D8%A9"},"marwan-hafsa-0007":{"t":"أصاب الردى قوما تمنوا لك الردى","v":[["أصابَ الردى قوماً تمنواْ لكَ الردى","لأنك أعطيتَ الجزيلَ وصرودا"],["سَيَذْهَبُ ما ضُمَّتْ عَلَيْهِ أكُفُّهُمُ","ويبقى لهمْ في الناسِذمَّ مخلدُ"],["وَتَبْقَى أيادِيكَ الكَريمةُ بَعْدَما","يُوارِيكَ والجُودَ الصَّفِيحُ المُنضَّدُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B5%D8%A7%D8%A8_%D8%A7%D9%84%D8%B1%D8%AF%D9%89_%D9%82%D9%88%D9%85%D8%A7_%D8%AA%D9%85%D9%86%D9%88%D8%A7_%D9%84%D9%83_%D8%A7%D9%84%D8%B1%D8%AF%D9%89"},"marwan-hafsa-0008":{"t":"أضحى إمام الهدى المأمون مشتغلا","v":[["أضحى إمامُ الهدى المأمون مشتغلاً","بالدِّين والنَّاسُ بالدُّنْيَا مَشَاغِيلُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B6%D8%AD%D9%89_%D8%A5%D9%85%D8%A7%D9%85_%D8%A7%D9%84%D9%87%D8%AF%D9%89_%D8%A7%D9%84%D9%85%D8%A3%D9%85%D9%88%D9%86_%D9%85%D8%B4%D8%AA%D8%BA%D9%84%D8%A7"},"marwan-hafsa-0009":{"t":"أطفت بقسطنطينة الروم مسندا","v":[["أطَفْتَ بِقُسْطَنْطِينَةِ الرُّوم مُسْنِداً","إليها القَنَا حَتَّى اكْتَسَى الذِّلَّ سُورُها"],["وَما رِمْتَها حَتَّى أتَتْكَ مُلوكُها","بِجِزْيَتِها والحَرْبُ تَغْلي قُدُورُها"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B7%D9%81%D8%AA_%D8%A8%D9%82%D8%B3%D8%B7%D9%86%D8%B7%D9%8A%D9%86%D8%A9_%D8%A7%D9%84%D8%B1%D9%88%D9%85_%D9%85%D8%B3%D9%86%D8%AF%D8%A7"},"marwan-hafsa-0011":{"t":"إعص الهوى وتعز عن سعداكا","v":[["إعْصِ الهَوى وَتعَزَّ عَنْ سُعْدَاكا","فلمثل حلمكَ عنْ هواكَ نهاكا"],["أحيا لنا سنن النبي سميهُ","قد الشراكِ به قرنتَ شراكا"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B9%D8%B5_%D8%A7%D9%84%D9%87%D9%88%D9%89_%D9%88%D8%AA%D8%B9%D8%B2_%D8%B9%D9%86_%D8%B3%D8%B9%D8%AF%D8%A7%D9%83%D8%A7"},"marwan-hafsa-0012":{"t":"أفي كل يوم أنت صب وليلة","v":[["أفي كلَّ يومٍ أنتَ صبٌّ وليلةٍ","إلأى أمَّ بكرٍ لاَ تفيقُ فتقصرُ"],["أُحِبُّ عَلَى الهِجْرانِ أكْنَافَ بَيْتِهَا","فيا لكَ منْ بيتٍ يحبُّ ويهجرُ"],["إلى جَعْفَرٍ سَارَتْ بِنَا كُلُّ جَسرَةٍ","طَوَاهَا سُرَاهَا نَحْوَهُ والتَّهَجُّرُ"],["إلى وَاسِعٍ للمجتدين فِنَاؤُهُ","تروحُ عطاياهُ عليهمْ وتبكرُ"],["أبَرَّ فمَا يَرْجُو جَوادٌ لَحَاقَهُ","أبو الفضل سباقُ اللهاميمِ جعفرُ"],["وَزِيرٌ إذا نَابَ الخَلِيفَةَ حادِثٌ","أشار بما غنهُ الخليفةُ يصدرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%81%D9%8A_%D9%83%D9%84_%D9%8A%D9%88%D9%85_%D8%A3%D9%86%D8%AA_%D8%B5%D8%A8_%D9%88%D9%84%D9%8A%D9%84%D8%A9"},"marwan-hafsa-0013":{"t":"ألم تر أن الجود من لدن آدم","v":[["ألمْ ترَ أنَّ الجودَ منْ لدنِ آدمٍ","تحدرَ حتى صارَ في راحةِ الفضلِ"],["إذَا مَا أبُو العَبَّاسِ رَاحَتْ سَمَاؤُهُ","فيا لكَ منْ هطلٍ ويا لك منْ وبلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D9%85_%D8%AA%D8%B1_%D8%A3%D9%86_%D8%A7%D9%84%D8%AC%D9%88%D8%AF_%D9%85%D9%86_%D9%84%D8%AF%D9%86_%D8%A2%D8%AF%D9%85"},"marwan-hafsa-0014":{"t":"إلى المصطفى المهدي خاضت ركابنا","v":[["إلى المصطفى المهديَّ خاضتْ ركابنا","دُجَى اللَّيْلِ يَخْبِطْنَ السَّريح المخَدَّمَا"],["يَكُونَ لَها نُورُ الإمَامِ مُحَمَّدٍ","دَلِيلاً بِهِ تَسْري إذا اللَّيْلُ أظْلَمَا"],["إذا هنَّ ألقينَ الرحالَ ببابهِ","حَطَطْنَ بِهِ ثِقْلاً وأدْرَكْنَ مَغْنَمَا"],["إلى طَاهِرِ الأخْلاَقِ مَا نَالَ مِنْ رِضاً","ولاَ غضبٍ مالاً حراماً ولاَ دمَا"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%84%D9%89_%D8%A7%D9%84%D9%85%D8%B5%D8%B7%D9%81%D9%89_%D8%A7%D9%84%D9%85%D9%87%D8%AF%D9%8A_%D8%AE%D8%A7%D8%B6%D8%AA_%D8%B1%D9%83%D8%A7%D8%A8%D9%86%D8%A7"},"marwan-hafsa-0015":{"t":"إلى ملك مثل بدر الدجى","v":[["إلَى مَلِكٍ مِثْلِ بَدْرِ الدُّجى","عظيمِ الفناءِ رفيعِ الدعمْ"],["قريعِ نزارٍ غداةَ الفخارِ","ولَوْ شِئْتُ قُلْتُ جَميعَ الأُمَمْ"],["لهُ كفُّ جودٍ تفيدُ الغنى","وكَفٌّ تُبِيدُ بِسَيْفِ النِّقَمْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%84%D9%89_%D9%85%D9%84%D9%83_%D9%85%D8%AB%D9%84_%D8%A8%D8%AF%D8%B1_%D8%A7%D9%84%D8%AF%D8%AC%D9%89"},"marwan-hafsa-0016":{"t":"أمسى المشيب من الشباب بديلا","v":[["أمْسَى المَشِيبُ مِنَ الشَّبابِ بَدِيلاً","ضيفاً أقامَ فما يريد رحيلاَ"],["والشَّيْبُ إذْ طَرَدَ السَّوادَ بَياضُه","كالصُّبْحِ أحْدَثَ للظَّلامِ أُفُولا"],["إنَّ الغواني طالما قتلننا","بعيرنهنَّ ولا يدينَ قتيلاَ"],["منْ كلَّ آنسةٍ كأنَّ حجالها","ضمنَّ أحور في الكناسِ كحيلاَ"],["أردينَ عروةَ والمرقشَ قبلهُ","كُلٌّ أُصِيبَ وما أطَاقَ ذُهُولاَ"],["وَلَقَدْ تَركْنَ أبَا ذُؤَيْبٍ هَائِماً","ولقدْ تبلنَ كثيراً وجميلاً"],["وَترَكْنَ لابنِ أبي ربِيعَةَ مَنْطِقاً","فيهنَّ أصْبَحَ سَائِراً مَحْمُولاَ"],["إلاَّ أكُنْ مِمَّنْ قَتلْنَ فإنّني","مِمّنْ ترَكْنَ فُؤادَهُ مَخْبُولاَ"],["لَوْ كَانَ جَدُّكُمُ شُرَيْكٌ وَالِداً","للناسِ لمْ تلد النساءُ بخيلاَ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%85%D8%B3%D9%89_%D8%A7%D9%84%D9%85%D8%B4%D9%8A%D8%A8_%D9%85%D9%86_%D8%A7%D9%84%D8%B4%D8%A8%D8%A7%D8%A8_%D8%A8%D8%AF%D9%8A%D9%84%D8%A7"},"marwan-hafsa-0017":{"t":"إن أمير المؤمنين المصطفى","v":[["إن أمير المؤمنين المصطفى","قَدْ تَرَكَ الصَّفْصَافَ قَاعاً صَفْصَفَا"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86_%D8%A3%D9%85%D9%8A%D8%B1_%D8%A7%D9%84%D9%85%D8%A4%D9%85%D9%86%D9%8A%D9%86_%D8%A7%D9%84%D9%85%D8%B5%D8%B7%D9%81%D9%89"},"marwan-hafsa-0018":{"t":"إن بالشام بالموقر عزا","v":[["إنَّ بالشامِ بالموقرِ عزا","ومُلوكاً مُباركينَ شُهُودَا"],["سَادةً من بَني يَزيدَ كراماً","سبقوا الناسَ مكرماتٍ وجوداَ"],["هانَ يا ناقتي علىَّ فسيري","أنْ تَمُوتي إذا لَقِيتُ الوَليدَا"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86_%D8%A8%D8%A7%D9%84%D8%B4%D8%A7%D9%85_%D8%A8%D8%A7%D9%84%D9%85%D9%88%D9%82%D8%B1_%D8%B9%D8%B2%D8%A7"},"marwan-hafsa-0019":{"t":"إن خلدت بعد الإمام محمد","v":[["إن خلدت بعدَ الإمامِ محمدٍ","نفسي لما فرحتْ بطولِ بقائها"],["إن البلاد غداةَ أصبحَ ثاوياً","كَادَتْ تَكُونُ جِبَالُهَا كَفضائِها"],["الْيَومَ أظْلِمَتِ الْبِلادُ وَرُبَّمَا","كُشِفَتْ بغُرَّتِهِ دُجَى ظُلْمَائِها"],["شَغَلَ الْعُيُونَ فَلَنْ تَرَى مِنْ بَعْدِهِ","عَيْناً عَلى أحَدٍ تَجُودُ بِمَائِها"],["أقُلِ الْحَيَاةَ إذَا رَأيْتَ قُصُورَهُ","غُبْراً خَوَاشِعَ بَعْدَ فَرْطِ بَهَائِها"],["عَمَّ الصِّحَاحَ بِعُرْفِهِ وَبِفَضْلِهِ","وَشَفَى الْمِرَاضَ بسَيْفِهِ مِنْ دَائِها"],["رَوَّى الظِّمَاءَ بَوَادِياً وعَوَامِراً","عَفْواً بِأرْشِيَةِ النَّدَىْ وَدَلاَئِها"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86_%D8%AE%D9%84%D8%AF%D8%AA_%D8%A8%D8%B9%D8%AF_%D8%A7%D9%84%D8%A5%D9%85%D8%A7%D9%85_%D9%85%D8%AD%D9%85%D8%AF"},"marwan-hafsa-0020":{"t":"بدولة جعفر حمد الزمان","v":[["بِدَوْلَةِ جَعْفَرٍ حُمِدَ الزَّمانُ","لنا بكَ كلَّ يومٍ مهرجانُ"],["جعلتُ هديتي لكَ فيهِ وشياً","وخيرُ الوشي ما نسجَ اللسانُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D8%AF%D9%88%D9%84%D8%A9_%D8%AC%D8%B9%D9%81%D8%B1_%D8%AD%D9%85%D8%AF_%D8%A7%D9%84%D8%B2%D9%85%D8%A7%D9%86"},"marwan-hafsa-0021":{"t":"بسبعين ألفا راشني من حبائه","v":[["بِسَبْعِينَ ألفاً رَاشَنِي مِنْ حَبائِهِ","وما نالها في الناسِ منْ شاعرٍ قبلي"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D8%B3%D8%A8%D8%B9%D9%8A%D9%86_%D8%A3%D9%84%D9%81%D8%A7_%D8%B1%D8%A7%D8%B4%D9%86%D9%8A_%D9%85%D9%86_%D8%AD%D8%A8%D8%A7%D8%A6%D9%87"},"marwan-hafsa-0022":{"t":"بكت عنان مسبل دمعها","v":[["بَكَتْ عَنَانٌ مُسْبلٌ دَمْعُها","كالدرَّ يسننُ منْ خيطهِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D9%83%D8%AA_%D8%B9%D9%86%D8%A7%D9%86_%D9%85%D8%B3%D8%A8%D9%84_%D8%AF%D9%85%D8%B9%D9%87%D8%A7"},"marwan-hafsa-0023":{"t":"بكى الشام معنا يوم خلى مكانه","v":[["بكَى الشَّامُ مَعْناً يَوْمَ خَلَّى مَكَانَهُ","فَكَادَتْ لَهُ أرْضُ الْعِرَاقَيْنِ تَرْجِفُ"],["ثَوَى الْقَائِدُ الْمَيْمُونُ والذَّائِدُ الَّذي","به كلن يرمى الجانب المتخوف"],["أتى الموت معنا وهوة للعرض صائنٌ","وللمجد مبتاعٌ وللمال متلف"],["وما مات حتى قلدتهٍ أمورها","رَبِيْعَةُ وَالْحَيَّانُ قَيْسٌ وَخُنْدُفُ"],["وَحَتّى فَشَا في كُلِّ شَرْقٍ وَمَغْربِ","أيادٍ لَهُ بِالضُّرِّ والنَّفْعِ تُعْرَفُ"],["وَكَمْ مِنْ يَدٍ عِنْدِي لِمَعْنٍ كَرِيمَةٍ","سَأشْكُرُهَا مَا دَامَتِ الْعَيْنُ تَطْرُفُ"],["بَكَتْهُ الْجِيَادُ الأعْوَجِيَّةُ إذْ ثَوَى","وحن مع النبع الوشيحِ المثقفُ"],["وَقَدْ غَنِيَتْ رِيْحُ الصَّبَا في حَيَاتِهِ","قبولاً فَأمْسَتْ وَهْيَ نَكْبَاءُ حِرْجَفُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D9%83%D9%89_%D8%A7%D9%84%D8%B4%D8%A7%D9%85_%D9%85%D8%B9%D9%86%D8%A7_%D9%8A%D9%88%D9%85_%D8%AE%D9%84%D9%89_%D9%85%D9%83%D8%A7%D9%86%D9%87"},"marwan-hafsa-0024":{"t":"بنو مروان قومي أ‘تقوني","v":[["بنو مروانَ قومي أ‘تقوني","وكلُّ الناسِ بعدُ لهمْ عبيدُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D9%86%D9%88_%D9%85%D8%B1%D9%88%D8%A7%D9%86_%D9%82%D9%88%D9%85%D9%8A_%D8%A3%E2%80%98%D8%AA%D9%82%D9%88%D9%86%D9%8A"},"marwan-hafsa-0025":{"t":"تبقى قوافي الشعر ما بقيت","v":[["تَبْقَى قَوافي الشِّعْر مَا بَقِيتُ","والشِّعْرُ مَنْسيٌّ إذا نُسِيتُ"],["لمْ يحظَ في الشعر كما حظيتُ","جمعٌ منَ الناس ولاَ شتيتُ"],["كَمْ مَلِكٍ حُلَّتُهُ كُسِيتُ","وَمِنْ سَرير مُلْكِهِ أُدْنِيتٌ"],["إنْ غبتُ عنْ حضرتهِ دعيتُ","وإنْ حضرتُ بابهُ حييتُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%A8%D9%82%D9%89_%D9%82%D9%88%D8%A7%D9%81%D9%8A_%D8%A7%D9%84%D8%B4%D8%B9%D8%B1_%D9%85%D8%A7_%D8%A8%D9%82%D9%8A%D8%AA"},"marwan-hafsa-0026":{"t":"تخيرت للمدح ابن يحيى بن خالد","v":[["تَخَيَّرْتُ لِلْمَدْحِ ابنَ يَحْيَى بن خَالِد","فحسبي ولمْ أظلمْ بأنْ أتخيراَ"],["لهُ عادةٌ أنْ يبسطَ سارَ ولمْ يزلْ","لِمَنْ سَاسَ مِنْ قَحْطَانَ أوْ مَنْ تَنزَّرَا"],["إلى المنبرِ الشرقيّ سارَ ولمْ يزلْ","لهُ والدٌ يعلو سريراً ومنبراَ"],["يُعَدُّ ويَحْيَى البَرْمَكِيّ وَلاَ يُرَى","لَهُ الدَّهْرَ إلاَّ قَائِداً أوْ مؤَمَّرَا"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%AE%D9%8A%D8%B1%D8%AA_%D9%84%D9%84%D9%85%D8%AF%D8%AD_%D8%A7%D8%A8%D9%86_%D9%8A%D8%AD%D9%8A%D9%89_%D8%A8%D9%86_%D8%AE%D8%A7%D9%84%D8%AF"},"marwan-hafsa-0027":{"t":"تشابه يوما بأسه ونواله","v":[["تشابهَ يوما بأسه ونوالهِ","فما أحدٌ يدري لأيهما الفضلُ"],["شَبِيهُ أبِيهِ مَنْظَراً وخَلِيقَةً","كَما حُذِيَتْ يَوْماً عَلَى أُخْتِهَا النَّعْلُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%B4%D8%A7%D8%A8%D9%87_%D9%8A%D9%88%D9%85%D8%A7_%D8%A8%D8%A3%D8%B3%D9%87_%D9%88%D9%86%D9%88%D8%A7%D9%84%D9%87"},"marwan-hafsa-0028":{"t":"ثلاثون ألفا كلها طبرية","v":[["ثَلاثُونَ ألْفاً كُلُّهَا طَبَريَّةٌ","دعا بها لما رأى الصكَّ صالحُ"],["دعا بالزيوفِ الناقصاتِ وإنما","عطاءُ أبي الفضل الجيادُ الواجحُ"],["فَقُلْتُ لَهُ لَمَّا دَعَا بزُيُوفِهِ","أألْجدُّ هَذَا مِنْكَ أمْ أنْتَ مَازِحُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AB%D9%84%D8%A7%D8%AB%D9%88%D9%86_%D8%A3%D9%84%D9%81%D8%A7_%D9%83%D9%84%D9%87%D8%A7_%D8%B7%D8%A8%D8%B1%D9%8A%D8%A9"},"marwan-hafsa-0029":{"t":"حل المشيب فلن يحول برحله","v":[["حلَّ المشيبُ فلنْ يحولَ برحلهِ","عَنِّي وَبَانَ فَلَنْ يَؤوبَ شَبَابِي"],["فَرَعَتْ بَنُو مَعْنٍ رَوَابيَ وَائِلٍ","مُتَمَهِّلِينَ وَهُنَّ خَيْرُ رَوَابي"],["قومٌ رواقُ المكرماتِ عليهم","عَالي الْعِمادِ مُمَهَّدِ اْلأطْنَابِ"],["يَلقى العدوَّ لهمْ إذا ما رامهم","أركانُ شامخةٌ عليهِ صعابُ"],["وهمُ النّضارُ إذا القبائلُ حُصِّلتْ","أنسابُهَا ولبابُ كلِّ لبابِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AD%D9%84_%D8%A7%D9%84%D9%85%D8%B4%D9%8A%D8%A8_%D9%81%D9%84%D9%86_%D9%8A%D8%AD%D9%88%D9%84_%D8%A8%D8%B1%D8%AD%D9%84%D9%87"},"marwan-hafsa-0030":{"t":"حمدنا الذي أدى ابن يحيى فأصبحت","v":[["حَمدْنَا الذي أدَّى ابنُ يَحْيَى فأصْبَحَتْ","بمقدمهِ تجري لنا الطيرُ أسعداَ"],["وما هَجَعَتْ حَتَّى رَأتْهُ عُيُونُنا","وما زلْنَ حتّى آبَ بالدَّمْع حُشَّدَا"],["لَقَدْ صَبَحَتْنا خَيْلُهُ ورجَالُهُ","بأرْوَع بَدْءِ النَّاس بَأْساً وسُؤدَدا"],["فكانَ مِن الآباءِ أحْنَى وأعْوَدَا","ضُحى الصُّبْحِ جِلْبَابَ الدُّجَى فَتَعَرَّدا"],["لقدْ راعَ منْ أمسى بمرو مسيرهُ","إلينا وقالوا شعبنا قدْ تبددا"],["عَلى حِينَ ألْقَى قُفْلَ كُلِّ ظُلاَمَةٍ","وأطْلَقَ بالعَفْوِ الأسيرَ المُقَيَّدَا"],["وأفْشَى بِلاَ مَنٍّ مَعَ العَدْلِ فِيهِم","أيادِيَ عُرْفٍ بَاقِيَاتٍ وَعُوَّدَا"],["فأذهب روعاتِ المخاوفِ عنهمُ","واصدرَ باغس الأمنِ فيهم وأورداَ"],["وأجْدى عَلَى الأيْتَام فيهم بِعْرُفِهِ","فكانَ منَ الآباءِ أحنى وأ‘وداَ"],["إذا النَّاسُ رامُوا غَايَةَ الفَضْلِ في النَّدَى","وفي البأسِ ألفوها من النجمِ أبعداَ"],["سَمَا صَاعِداً بالفَضْلِ يَحْيَى وَخالِدٌ","إلى كلَّ أمرٍ كان أسنى وأمجداَ"],["يلين لمنْ أعطى الخليفة طاعةً","ويسقي دمَ العاصي الحسامَ المهنداَ"],["أدلتْ معَ الشركِ النفاقَ سيوفهُ","وكانَتْ لأهْلِ الدِّينِ عِزاً مُؤبَّدَا"],["وشدَّ القوى منْ بيعةِ المصطفى الذي","عَلَى فَضْلِهِ عَهْدَ الخَلِيفَةِ قُلِّدَا"],["سَمِيُّ النَّبِيِّ الفَاتِح الخَاتم الذي","بهِ الله أعطى كلَّ خيرٍ وسدداَ"],["أبحتَ جبالَ الكابليَّ ولمْ تدعْ","بهنَّ لنيرانِ الضلالةِ موقداَ"],["فأطْلَعْتَها خَيْلاً وَطِئْنَ جُمُوعَهُ","قَتِيلاً وَمَأْسُوراً وَفَلاًّ مُشَرَّدَا"],["وعدتْ على ابن البرمِ نعماكَ بعدما","تحوبَ مخذولاً يرى الموت مفرداَ"]],"src":"https://ar.wikisource.org/wiki/%D8%AD%D9%85%D8%AF%D9%86%D8%A7_%D8%A7%D9%84%D8%B0%D9%8A_%D8%A3%D8%AF%D9%89_%D8%A7%D8%A8%D9%86_%D9%8A%D8%AD%D9%8A%D9%89_%D9%81%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA"},"marwan-hafsa-0031":{"t":"خلت بعدنا من آل ليلى المصانع","v":[["خلتْ بعدنا منْ آل ليلى المصانعُ","وَهَاجَتْ لنا الشَّوْقَ الدِّيَارُ البَلاَقِعُ"],["أبيتُ وجنتي لا يلائمُ مضجعاً","إذا ما اطْمَأنَّتْ بالجُنُوبِ المَضَاجِعُ"],["أتَاني مِنَ المَهْدِيِّ قَوْلٌ كأنَّما","به احتز أنفي مدمن الضعن جادعُ"],["وَقُلْتُ وَقَدْ خِفْتُ التي لا شوىً لها","بِلاَ حَدَثٍ: إنِّي إلَى الله رَاجعُ"],["ومالي إلى الهدي لو كنت مذنباً","سوى حلمه الصافي من الناس شافعُ"],["وَلاَ هُوَ عِنْدَ السُّخْطِ منه ولا الرِّضَا","بغير الذي يرضى به لي صانعُ"],["عليه من التوى رداءٌ يكنهٌ","وللحق نورٌ بين عينيهٍ ساطعُ"],["يغضنُّ له طرف العيون وطرفه","على غَيْرِهِ مِنْ خَشْيَةِ الله خَاشِعُ"],["هَل البَابُ مُفْضٍ بي إليك ابنَ هاشم","فعذري إن أفضى بي الباب ناصع"],["أتيتُ ضباب العدم عنه وراشه","وأنْهَضَهُ مَعْرُوفُكَ المُتَتَابعُ"],["فَقُلْتُ وَزيرٌ نَاصِحٌ قَدْ تَتَابَعَتْ","عليه بإنعام الإمام الصتائع"],["وَمَا كَانَ لي إلاَّ إليْكَ ذَرِيعَةٌ","وما مَلِكٌ إلاَّ إليه الذَّرَائِعُ"],["وإنْ كَانَ مَطْويّاً عَلى الغَدْرِ كَشْحُهُ","فَلَمْ أدْرِ مِنْهُ ما تُجنُّ الأضَالِعُ"],["وَقُلْ مِثْلَ مَا قَالَ ابْنُ يَعْقُوبَ يوسُفُ","لأخوانه قولاً له القلب نائع"],["تَنَفَّسْ فَلا تَثرِيبَ إنَّكَ آمِنٌ","وإنِّي لَكَ المَعْرُوفَ والقَدْرَ جَامِعُ"],["فما الناسُ إلا ناظرٌ متشوفٌ","إلى كا ما تسدي إلي وسامعُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AE%D9%84%D8%AA_%D8%A8%D8%B9%D8%AF%D9%86%D8%A7_%D9%85%D9%86_%D8%A2%D9%84_%D9%84%D9%8A%D9%84%D9%89_%D8%A7%D9%84%D9%85%D8%B5%D8%A7%D9%86%D8%B9"},"marwan-hafsa-0032":{"t":"ذهب الفرزدق بالفخار وإنما","v":[["ذهبَ الفرزدق بالفخار وإنما","حُلْوُ القَصِيدِ وَمُرُّهُ لِجَرِيرِ"],["ولقدْ هجا فأمضَّ أخطلَ تغلبٍ","وحَوَى اللُّها بِبَيانِهِ المَشهُورِ"],["كُلُّ الثَّلاثَةِ قَدْ أبَرَّ بِمَدْحِهِ","وهجاؤهُ قدْ سارَ كلَّ مسيرِ"],["وَلَقَدْ جَرْيتُ مَعَ الجِيادِ فَفُتُّها","بعنانِ لا شبم ولا مبهورِ"],["مَا نَالَتِ الشُّعَراءُ مِن مُسْتَخْلَفٍ","ما نلتُ منْ جاهٍ وأخذِ بدورِ"],["عزَّتْ مَعاً عِنْدَ المُلوكِ مَقَالَتي","مَا قَالَ حَيُّهُمُ مَعَ المَقْبُورِ"],["ولقدْ حبيتُ بألفِ ألفٍ لم تثبْ","إلاَّ بسيبِ خليفةٍ وأميرِ"],["ما زلتُ آنفُ أنْ أؤلفَ مدحةً","إلاَّ لِصَاحِبِ مِنْبَرٍ وسَرِيرِ"],["أروي الظماءَ بكلَّ حوضٍ مفعمٍ","جوداً وأرترعُ ااسغابِ قدوري"],["وَتظَلُّ للإحْسَان ضَامِنَةَ القِرَى","بدءِ كلَّ تامكةِ السنامِ عقيري"],["أُعْطي اللُّها مُتبَرِّعَاً عَوْداً عَلَى","بدءِ وذاكَ عليَّ غيرُ كثيرِ"],["وإذا هدرتُ معَ القرومُ محاضراً","في مَوْطنٍ فَضَحَ القُرومَ هَدِيري"]],"src":"https://ar.wikisource.org/wiki/%D8%B0%D9%87%D8%A8_%D8%A7%D9%84%D9%81%D8%B1%D8%B2%D8%AF%D9%82_%D8%A8%D8%A7%D9%84%D9%81%D8%AE%D8%A7%D8%B1_%D9%88%D8%A5%D9%86%D9%85%D8%A7"},"marwan-hafsa-0033":{"t":"رأيت ابن معن أنطق الناس جوده","v":[["رأيتُ ابنَ معنٍ أنطقَ الناسَ جودهُ","فَكَلَّفَ قَوْلَ الشِّعْرِ مَنْ كَانَ مُفْحَمَا"],["وارخصَ بالعدلِ السلاحَ بأرضنا","فما يبلغُ السيفُ المهندُ درهما"]],"src":"https://ar.wikisource.org/wiki/%D8%B1%D8%A3%D9%8A%D8%AA_%D8%A7%D8%A8%D9%86_%D9%85%D8%B9%D9%86_%D8%A3%D9%86%D8%B7%D9%82_%D8%A7%D9%84%D9%86%D8%A7%D8%B3_%D8%AC%D9%88%D8%AF%D9%87"},"marwan-hafsa-0036":{"t":"سيحشر يعقوب بن داود خائبا","v":[["سيحشرُ يعقوبُ بنُ داودَ خائباً","يَلُوحُ كِتَابٌ بَيْنَ عَيْنَيْهِ كَافرُ"],["خيانتهُ المهديَّ أودتْ بذكرهِ","فأمْسَى كَمَنْ قَدْ غَيَّبَتْهُ المَقَابِرُ"],["بَدَا مِنْكَ لِلْمَهْدِيِّ كالصُّبْحِ سَاطِعاً","من الغِشِّ مَا كَانَتْ تُجِنُّ الضَّمَائِرَ"],["وهلْ لبياضِ الصبحِ إنْ لاحَ ضوؤهُ","فَجَابَ الدُّجَى مِنْ ظُلْمَةِ اللَّيْلِ سَاتِرُ"],["أمَنْزِلَةٌ فَوْقَ التي كُنْتَ نِلْتَها","تعاطيتَ لا أفلحتَ مما تحاذرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%B3%D9%8A%D8%AD%D8%B4%D8%B1_%D9%8A%D8%B9%D9%82%D9%88%D8%A8_%D8%A8%D9%86_%D8%AF%D8%A7%D9%88%D8%AF_%D8%AE%D8%A7%D8%A6%D8%A8%D8%A7"},"marwan-hafsa-0037":{"t":"شفاء الصدى ماء المساويك والذي","v":[["شفاءُ الصدى ماءُ المساويكِ والذي","بِهِ الرِّيقُ مِنْ خَمْلٍ يُغَازِلُها طَفْلُ"],["فيا حَبَّذا ذاكَ السِّواكُ وحَبَّذا","بهِ البَرَدُ العَذْبُ الغَرِيضُ الذي يَجْلُو"]],"src":"https://ar.wikisource.org/wiki/%D8%B4%D9%81%D8%A7%D8%A1_%D8%A7%D9%84%D8%B5%D8%AF%D9%89_%D9%85%D8%A7%D8%A1_%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%88%D9%8A%D9%83_%D9%88%D8%A7%D9%84%D8%B0%D9%8A"},"marwan-hafsa-0038":{"t":"صح الجسم يا عمرو","v":[["صَحَّ الجِسْمُ يَا عَمْرُو","لكَ التمحيصُ والأجرُ"],["وللهِ علينا الحمدُ","دُ والمِنَّةُ والشُّكْرُ"],["فقدْ كانَ شكا شوقاً","إليكَ النهيُ والأمرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%B5%D8%AD_%D8%A7%D9%84%D8%AC%D8%B3%D9%85_%D9%8A%D8%A7_%D8%B9%D9%85%D8%B1%D9%88"},"marwan-hafsa-0039":{"t":"صحا بعد جهل فاستراحت عواذله","v":[["صَحَا بَعْدَ جَهْل فاسْتَراحَتْ عَواذِلُهْ","واقصرنَ عنهُ حينَ أقصرَ باطلهْ"],["وَقَال الغَواني قَد تَوَلَّى شَبابُهُ","وبدل شيبا بالخضابِ يقاتلهْ"],["يُقَاتِلُهُ كَيْمَا يَحُولَ خِضَابُهُ","وهيهاتَ لا يخفي على اللحظِ ناصلهْ"],["ومنْ مدَّ في أيامهِ فتأخرتْ","مَنِيَّتُهُ فالشَّيْبُ لاَ شَكَّ شَامِلُهْ"],["إليكَ قصرنا النصف منْ صلواتنا","مَسِيرَة شَهْرٍ بَعْدَ شَهْرٍ نُواصِلُهْ"],["فَلاَ نَحْنُ نَخْشَى أنْ يَخيِبَ رَجاؤُنَا","إليكَ ولكِنْ أهْنأُ الخَير عاجِلُهْ"],["هوَ المرءُ أما دينهُ فهوَ مانعٌ","صَئُونٌ وأمَّا مَالهُ فَهْوَ بَاذِلهْ"],["أمَرَّ وأحْلَى مَا بلا النَّاسُ طَعْمَهُ","عقابُ أمير المؤمنين ونائلهْ"],["أبيٌ لما يأبى ذوو الحزمِ والتقى","فَعُولٌ إذا مَا جَدَّ بالأمْر فَاعِلُهْ"],["تَرُوكُ الهَوَى لا السُّخْطُ منه ولا الرِّضَا","لدى موطنٍ إلا على الحقَّ حاملهْ"],["يرى أن مرَّ الحق أحلى مغبةً","وأنْجَى ولو كانَتْ زُعَافاً مَناهِلُهْ"],["صَحِيحُ الضَّميرِ سِرُّهُ مِثْلُ جَهْرِهِ","قِيَاسَ الشِّراكِ بالشِّراكِ تُقَابِلُهْ"],["فإنَّ طليقَ الله منْ هوَ مطلقٌ","وإنَّ قَتِيلَ الله مَنْ هُو قَاتِلُهْ"],["فإنكَ بعدَ اللهِ للحكمُ الذي","تُصابُ بِهِ مِنْ كُلِّ حَقٍّ مَفَاصِلُهْ"],["كأنَّ أمِيرَ المُؤْمِنينَ مُحَمَّداً","أبو جعفرٍ في كل أمرٍ يحاولهْ"],["كَفَاكُمْ بِعَبَّاس أبي الفَضْلِ وَالداً","فما من أب إلأا أبو العباس فاضلهْ"]],"src":"https://ar.wikisource.org/wiki/%D8%B5%D8%AD%D8%A7_%D8%A8%D8%B9%D8%AF_%D8%AC%D9%87%D9%84_%D9%81%D8%A7%D8%B3%D8%AA%D8%B1%D8%A7%D8%AD%D8%AA_%D8%B9%D9%88%D8%A7%D8%B0%D9%84%D9%87"},"marwan-hafsa-0040":{"t":"طاف الخيال وحيه بسلام","v":[["طَافَ الخَيالُ وَحَيِّهِ بِسَلامِ","أنى ألمَّ وليسَ حينَ لمامِ"],["الوحيُ بينَ بني البناتِ وبينكمْ","قَطَعَ الخُصَامَ فَلاَتَ حِينَ خِصَامِ"],["مَا للنِّساء مَعَ الرِّجَالِ فَرِيضَةٌ","نزلتْ بذلكِسورةُ الأنعامِ"],["ألغى سهامهمُ الكتابُ فحاولوا","أنْ يشْرَعُوا فيها بِغَيْر سِهامِ"],["ظفرتْ بنو ساقي الحجيجِ بحقهم","حَطْمُ المَناكِبِ كلَّ يَوْمِ زِحَامِ"],["وَارْضَوْا بِما قَسَمَ الإلهُ لكُمْ بِهِ","وَدَعُوا وِرَاثَه كُلِّ أصْيَدَ حَامِ"]],"src":"https://ar.wikisource.org/wiki/%D8%B7%D8%A7%D9%81_%D8%A7%D9%84%D8%AE%D9%8A%D8%A7%D9%84_%D9%88%D8%AD%D9%8A%D9%87_%D8%A8%D8%B3%D9%84%D8%A7%D9%85"},"marwan-hafsa-0041":{"t":"ظفرت فلا شلت يد برمكية","v":[["ظفرتَ فلاَ شلتْ يدٌ برمكيةٌ","رَتَقْتَ بِهَا الفَتْقَ الذي بَيْنَ هَاشِمِ"],["عَلَى حِينَ أعْيَا الرَّاتِقِينَ التِئَامُهَ","فَكَفُّوا وَقالوا لَيْسَ بالمُتَلاَئِمِ"],["فأصبحتَ قدْ فازتْ يداكَ بخطةٍ","مِنَ المَجْدِ بَاقٍ ذِكْرُها في المَواسِمِ"],["وما زَالَ قِدْحُ المُلكِ يَخْرُجُ فَائِزاً","لَكُمْ كُلَّما ضُمَّتْ قِدَاحُ الْمُسَاهِمِ"]],"src":"https://ar.wikisource.org/wiki/%D8%B8%D9%81%D8%B1%D8%AA_%D9%81%D9%84%D8%A7_%D8%B4%D9%84%D8%AA_%D9%8A%D8%AF_%D8%A8%D8%B1%D9%85%D9%83%D9%8A%D8%A9"},"marwan-hafsa-0042":{"t":"عقدت لموسى بالرصافة بيعة","v":[["عقدتْ لموسى بالرصافةِ بيعةٌ","شدَّ الإلهُ بها عرى الإسلامِ"],["موسى الذي عرفتْ قريشٌ فضلهُ","ولها فضيلتها على الأوقوامِ"],["بمحمدٍ بعدَ النبيَّ محمدٍ","حَيِيَ الْحَلاَلُ وَمَاتَ كُلُّ حَرَامِ"],["مهديُّ أمتهِ الذي أمستْ بهِ","لِلذُّلِّ آمِنَةً وَلِلإعْدَامِ"],["موسى ولى عهدَ الخلافةِ بعدهُ","جفتْ بذاكَ مواقعُ الأقلامِ"]],"src":"https://ar.wikisource.org/wiki/%D8%B9%D9%82%D8%AF%D8%AA_%D9%84%D9%85%D9%88%D8%B3%D9%89_%D8%A8%D8%A7%D9%84%D8%B1%D8%B5%D8%A7%D9%81%D8%A9_%D8%A8%D9%8A%D8%B9%D8%A9"},"marwan-hafsa-0044":{"t":"فما بلغت حتى حماها كلالها","v":[["فما بلغتْ حتى حماها كلالها","إذا عريتْ أصلابها أنْ تقيدا"],["تشابهتما حلماً وعدلاً ونائلاً","وحزماً إذا أمرٌ أقامَ وأقعدا"],["تَنَازَعْتُما نَفْسَيْن هَذي كَهَذَه","عَلى أصْل عِرْق كَانَ أفخر مُتْلَدَا"],["كما قَاس نَعْلاً حَضْرِميّاً فَقَدَّهَا","عَلَى أُخْتَهَا لَمْ يَأْلُ أنْ يَتَجَوَّدَا"],["بسَبْعِينَ ألْفاً شَدَّ ظَهْري وَرَاشَني","أبُوكَ وَقَدْ عَايَنْتَ مِنْ ذَاكَ مَشْهَدَا"],["وإني أميرَ المؤمنينَ لواثقٌ","بأنْ لا يرى شربي لديكَ مصدراَ"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D9%85%D8%A7_%D8%A8%D9%84%D8%BA%D8%AA_%D8%AD%D8%AA%D9%89_%D8%AD%D9%85%D8%A7%D9%87%D8%A7_%D9%83%D9%84%D8%A7%D9%84%D9%87%D8%A7"},"marwan-hafsa-0045":{"t":"قاسيت شدة أيامي فما ظفرت","v":[["قَاسَيْتُ شِدَّةَ أيَّامي فَما ظَفَرتْ","يدايَ منها بصابٍ ولا عسلِ"],["ولا أغيرُ شيبي بالخضاب وهلْ","في العَقْلِ تَغْييرُ شَيْبِ الرَّأْسِ بالحِيَلِ"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D8%A7%D8%B3%D9%8A%D8%AA_%D8%B4%D8%AF%D8%A9_%D8%A3%D9%8A%D8%A7%D9%85%D9%8A_%D9%81%D9%85%D8%A7_%D8%B8%D9%81%D8%B1%D8%AA"},"marwan-hafsa-0046":{"t":"قد أمن الله من خوف ومن عدم","v":[["قدْ أمنَ اللهُ منْ خوفٍ ومنْ عدمِ","منْ كانَ معنٌ لهُ جاراً منَ الزمنِ"],["مَعْنُ بنُ زَائِدَة المُوفي بِذِمَّتِهِ","والمُشْتَري المَجْدَ بالغالي مِنَ الثَّمَنِ"],["يَرَى العَطَايا التي تَبْقَى مَحَامِدُها","غُنْماً إذا عَدَّها المُعْطى مِنَ الغَبَنِ"],["بَنَى لِشَيْبانَ مَجْداً لا زَوالَ لَهُ","حَتَّى تَزُولَ ذُرَى الأرْكَان مِنْ حَضَنِ"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D8%AF_%D8%A3%D9%85%D9%86_%D8%A7%D9%84%D9%84%D9%87_%D9%85%D9%86_%D8%AE%D9%88%D9%81_%D9%88%D9%85%D9%86_%D8%B9%D8%AF%D9%85"},"marwan-hafsa-0048":{"t":"كفى لك فخرا أن أكرم حرة","v":[["كفى لكَ فخراً أنَّ أكرمَ حرةٍ","غذتكَ يثديٍ والخليفةُ واحدُ"],["لقدْ زنتَ يحيى في المشاهدِ كلها","كَمَا زَانَ يَحْيَى خَالِداً، في الْمَشَاهِدِ"]],"src":"https://ar.wikisource.org/wiki/%D9%83%D9%81%D9%89_%D9%84%D9%83_%D9%81%D8%AE%D8%B1%D8%A7_%D8%A3%D9%86_%D8%A3%D9%83%D8%B1%D9%85_%D8%AD%D8%B1%D8%A9"},"marwan-hafsa-0049":{"t":"لا تعدموا راحتي معن فإنهما","v":[["لاَ تَعْدَمُوا رَاحَتَيْ مَعْنٍ فإنَّهما","بالجودِ أفتنتا يحيى بنَ منصورِ"],["لما رأى راحتي معن تدفقتا","بِنَائِلٍ مِنْ عَطاءٍ غَيْرِ مَنْزُورِ"],["ألقى المسوح التي قدْ كانَ يلبسها","وظلَّ للشعرِ ذا رصفٍ وتحبيرُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%A7_%D8%AA%D8%B9%D8%AF%D9%85%D9%88%D8%A7_%D8%B1%D8%A7%D8%AD%D8%AA%D9%8A_%D9%85%D8%B9%D9%86_%D9%81%D8%A5%D9%86%D9%87%D9%85%D8%A7"},"marwan-hafsa-0050":{"t":"لعمرك لا أنسى غداة المحصب","v":[["لعمركَ لا أنسى غداةَ المحصبِ","إشارةَ سلمى بالبنان المخضبِ"],["وَقَدْ صَدَرَ الحُجَّاجُ إلاَّ أقَلَّهُمْ","مصادرَ شتى موكباً بعدَ موكبِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%B9%D9%85%D8%B1%D9%83_%D9%84%D8%A7_%D8%A3%D9%86%D8%B3%D9%89_%D8%BA%D8%AF%D8%A7%D8%A9_%D8%A7%D9%84%D9%85%D8%AD%D8%B5%D8%A8"},"marwan-hafsa-0051":{"t":"لعمري لنعم الغيث أصابنا","v":[["لعمري لنعمَ الغيثُ أصابنا","بِبَغْدَادَ مِنْ أرْضِ الجَزيرَةِ وَابِلُهْ"],["فكنا كحيَّ صبحَ الغيثُ أهلهُ","ولمْ ترتحلْ أظعانه ورواحلةْ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%B9%D9%85%D8%B1%D9%8A_%D9%84%D9%86%D8%B9%D9%85_%D8%A7%D9%84%D8%BA%D9%8A%D8%AB_%D8%A3%D8%B5%D8%A7%D8%A8%D9%86%D8%A7"},"marwan-hafsa-0052":{"t":"لقد أصبحت تختال في كل بلدة","v":[["لقدْ أصبحتْ تختالُ في كلَّ بلدةٍ","بِقَبْرِ أميرِ المُؤْمِنينَ المَقَابِرُ"],["أتَتْهُ التي ابتزَّتْ سليمانَ مُلْكَهُ","وألوتْ بذي القرنينِ منها الدوائرُ"],["أتتهُ فغالتهُ المنايا ملكةُ","ومعروفهُ في الشرقِ والغربِ ظاهرُ"],["ولو كان تَجْرِيدُ السيوفِ يَرُدُّها","ثَنَتْ حدَّها عنه السيوفُ البواتِرُ"],["بأيدٍ بها تُعْطَى الصوارمُ حَقَّها","وتروى لدى الروعِ الرماحُ الشواجرُ"],["ولو لم تُسَكَّنْ بابنهِ بعدَ مَوْتِهِ","لما برحتْ تبكي عليه المنابرُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%82%D8%AF_%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA_%D8%AA%D8%AE%D8%AA%D8%A7%D9%84_%D9%81%D9%8A_%D9%83%D9%84_%D8%A8%D9%84%D8%AF%D8%A9"},"marwan-hafsa-0053":{"t":"لقد أفسدت شيبان بكر بن وائل","v":[["لقدْ أفسدتْ شيبانُ بكرَ بنَ وائلِ","منَ التمرِ ماْ لوْ أصلحتهُ لمارها"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%82%D8%AF_%D8%A3%D9%81%D8%B3%D8%AF%D8%AA_%D8%B4%D9%8A%D8%A8%D8%A7%D9%86_%D8%A8%D9%83%D8%B1_%D8%A8%D9%86_%D9%88%D8%A7%D8%A6%D9%84"},"marwan-hafsa-0054":{"t":"لقد كانت مجالسنا فساحا","v":[["لَقَدْ كَانَتْ مَجَالِسُنَا فساحاً","فَضَيَّقَهَا بلحْيَتِهِ رَباحُ"],["مبعثرةُ الأسافلِ والأعالي","لها في كلَّ زارويةٍ جناحُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%82%D8%AF_%D9%83%D8%A7%D9%86%D8%AA_%D9%85%D8%AC%D8%A7%D9%84%D8%B3%D9%86%D8%A7_%D9%81%D8%B3%D8%A7%D8%AD%D8%A7"},"marwan-hafsa-0057":{"t":"لما سمعت ببيعة لمحمد","v":[["لما سمعتُ ببيعةٍ لمحمد","شَفَتِ النُّفُوسَ وأذهَبَتْ أحْزَانَها"],["بَايَعْتُ مُغْتَبِطاً وَلَوْ لَمْ تَنْبَسِطْ","كَفِّي لبَيْعَتِهِ قَطَعْتُ بَنَانَها"],["رَجَحَتْ زُبَيْدَةُ والنِّساءُ شَوَائِلٌ","والله أرْجَح بالتُّقَى مِيزَانَها"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%85%D8%A7_%D8%B3%D9%85%D8%B9%D8%AA_%D8%A8%D8%A8%D9%8A%D8%B9%D8%A9_%D9%84%D9%85%D8%AD%D9%85%D8%AF"},"marwan-hafsa-0059":{"t":"لو كنت أشبهت يحيى في مناكحه","v":[["لَوْ كُنْتَ أشْبَهْتَ يَحْيَى في مَنَاكِحِهِ","لما تنقيتَ فحلاً جدهُ مطرُ"],["لله دَرُّ جِيادٍ كُنْتَ سَائِسَهَا","ضَيَّعْتَها وبها التَّحْجيلُ والغُرَرُ"],["نبئتُ خولةَ قالتْ يومَ أنكحها","قَدْ طَالَ ما كُنْتُ مِنْكَ العَارَ أنْتَظِرُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%88_%D9%83%D9%86%D8%AA_%D8%A3%D8%B4%D8%A8%D9%87%D8%AA_%D9%8A%D8%AD%D9%8A%D9%89_%D9%81%D9%8A_%D9%85%D9%86%D8%A7%D9%83%D8%AD%D9%87"},"marwan-hafsa-0060":{"t":"ما الفضل إلا شهاب لا أفول له","v":[["ما الفَضْلُ إلاَّ شِهابٌ لاَ أُفُولَ لَهُ","عندَ الحروبِ إذا ما تأفلُ الشهب"],["حَامٍ عَلَى مُلْكِ قَوْمٍ عَزَّ سَهْمُهُمُ","مِنَ الوِرَاثَةِ في أيْدِيِهم سَبَبُ"],["أمستْ يدٌ لبني ساقي الحجيجِ بها","كتائبٌ ما لها في غيرهمْ أربُ"],["كتائبٌ لبني العباسِ قدْ عرفتْ","ما ألفَ الفضل منها العجمُ والعربُ"],["أثَبْتَ خَمْسَ مئِينَ في عِدادِهِم","مِنَ الأُلُوفِ التي أحْصَتْ لَكَ الكُتُبُ"],["يُقَارِعُونَ عَنِ القَوْمِ الذين هُمُ","أولى بأحمدَ في الفرقانِ إنْ نسبوا"],["إن الجوادَ ابنَ يحيى الفضلَ لا ورقٌ","يَبْقَى عَلَى جُودِ كَفَّيْهِ وَلاَ ذَهَبُ"],["ما مَرَّ يَوْمٌ لَهُ مُذْ شَدَّ مِئْزَرَهُ","إلا تمولَ أقوامٌ بما يهبُ"],["كَمْ غَايَةٍ في النَّدَى والبَأْسِ أحْرَزَها","للِطَّالِبينَ مَدَاهَا دُونَها تَعَبُ"],["يعطي اللها حينَ لا يعطي الجوادُ ولاَ","يَنْبُو إذا سُلَّتِ الهِنْدِيَّةُ القُضُبُ"],["وَلاَ الرِّضَا والرِّضَا لله غَايَتُهُ","إلى سِوَى الحَقِّ يَدعُوهُ ولاَ الغَضَبُ"],["قَدْ فَاضَ عُرْفُكَ حَتَّى ما يُعَادِلُهُ","غَيْثٌ مُغِيثٌ ولا بَحْرٌ لَهُ حَدَبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7_%D8%A7%D9%84%D9%81%D8%B6%D9%84_%D8%A5%D9%84%D8%A7_%D8%B4%D9%87%D8%A7%D8%A8_%D9%84%D8%A7_%D8%A3%D9%81%D9%88%D9%84_%D9%84%D9%87"},"marwan-hafsa-0061":{"t":"ما من عدو ويرى معنا بساحته","v":[["ما منْ عدوًّ ويرى معناً بساحتهِ","إلا يظنُّ المنايا تسبقُ القدراَ"],["يلفى إذا الخيلُ لمْ تقدمْ فوارسها","كاللَّيْثِ يَزْدادُ إقْداماً إذا زُجِرَا"],["أغرُّ يحسبُ يومَ الروعِ ذا لبدٍ","ورداً ويحسبُ فوقَ المنبرِ القمرا"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7_%D9%85%D9%86_%D8%B9%D8%AF%D9%88_%D9%88%D9%8A%D8%B1%D9%89_%D9%85%D8%B9%D9%86%D8%A7_%D8%A8%D8%B3%D8%A7%D8%AD%D8%AA%D9%87"},"marwan-hafsa-0062":{"t":"ما يلمع البرق إلا حن مغترب","v":[["ما يلمعُ البرقُ إلاَّ حنَّ مغتربُ","كأنَّه من دَواعِي شوقِهِ وَصِبُ"],["أهلاً بطيفٍ لأمَّ السمطِ أرقنا","ونحن لا صددٌ منها ولاَ كثبُ"],["ودي على ما عهدتهمْ في تجددهِ","لا القلبُ عنكم بطولِ النأي ينقلبُ"],["كَفَى القَبَائِلَ مَعْنٌ كُلَّ مُعْضِلَةٍ","يُحْمَى بها الدِّينُ أوْ يُرْعى بها الحَسَبُ"],["كَنْزُ المَحامِدِ والتَّقْوَى دَفَاتِرُهُ","وليسَ مِنْ كَنْزِهِ الأوْرَاقُ والذَّهَبُ"],["أنتَ الشهابُ الذي يرمى العدوُّ بهِ","فَيَسْتَنيرُ وَتخْبُو عِنْدَهُ الشُّهُبُ"],["بَنُو شُرَيْكٍ هُمُ القَوْمُ الذين لَهُمْ","في كُلِّ يَوْمٍ رِهَانٌ يُحْرِزُ القَصَبُ"],["إنَّ الفَوارِسَ مِنْ شَيْبَانَ قَدْ عُرِفُوا","بالصِّدْق إنْ نَزَلُوا والمَوْتِ إنْ رَكِبُوا"],["قُلْ للجَوادِ الَّذي يَسْعَى لِيُدْرِكَهُ","أقْصِرْ فَمَا لَكَ إلاَّ الفَوْتُ والطَّلَبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7_%D9%8A%D9%84%D9%85%D8%B9_%D8%A7%D9%84%D8%A8%D8%B1%D9%82_%D8%A5%D9%84%D8%A7_%D8%AD%D9%86_%D9%85%D8%BA%D8%AA%D8%B1%D8%A8"},"marwan-hafsa-0064":{"t":"نفحت مكافئا عن قبر معن","v":[["نَفَحْتَ مُكافِئاً عَنْ قَبْرِ مَعْنٍ","لَنَا مِمَّا تَجُودُ بِهِ سِجَالاَ"],["فَعَجَّلْتَ العَطِيَّة يا ابْنَ يَحْيَى","بِتَأْدِيَةٍ وَلَمْ تُرِدِ المِطَالاَ"],["فَكَافَأ عَنْ صَدَى مَعْنٍ جوادٌ","بأجْوَدِ رَاحَةٍ بَذَلَتْ نَوَالاَ"],["بَنَى لَكَ خَالِدٌ وأبُوكَ يَحْيَى","بِنَاءً في المَكارِمِ لَنْ يُنَالاَ"],["كأنَّ البَرْمَكِيَّ بِكُلِّ مَالٍ","تَجُودُ بِهِ يَداهُ يُفِيدُ مَالاَ"]],"src":"https://ar.wikisource.org/wiki/%D9%86%D9%81%D8%AD%D8%AA_%D9%85%D9%83%D8%A7%D9%81%D8%A6%D8%A7_%D8%B9%D9%86_%D9%82%D8%A8%D8%B1_%D9%85%D8%B9%D9%86"},"marwan-hafsa-0065":{"t":"نواضر غلبا قد تدانت رؤوسها","v":[["نَوَاضِرَ غُلْباً قَدْ تَدَانَتْ رُؤوسُها","مِنَ النَّبْتِ حَتَّى مَا يَطِيرُ غُرَابُها"],["ترى الباسقاتِ العمَّ فيها كأنها","ظَعائنُ مَضْرُوبٌ عليها قِبَابُها"],["ترىَ بابها سهلاً لكلَّ مدفع","إذا أينعتْ نخلٌ فأغلقَ بابها"],["يَكُونُ لَنَا مَا نَجْتَني مِنْ ثِمارهَا","رَبيعاً إذا الآفاقُ قَلَّ سَحَابُها"],["حظائرُ لمْ يخلطْ بأثمانها الربا","وَلَمْ يَكُ مِنْ أخْذِ الدِّيَاتِ اكْتِسَابها"],["ولكنْ عطاءُ اللهِ منْ كلَّ مدحةٍ","جزيلٌ منَ المستخلفينَ ثوابها"],["ومِنْ رَكْضِنَا الخَيْلَ في كُلِّ غَارَةٍ","حلالٌ بأرض المشركينَ نهابها"],["حَوَتْ غُنْمَها آباؤُنا وجُدُودُنا","بِصُّمِّ العَواليِ والدِّماءُ خِضَابُها"]],"src":"https://ar.wikisource.org/wiki/%D9%86%D9%88%D8%A7%D8%B6%D8%B1_%D8%BA%D9%84%D8%A8%D8%A7_%D9%82%D8%AF_%D8%AA%D8%AF%D8%A7%D9%86%D8%AA_%D8%B1%D8%A4%D9%88%D8%B3%D9%87%D8%A7"},"marwan-hafsa-0066":{"t":"هاجت هواك بواكر الأظعان","v":[["هَاجَتْ هَوَاكَ بَواكِرُ الأظْعَانِ","يَوْمَ اللِّوَى فَظَلِلْتَ ذَا أحْزَانِ"],["لَوْلاَ رَجَاؤُكَ مَا تَخَطَّتْ نَاقَتَي","عَرْضَ الدَّبِيلِ وَلاَ قُرَى نَجْرَانِ"],["نِعْمَ المُنَاخُ لِرَاغِبٍ وَلِرَاهِبٍ","مِمَّنْ تُصِيبُ جَوائِحُ الأزْمَانِ"],["مَعْنُ بنُ زَائِدَة الذِي زِيدتْ بِهِ","شرفاً على شرفٍ بنو شيبانَ"],["إنْ عُدَّ أيّامُ الفَعالِ فإنَّما","يوماهُ يومُ ندى ويومُ طعانِ"],["تمضي أسنتهُ ويسفرُ وجههُ","في الروعِ عندَ تغيرِ الألوانِ"],["يَكْسُو الأسِرَّةَ والمَنَابِرَ بِهْجَةً","ويزينها بجهارةٍ وبيانِ"],["كلْتَا يَدَيْكَ أبَا الوَلِيد مَعَ النَّدَى","خُلِقَت لِقَائم مُنْصُلٍ وَعِنَانِ"],["جَلَبَ الجِيادَ مِنَ العِرَاقِ عَوَابِساً","قُبَّ البُطونِ يُقَدْنَ بالأرْسَانِ"],["جُرْداً مُحَنَّبَةً تُعَاضِدُ في السُّرَى","بالبِيدِ كُلَّ شِمِلَّةٍ مِذْعَانِ"],["بالسَّيْفِ حَازَ هَجَائِنَ النُّعْمانِ","وقعُ القنا وأقبَّ كالسرحانِ"],["حَتَّى أغَرْنَ بِحَضْرموتَ شَوَازِباً","بالسيفِ ككواسرِ العقبانِ"],["نفسي فداءُ أبي الوليد إذا علاَ","رهجُ السنابكِ والرماحُ دواني"],["ما زلتَ يومَ الهاشمية معلماً","بالسّيْفِ دُونَ خَلِيفَةِ الرَّحْمانِ"],["فنمنعتَ حوزته وكنتَ وقاءهُ","مِنْ وَقْعِ كُلِّ مُهَنَّدٍ وِسِنَانِ"],["أنت الذي ترجو ربيعةُ سيبهُ","وتعدهُ لنوائبِ الحدثانِ"],["فُتَّ الذين رَجَوْا نَدَاكَ ولم يَنْلْ","أدْنَى بِنَائِكَ فِي المكارمِ باني"],["إني رأيتكَ بالمحمدِ مغرماً","تَبْتَاعُها بِرَغَائِبِ الأثْمانِ"],["فإذا صنعتَ صنبعةً أتممتها","وَرَبَبْتَها بِفَوائِدِ الإحْسَانِ"]],"src":"https://ar.wikisource.org/wiki/%D9%87%D8%A7%D8%AC%D8%AA_%D9%87%D9%88%D8%A7%D9%83_%D8%A8%D9%88%D8%A7%D9%83%D8%B1_%D8%A7%D9%84%D8%A3%D8%B8%D8%B9%D8%A7%D9%86"},"marwan-hafsa-0067":{"t":"همام إمام له قدرة","v":[["همامٌ إمامٌ لهُ قدرةٌ","تذلُّ الرقابُ لآياتها"],["فلاَ مجد في الأرضِ لمْ يبنهِ","وَلا غَايَةً فِيهِ لَمْ يَأْتِهَا"],["لهُ إنْ رأى سائلاً يجتدبهِ","نفسٌ تجودُ بأقواتها"],["ويكسرُ في الحربِ أسيافهُ","لِيَكْفِيَ مُعْظَمَ آفاتِهَا"],["وَيَنْحرُ في المَحْلِ للطَّارِقينَ","كومَ المطايا بفضلاتها"]],"src":"https://ar.wikisource.org/wiki/%D9%87%D9%85%D8%A7%D9%85_%D8%A5%D9%85%D8%A7%D9%85_%D9%84%D9%87_%D9%82%D8%AF%D8%B1%D8%A9"},"marwan-hafsa-0068":{"t":"وأكرم قبر بعد قبر محمد","v":[["وأكرمُ قبرٍ بعدَ قبرِ محمدٍ","نَبِيِّ الْهُدَى قَبْرٌ بِمَاسَبَذَانِ"],["عَجبْتُ لِكَفٍّ هَالَتِ التُّرْبَ فَوْقهُ","ضحاً كيفَ لمْ ترجعْ بغيرِ بنانِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A3%D9%83%D8%B1%D9%85_%D9%82%D8%A8%D8%B1_%D8%A8%D8%B9%D8%AF_%D9%82%D8%A8%D8%B1_%D9%85%D8%AD%D9%85%D8%AF"},"marwan-hafsa-0069":{"t":"وفكت بك الأسرى التي شيدت لها","v":[["وَفُكَّتْ بِكَ الأسْرَى التي شُيِّدَتْ لَها","مَحَابِسُ ما فيها حَمِيمٌ يَزُورُها"],["عَلى حِينَ أعَيا المسلمينَ فِكَاكُها","وقالوا سجونُ المشركين كبنَ قبورها"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%81%D9%83%D8%AA_%D8%A8%D9%83_%D8%A7%D9%84%D8%A3%D8%B3%D8%B1%D9%89_%D8%A7%D9%84%D8%AA%D9%8A_%D8%B4%D9%8A%D8%AF%D8%AA_%D9%84%D9%87%D8%A7"},"marwan-hafsa-0070":{"t":"وقالوا: الطالقان يجن كنزا","v":[["وَقَالُوا: الطَّالِقَانُ يُجِنُّ كَنْزاً","سيأتينا بهِ الدهرُ المديلُ"],["فأقتلَ مكدياً لهمُ بيحيى","وكَنْزُ الطَّالِقانِ لَهُ زَمِيلُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%82%D8%A7%D9%84%D9%88%D8%A7%3A_%D8%A7%D9%84%D8%B7%D8%A7%D9%84%D9%82%D8%A7%D9%86_%D9%8A%D8%AC%D9%86_%D9%83%D9%86%D8%B2%D8%A7"},"marwan-hafsa-0071":{"t":"وما خلقت إلا لبذل أكفهم","v":[["وَمَا خُلِقَتْ إلاَّ لِبَذْلٍ أكُفُّهُمْ","وألسنهمْ إلا لتحبيرِ منطقِ"],["فَيَوْماً يُباروُنَ الرِّياحَ سَماحَةً","وَيَوْماً لِبَذْلِ الخَاطِبِ المُتشَدِّقِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%A7_%D8%AE%D9%84%D9%82%D8%AA_%D8%A5%D9%84%D8%A7_%D9%84%D8%A8%D8%B0%D9%84_%D8%A3%D9%83%D9%81%D9%87%D9%85"},"marwan-hafsa-0072":{"t":"وما فعلت بنو مروان خيرا","v":[["وما فعلت بنو مروان خيرا","ولا فعلت بنو مروان شرا"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%A7_%D9%81%D8%B9%D9%84%D8%AA_%D8%A8%D9%86%D9%88_%D9%85%D8%B1%D9%88%D8%A7%D9%86_%D8%AE%D9%8A%D8%B1%D8%A7"},"marwan-hafsa-0073":{"t":"ويوم عسول الآل حام كإنما","v":[["ويوم عسولِ الآل حامٍ كإنما","لَظَى شَمْسِهِ مَشْبُوبُ نَارٍ تَلَهَّبُ"],["نصبنا لهُ منا الوجوهَ وكنها","عصائبُ أشمالٍ بها نتعصبُ"],["إلى المجتدى معن تخطتْ ركابنا","تنائفَ فيما بينها الريح تلغبُ"],["كأنَّ دَلِيلَ القَوْمِ بَيْنَ سُهُوبِهَا","طريدُ دمٍ منْ خشيةِ الموتِ يهربُ"],["بَدَأْنَا عَلَيْهَا وهيَ ذَاتُ عَجارِفٍ","تَقَاذَفُ صُعْراً في البُرَى حِينَ تُجْذَبُ"],["فما بلغتْ صنعاءَ حتى تبدلتْ","حُلوماً وَقَدْ كانَتْ مِنَ الجَهْلِ تَشْغَبُ"],["إلى بابِ معنٍ ينتهي كلُّ راغبٍ","يُرَجِّي النَّدى أوْ خَائِفٍ يَتَرَقَّبُ"],["جَرَى سَابِقاً مَعْنُ بنُ زَائِدَةَ الذي","به يفخرُ الحيانِ بكر وتغلبُ"],["فبرز حتى ما يجارى وإنما","إلى عرقهَ ينمى الجوادُ وينسبُ"],["محالفُ صولاتٍ تمتُ ونائلٍ","يَرِيشُ فَما يَنْفَكُّ يُرْجَى ويُرْهَبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%8A%D9%88%D9%85_%D8%B9%D8%B3%D9%88%D9%84_%D8%A7%D9%84%D8%A2%D9%84_%D8%AD%D8%A7%D9%85_%D9%83%D8%A5%D9%86%D9%85%D8%A7"},"marwan-hafsa-0074":{"t":"يا أكرم الناس من عرب ومن عجم","v":[["يا أكْرَمَ النَّاسِ مِنْ عُرْبٍ وَمِنْ عَجَم","بَعْدَ الخَلِيفةِ يا ضرْغَامَةَ العَرَبِ"],["أفنيتَ ما لكَ تعطيهِ وتنهبهُ","يا آفةَ الفضةِ البيضاءِ والذهبِ"],["إن السَّنَانَ وحَدَّ السَّيْفِ لَوْ نَطَقَا","لأخبراَ عنكَ في الهيجاءِ بالعجبِ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%A3%D9%83%D8%B1%D9%85_%D8%A7%D9%84%D9%86%D8%A7%D8%B3_%D9%85%D9%86_%D8%B9%D8%B1%D8%A8_%D9%88%D9%85%D9%86_%D8%B9%D8%AC%D9%85"},"marwan-hafsa-0076":{"t":"يا من يمطلع شمس ثم مغربها","v":[["يا منْ يمطلعِ شمسٍ ثمّ مغربها","إنَّ السَّخَاءَ عليكُمْ غَيْرُ مَرْدُودِ"],["قلْ للعفاةِ أريحوا العيسَ منْ طلبٍ","ما بَعْدَ مَعْنِ حَلِيفِ الجُودِ مِنْ جُودِ"],["قلْ للمنيةِ لا تيقي على أحدٍ","إذْ مَاتَ مَعْنٌ فَما مَيْتٌ بِمَفْقُودِ"],["فَابْكُوا السَّخاء