{"poet":{"id":"mutalammis","short":"المتلمس","name":"المتلمس الضبعي (جرير بن عبد المسيح)","en":"Al-Mutalammis","era":"pre-islamic"},"poems":{"mutalammis-0001":{"t":"أبلغ ضبيعة كهلها ووليدها","v":[["أَبلِغ ضُبيعَةَ كَهلَها وَوَليدَها","وَالحَربُ تَنبو بِالرِجالِ وَتَضرِسُ"],["القَومُ آتُوكُم بِأَرعَنَ جَحفَلٍ","حَنِقينَ إِلاّ تَفرِسوهُم تُفرَسوا"],["خَيرٌ مِنَ القَومِ العُصاةِ أَميرَهُم","يا قومِ فَاِستَحيوا النِساءُ الجُلَّسُ"],["ما إِن أزَالُ أَذُبُّ عَنكُم كاشِحاً","قَد كادَ مِن حَنَقٍ بِسَمٍّ يَقلِسُ"],["أَتقَولُ هُم مَنَعوا حَنيفَةَ حَقَّهُم","بَعدَ الكَفالَةِ وَالتَوَثُّقِ أَم نَسوا"],["لَم يَعلَموا أَن قَد مَشى حَذَرَ الخَزى","بِالسَيفِ لِلمَوتِ اِبنُ بَدرَةَ بَيهَسُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%A8%D9%84%D8%BA_%D8%B6%D8%A8%D9%8A%D8%B9%D8%A9_%D9%83%D9%87%D9%84%D9%87%D8%A7_%D9%88%D9%88%D9%84%D9%8A%D8%AF%D9%87%D8%A7"},"mutalammis-0003":{"t":"إذا جاوزت من ذات عرق ثنية","v":[["إِذا جاوَزَت مِن ذاتِ عِرقٍ ثِنَّيةً","فقُل لأبي قابوسَ ما شِئتَ فارعُدِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D8%AC%D8%A7%D9%88%D8%B2%D8%AA_%D9%85%D9%86_%D8%B0%D8%A7%D8%AA_%D8%B9%D8%B1%D9%82_%D8%AB%D9%86%D9%8A%D8%A9"},"mutalammis-0004":{"t":"أعاذل إن المرء رهن مصيبة","v":[["أَعاذِلُ إِنَّ المَرءَ رَهنُ مُصيبَةٍ","صَريعٌ لِعافي الطَيرِ أَو سوفَ يُرمَسُ"],["فَلا تَقبَلَن ضَيماً مَخافَةَ ميتَةٍ","وَموتَن بِها حُرّاً وَجِلدُكَ أَملَسُ"],["فَما الناسُ إِلاّ ما رَأَوا وَتَحَدَّثوا","وَما العَجزُ إِلا أَن يُضاموا فَيَجلِسُوا"],["أَلَم تَرَ أَنَّ الجونَ أصبحَ راسِياً","تُطيفُ بِهِ الأَيامُ ما يَتَأَيَّسُ"],["عَصى تُبَّعاً أَيّامَ أُهلِكَتِ القُرى","يُطانُ عَلى صُمِّ الصَفِحِ وَيُكلَسُ"],["هَلُمَّ إِلَيها قَد أُثيرَت زُروعُها","وَعادَت عَليها المَنجَنونُ تَكَدَّسُ"],["وَذاكَ أَوانُ العِرضِ حَيَّ ذُبابُهُ","زَنابيرُهُ وَالأَزرَقُ المُتَلَمِّسُ"],["فَإِن يُقبِلوا بِالوُدِّ نُقبِل بِمِثلِهِ","وَإِلاّ فَإِنّا نَحنُ آبى وَأشمَسُ"],["وَجَمعُ بَني قُرّانَ فَاِعرِض عَلَيهِمِ","فَإِن يَقبَلوا هاتا الَّتي نَحنُ نُوبَسُ"],["يَكونُ نَذيرٌ مِن وَرائِيَ جُنَّةً","وَيَمنَعُني مِنهُم جُلَيٌّ وَأَحمَسُ"],["فَإِن يَكُ عَنّا في حُبَيبٍ تَثاقُلٌ","فَقد كانَ فينا مِقنَبٌ ما يُعَرِّسُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B9%D8%A7%D8%B0%D9%84_%D8%A5%D9%86_%D8%A7%D9%84%D9%85%D8%B1%D8%A1_%D8%B1%D9%87%D9%86_%D9%85%D8%B5%D9%8A%D8%A8%D8%A9"},"mutalammis-0005":{"t":"ألا أبلغا أفناء سعد بن مالك","v":[["أَلا أَبلِغا أَفناءَ سَعدِ بنِ مالِكٍ","رِسالَةَ مَن قَد صارَ في الغُربِ جانِبُه"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D8%A3%D8%A8%D9%84%D8%BA%D8%A7_%D8%A3%D9%81%D9%86%D8%A7%D8%A1_%D8%B3%D8%B9%D8%AF_%D8%A8%D9%86_%D9%85%D8%A7%D9%84%D9%83"},"mutalammis-0007":{"t":"إلى كل قوم سلم يرتقى به","v":[["إِلى كُلِّ قَومٍ سُلَّمٌ يُرتَقَى بِهِ","وَلَيسَ إِلَينا في السَلاليمِ مَطلَعُ"],["وَيَهرُبُ مِنّا كُلُّ وَحشٍ وَيَنتَهي","إِلى وَحشِنا وَحشُ الفَلاةِ وَيَرتَعُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%84%D9%89_%D9%83%D9%84_%D9%82%D9%88%D9%85_%D8%B3%D9%84%D9%85_%D9%8A%D8%B1%D8%AA%D9%82%D9%89_%D8%A8%D9%87"},"mutalammis-0009":{"t":"إن الهوان حمار القوم يعرفه","v":[["إِنَّ الهَوانَ حِمارُ القَومِ يَعرِفُهُ","والحُرُّ يُنكِرُهُ والرَّسلَةُ الأُجُدُ"],["كونوا كَبَكرٍ كَما قَد كانَ أَوَّلُكُم","وَلا تَكونوا كَعَبدِ القَيسِ إِذ قَعَدوا"],["يُعطونَ ما سُئِلوا وَالخَطُّ مَنزِلُهُم","كَما أَكَبَّ عَلى ذِي بَطنِهِ الفَهَدُ"],["وَلَن يُقيمَ عَلى خَسفٍ يُسامُ بِهِ","إِلاّ الأَذَلاّنِ عَيرُ الأَهلِ وَالوَتِدُ"],["هَذا عَلى الخَسفِ مَربوطٌ بِرُمَّتهِ","وَذا يُشَجُّ فما يَرثي لَهُ أَحَدُ"],["فَإِن أَقَمتُم عَلى ضَيمٍ يُرادُ بِكُم","فَإِنَّ رَحلي لَكُم وَالٍ وَمُعتَمَدُ"],["كونوا كَسامَةَ إِذا شَعفٌ مَنازِلُهُ","إِذ قِيلَ جَيشٌ وَجَيشٌ حافِظٌ رَصَدُ"],["شَدَّ المَطيَّةَ بِالأَنساعِ فَاِنحَرَفَت","عُرضَ التَنوفَةِ حَتّى مَسَّها النَجَدُ"],["وَفي البِلادِ إِذا ما خِفتَ نائِرَةً","مَشهورَةً عَن وُلاةِ السَوءِ مُبتَعَدُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86_%D8%A7%D9%84%D9%87%D9%88%D8%A7%D9%86_%D8%AD%D9%85%D8%A7%D8%B1_%D8%A7%D9%84%D9%82%D9%88%D9%85_%D9%8A%D8%B9%D8%B1%D9%81%D9%87"},"mutalammis-0011":{"t":"أنت مثبور غوي مترف","v":[["أَنتَ مَثبورٌ غَوِيٌ مُترَفٌ","ذو غَواياتٍ وَمَسرورٌ بَطِرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%86%D8%AA_%D9%85%D8%AB%D8%A8%D9%88%D8%B1_%D8%BA%D9%88%D9%8A_%D9%85%D8%AA%D8%B1%D9%81"},"mutalammis-0012":{"t":"إني كساني أبو قابوس مرفلة","v":[["إِنّي كَساني أَبو قابوسَ مُرفَلَةً","كَأَنَّها سَلخُ أَبكارِ المَخارِيطِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86%D9%8A_%D9%83%D8%B3%D8%A7%D9%86%D9%8A_%D8%A3%D8%A8%D9%88_%D9%82%D8%A7%D8%A8%D9%88%D8%B3_%D9%85%D8%B1%D9%81%D9%84%D8%A9"},"mutalammis-0013":{"t":"إني لقطاع اللبانة والهوى","v":[["إِنّي لَقَطّاعُ اللُبانَةِ وَالهَوى","إِذا ما حِبالُ الغانِياتِ تَلَبَّسُ"],["وَأَدماءَ مِن حُرِّ الهِجانِ كَأَنَّها","بِحُرِّ الصَريمِ نابِىءٌ مُتَوَجِّسُ"],["لَهُ جُدَدٌ سودٌ كَأَنَّ أَرَندَجاً","بِأَكرُعِهِ وَبِالذِراعَينِ سُندُسُ"],["وَبِالوَجهِ دِيباجٌ وَفَوقَ سَراتِهِ","دَيابوذَةٌ وَالرَوقُ أَسحَمُ أَملَسُ"],["يَجولُ بِذي الأَرطى كَأَنَّ سَراتَهُ","كَبَرقٍ نَزيعٍ وَالسَحابَةُ تَرجُسُ"],["فَباتَ إِلى أَرطاةِ حِقفٍ كَأَنَّما","إِلى دَفِّها مِن آخِرِ اللَيلِ مُعرِسُ"],["إِلى رَبِّها قَيسٍ تَروحُ وَتَغتَدي","فَلا فَرِحٌ قَيسٌ وَلا مُتَعَبِّسُ"],["تَناوَلَني مِن أَرضِهِ وَسَمائِهِ","بِرَحبِ ذِراعٍ ماجِدٌ مُتَأَنِّسُ"],["إِذا بَلَغَت قَيسَ اليَمانِيَّ ناقَتي","فَأَيَّ خَليلٍ بَعدَ قَيسٍ تَلَمَّسُ"],["لَعَمري لَنِعمَ المَرءُ قَيسٌ إِذا اِنتَهى","إِلى بابِهِ راجٍ لَهُ لَيسَ يَحبِسُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86%D9%8A_%D9%84%D9%82%D8%B7%D8%A7%D8%B9_%D8%A7%D9%84%D9%84%D8%A8%D8%A7%D9%86%D8%A9_%D9%88%D8%A7%D9%84%D9%87%D9%88%D9%89"},"mutalammis-0014":{"t":"أيها السائلي فإني غريب","v":[["أَيُّها السَائلي فَإِنّي غَريبٌ","نازِحٌ عَن مَحَلَّتي وَصَمِيمي"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%8A%D9%87%D8%A7_%D8%A7%D9%84%D8%B3%D8%A7%D8%A6%D9%84%D9%8A_%D9%81%D8%A5%D9%86%D9%8A_%D8%BA%D8%B1%D9%8A%D8%A8"},"mutalammis-0015":{"t":"تعيرني سلمى وليس بقضأة","v":[["تُعَيِّرُني سَلمى وَلَيسَ بِقُضأَةٍ","وَلو كُنتَ مِن سَلمى تَفَرَّعتَ دارِما"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%B9%D9%8A%D8%B1%D9%86%D9%8A_%D8%B3%D9%84%D9%85%D9%89_%D9%88%D9%84%D9%8A%D8%B3_%D8%A8%D9%82%D8%B6%D8%A3%D8%A9"},"mutalammis-0016":{"t":"تفرق أهلي من مقيم وظاعن","v":[["تَفَرَّقَ أَهلي مِن مُقيمٍ وَظاعِنٍ","فَلِلَّهِ دَرّي أَيَّ أَهلِيَ أَتبَعُ"],["أَقامَ الَّذينَ لا أُبالي فِراقَهُم","وَشَطَّ الَّذينَ بَينَهُم أَتَوقَّعُ"],["عَلى كُلِّهِم آسَى وَلِلأَصلِ زُلفَةٌ","فَزَحزِح عَنِ الأَدنَينَ أَن يَتَصَدَّعوا"],["وَفارَقَ أَهلي أَهلَ عَوفِ بنِ عامرٍ","وَكانَت خَوى عَوفٍ قَديماَ تَطَلَّعُ"],["قَضَى اِبنُ مُعاذٍ مَرَّةً دونَ قَومهِ","بِعَيبٍ وَأَمري ما يَكادُ يُجَمَّعُ"],["أَلِكني إِلى قَومي ضُبَيعَةَ إِنَّهُم","أُناسي فَلومُوا بَعدَ ذَلِكَ أَو دَعُوا"],["وَقَد كانَ أَخوالي كَريماً جِوارُهُم","وَلَكِنَّ أَصلَ العودِ مِن حَيثُ يُنزَعُ"],["فَلا تَحسِبَنّي خاذِلاً مُتَخَلِّفاً","وَلا عَينُ صَيدٍ مِن هَوايَ وَلَعلَعُ"],["وَلَكِنَّني أَغرَبتُ في جَيشِ طَوَّسٍ","وَكَانَت مَعَدٌّ كُلَّ أَوبٍ تَصَدَّعُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D9%81%D8%B1%D9%82_%D8%A3%D9%87%D9%84%D9%8A_%D9%85%D9%86_%D9%85%D9%82%D9%8A%D9%85_%D9%88%D8%B8%D8%A7%D8%B9%D9%86"},"mutalammis-0019":{"t":"سر قد أنى لك أيها المتحوس","v":[["سِر قَد أَنَى لَكَ أَيُّها المُتَحَوِّسُ","فالدارُ قَد كادَت لِعَهدِكَ تُدرَسُ"]],"src":"https://ar.wikisource.org/wiki/%D8%B3%D8%B1_%D9%82%D8%AF_%D8%A3%D9%86%D9%89_%D9%84%D9%83_%D8%A3%D9%8A%D9%87%D8%A7_%D8%A7%D9%84%D9%85%D8%AA%D8%AD%D9%88%D8%B3"},"mutalammis-0020":{"t":"صبا من بعد سلوته فؤادي","v":[["صَبا مِن بَعدِ سَلوَتِه فُؤادي","وأَسمَحَ لِلقَرينَةِ بِاِنقيادِ"],["كَأَنّي شارِبٌ يَومَ اِستَبَدُّوا","وَحَثَّ بِهِم لَدَى المَوماةِ حادِ"],["عُقاراً عُتِّقَت في الدَنِّ حَتّى","كَأَنَّ حَبابَها حَدَقُ الجَرادِ"],["جَمادِ لَها جَمادِ وَلا تَقولي","لَها أَبَداً إِذا ذُكِرَت حَمادِ"],["فَإِمّا حُبُّها عَرَضاً وَإِمّا","بَشاشَةُ كُلِّ عِلقٍٍ مُستَفادِ"],["وَأَعلَمُ عِلمَ حَقٍّ غَيرَ ظَنٍّ","وَتَقوى اللَهِ مِن خَيرِ العَتادِ"],["لَحِفظُ المالِ أيسَرُ مِن بُغاهُ","وَسَيرٍ في البِلادِ بِغَيرِ زادِ"],["وَإِصلاحُ القَليلِ يَزيدُ فيهِ","وَلا يَبقَى الكَثيرُ مَعَ الفَسادِ"]],"src":"https://ar.wikisource.org/wiki/%D8%B5%D8%A8%D8%A7_%D9%85%D9%86_%D8%A8%D8%B9%D8%AF_%D8%B3%D9%84%D9%88%D8%AA%D9%87_%D9%81%D8%A4%D8%A7%D8%AF%D9%8A"},"mutalammis-0021":{"t":"عرفت لأصحاب النجائب حدة","v":[["عَرَفتُ لأَِصحابِ النَجائِبِ حِدَّةً","إِذا عَرفوا لي في العُصورِ الأَوائِلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%B9%D8%B1%D9%81%D8%AA_%D9%84%D8%A3%D8%B5%D8%AD%D8%A7%D8%A8_%D8%A7%D9%84%D9%86%D8%AC%D8%A7%D8%A6%D8%A8_%D8%AD%D8%AF%D8%A9"},"mutalammis-0022":{"t":"عصاني فما لاقى الرشاد وإنما","v":[["عَصاني فَما لاقَى الرَشادَ وَإِنَّما","تَبَيَّنَ مِن أَمرِ الغَوِيِّ عَواقِبُه"],["فَأَصبَحَ مَحمولاً عَلى ظَهرِ أَلَّةٍ","يَمُجُّ نَجِيعَ الجَوفِ مِنهُ تَرائِبُه"],["فَإِلاّ تَجلَّلَها يُعالوكَ فَوقَها","وَكيفَ تَوَقَّى ظَهرَ ما أَنتَ راكِبُه"]],"src":"https://ar.wikisource.org/wiki/%D8%B9%D8%B5%D8%A7%D9%86%D9%8A_%D9%81%D9%85%D8%A7_%D9%84%D8%A7%D9%82%D9%89_%D8%A7%D9%84%D8%B1%D8%B4%D8%A7%D8%AF_%D9%88%D8%A5%D9%86%D9%85%D8%A7"},"mutalammis-0023":{"t":"فاجتاب أرطاة فلاذ بدفئها","v":[["فَاِجتَابَ أَرطاةً فَلاذَ بِدِفئِها","والعَينُ بِالجَونِ المِثالِيَ تَرجُسُ"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D8%A7%D8%AC%D8%AA%D8%A7%D8%A8_%D8%A3%D8%B1%D8%B7%D8%A7%D8%A9_%D9%81%D9%84%D8%A7%D8%B0_%D8%A8%D8%AF%D9%81%D8%A6%D9%87%D8%A7"},"mutalammis-0026":{"t":"فلو أن محموما بخيبر مدنفا","v":[["فَلَو أَنَّ مَحموماً بِخَيبَرَ مُدنَفاً","تَنَشَّقَ رَيّاها لَأَقلَعَ صالِبُه"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D9%84%D9%88_%D8%A3%D9%86_%D9%85%D8%AD%D9%85%D9%88%D9%85%D8%A7_%D8%A8%D8%AE%D9%8A%D8%A8%D8%B1_%D9%85%D8%AF%D9%86%D9%81%D8%A7"},"mutalammis-0027":{"t":"قلت لقومي حين جاء ابن مالك","v":[["قُلتُ لِقَومي حينَ جاءَ اِبنُ مالِكٍ","خُذوا حَقَّكُم مِن عُجبِها المُتَقَسَّمِ"],["وَإِنّي لَأَحميها وَأُعطي رِقابَها","وَأَمنَعُها وَالخَيلُ تَعثُرُ بِالدَمِ"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D9%84%D8%AA_%D9%84%D9%82%D9%88%D9%85%D9%8A_%D8%AD%D9%8A%D9%86_%D8%AC%D8%A7%D8%A1_%D8%A7%D8%A8%D9%86_%D9%85%D8%A7%D9%84%D9%83"},"mutalammis-0028":{"t":"قليتك فاقليني فلا وصل بيننا","v":[["قَلَيتُكِ فَاِقلِيني فَلا وَصلَ بَينَنا","كَذَلِكَ مَن يَستَغنِ يَستَغنِ صاحِبُه"],["خَليلٌ بَدا لي النُّصحُ مِنهُ فَلَم أَكُن","لِأَصرِمَهُ ما سَوَّغَ الماءَ شارِبُه"],["عَصاني فَما لاقى الرَشادَ وَإِنَّما","تَبَيَّنُ عَن أَمرِ الغَوِيِّ عَواقِبُه"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D9%84%D9%8A%D8%AA%D9%83_%D9%81%D8%A7%D9%82%D9%84%D9%8A%D9%86%D9%8A_%D9%81%D9%84%D8%A7_%D9%88%D8%B5%D9%84_%D8%A8%D9%8A%D9%86%D9%86%D8%A7"},"mutalammis-0029":{"t":"كأنما لونها والصبح منقشع","v":[["كَأَنَّما لَونُها وَالصُبحُ مُنقَشِعٌ","قَبلَ الغَزالَةِ أَلوانُ الحَماطيطِ"]],"src":"https://ar.wikisource.org/wiki/%D9%83%D8%A3%D9%86%D9%85%D8%A7_%D9%84%D9%88%D9%86%D9%87%D8%A7_%D9%88%D8%A7%D9%84%D8%B5%D8%A8%D8%AD_%D9%85%D9%86%D9%82%D8%B4%D8%B9"},"mutalammis-0030":{"t":"لسنا كمن حلت إياد دارها","v":[["لَسنا كَمَن حَلَّت إيادٌ دارَها","تَكريتَ تَنظُرُ حَبَّها أَن يُحصَدا"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%B3%D9%86%D8%A7_%D9%83%D9%85%D9%86_%D8%AD%D9%84%D8%AA_%D8%A5%D9%8A%D8%A7%D8%AF_%D8%AF%D8%A7%D8%B1%D9%87%D8%A7"},"mutalammis-0031":{"t":"لعلك يوما أن يسرك أنني","v":[["لَعلَّكَ يَوماً أَن يَسُرَّكَ أَنَّني","شَهِدتُ وَقد رَمَّت عِظاميَ في قَبري"],["فتُصبِحُ مَظلوماً تُسامُ دَنِيَّةً","حَريصاً عَلى مِثلي فَقيراً إِلى نَصري"],["وَيَهجُرُكَ الإِخوانُ بَعدي وَتُبتَلى","وَيَنصُرُني مِنكَ المَليكُ فَلا تَدرِي"],["وَلَو كُنتُ حَيّاً قَبلَ ذَلِكَ لَم تُرَم","لَهُ خُطَّةٌ خَسفاً وَشووِرتَ في الأَمرِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%B9%D9%84%D9%83_%D9%8A%D9%88%D9%85%D8%A7_%D8%A3%D9%86_%D9%8A%D8%B3%D8%B1%D9%83_%D8%A3%D9%86%D9%86%D9%8A"},"mutalammis-0032":{"t":"لكنه حوض من أودى بإخوته","v":[["لَكِنَّهُ حَوضُ مَن أَودَى بِإِخوَتِهِ","رَيبُ المَنُونِ فَأَضحَى بَيضَةَ البَلَدِ"],["لَو كانَ يُشكى إلى الأَمواتِ ما لَقِيَ ال","أَحياءُ بَعدَهُمُ مِن شِدَّةِ الكَمَدِ"],["ثُمَّ اِشتَكَيتُ لَأَشكاني وَساكِنُهُ","قَبرٌ بِسِنجارَ أَو قَبرٌ عَلى قَهَدِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%83%D9%86%D9%87_%D8%AD%D9%88%D8%B6_%D9%85%D9%86_%D8%A3%D9%88%D8%AF%D9%89_%D8%A8%D8%A5%D8%AE%D9%88%D8%AA%D9%87"},"mutalammis-0033":{"t":"لم يرجعوا من خشية الموت والردى","v":[["لَم يَرجِعوا مِن خَشيَةِ المَوتِ وَالرَّدى","وَقَد جَلَبَتها مِن بَعيدٍ جَوالِبُ"],["سَيَمنَعُها مِن أَن تَرُدَّ حَفيظَةً","فَوارِسُ صَعبٍ وَالكُماةُ مُحَارِبُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%85_%D9%8A%D8%B1%D8%AC%D8%B9%D9%88%D8%A7_%D9%85%D9%86_%D8%AE%D8%B4%D9%8A%D8%A9_%D8%A7%D9%84%D9%85%D9%88%D8%AA_%D9%88%D8%A7%D9%84%D8%B1%D8%AF%D9%89"},"mutalammis-0034":{"t":"محبوكة حبكت منها نمانمها","v":[["مَحبوكَةً حُبِكَت مِنها نَمانِمُها","مِنَ المُدَمقَسِ أَو مِن فاخِرِ الطُوطِ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%AD%D8%A8%D9%88%D9%83%D8%A9_%D8%AD%D8%A8%D9%83%D8%AA_%D9%85%D9%86%D9%87%D8%A7_%D9%86%D9%85%D8%A7%D9%86%D9%85%D9%87%D8%A7"},"mutalammis-0037":{"t":"وألقيتها في الثني من جنب كافر","v":[["وَأَلقَيتُها في الثِنيِ مِن جَنبِ كافِرٍ","كَذلِكَ أَقنو كُلَّ قِطٍّ مُضَلِّلِ"],["رَمَيتُ بِها حَتّى رَأيتُ مِدادَها","يَطوفُ بِها التَيّارُ في كُلِّ جَدوَلِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A3%D9%84%D9%82%D9%8A%D8%AA%D9%87%D8%A7_%D9%81%D9%8A_%D8%A7%D9%84%D8%AB%D9%86%D9%8A_%D9%85%D9%86_%D8%AC%D9%86%D8%A8_%D9%83%D8%A7%D9%81%D8%B1"},"mutalammis-0038":{"t":"وعليه من لأم الكتائب لأمة","v":[["وَعَليهِ مِن لَأمِ الكَتائِبِ لَأمَةٌ","فَضفاضَةٌ فيما يَقومُ وَيَجلِسُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%B9%D9%84%D9%8A%D9%87_%D9%85%D9%86_%D9%84%D8%A3%D9%85_%D8%A7%D9%84%D9%83%D8%AA%D8%A7%D8%A6%D8%A8_%D9%84%D8%A3%D9%85%D8%A9"},"mutalammis-0041":{"t":"ومن يبغ أو يسعى على الناس ظالما","v":[["وَمَن يَبغِ أَو يَسعى عَلى الناسِ ظالِماً","يَقَع غَيرَ شَكٍّ لِليَدينِ وَلِلفَمِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D9%86_%D9%8A%D8%A8%D8%BA_%D8%A3%D9%88_%D9%8A%D8%B3%D8%B9%D9%89_%D8%B9%D9%84%D9%89_%D8%A7%D9%84%D9%86%D8%A7%D8%B3_%D8%B8%D8%A7%D9%84%D9%85%D8%A7"},"mutalammis-0042":{"t":"يا آل بكر ألا لله أمكم","v":[["يا آلَ بَكرٍ أَلا لِلَّهِ أُمُّكُمُ","طالَ الثَواءُ وَثَوبُ العَجزِ مَلبُوسُ"],["أَغنَيتُ شَأني فَأَغنوا اليَومَ شَأنَكُمُ","وَاِستَحمِقوا في مِراسِ الحَربِ أَو كيسوا"],["إِنَّ عِلافاً وَمَن بِاللَوذِ مِن حَضَنٍ","لَمّا رَأَوا أنَّهُ دينٌ خَلابيسُ"],["شَدُّوا الجِمالَ بِأَكوارٍ عَلى عَجَلٍ","والظُلمُ يُنكِرُهُ القَومُ المَكاييسُ"],["كانوا كَسامَةَ إِذ شَعفٌ مَنازِلُهُ","ثُمَّ اِستَمَرَّت بِهِ البُزلُ القَناعِيسُ"],["حَنَّت قَلوصِي بِها وَاللَيلُ مُطَّرِقٌ","بَعدَ الهُدُوِّ وَشاقَتها النَواقيسُ"],["مَعقولَةٌ يَنظُرُ التَشريقَ راكِبُها","كَأَنَّها مِن هَوىً لِلرَّملِ مَسلوسُ"],["وَقد أَلاحَ سُهَيلٌ بَعدَما هَجَعوا","كَأَنَّه ضَرَمٌ بِالكَفِّ مَقبوسُ"],["أَنَّى طَرِبتِ وَلَم تُلحَي عَلى طَرَبٍ","وَدونَ إِلفِكِ أَمراتٌ أَماليسُ"],["حَنَّت إِلى نَخلَةَ القُصوى فَقُلتُ لَها","بَسلٌ عَليكِ أَلا تِلكَ الدَهاريسُ"],["أُمّي شَآمِيَّةً إِذ لا عِراقَ لَنا","قَوماً نَوَدُّهُمُ إِذ قَومُنا شُوسُ"],["لَن تَسلُكي سُبُلَ البَوباةِ مُنجِدَةً","ما عاشَ عَمرٌو وَما عُمِّرتَ قابوسُ"],["لَو كانَ مِن آلِ وَهبٍ بَينَنا عُصَبٌ","وَمِن نَذيرٍ وَمِن عَوفٍ مَحاميسُ"],["أَودى بِهِم مَن يُراديني وَأَعلَمُهُم","جُودَ الأَكُفِّ إِذا ما اِستَعسَرَ البوسُ"],["يا حارِ إني لَمِن قَومٍ أولي حَسَبٍ","لا يَجهلون إِذا طاشَ الضَغابِيسُ"],["آلَيتَ حَبَّ العِراقِ الدَهرَ أَطعَمُهُ","وَالحَبُّ يَأكلُهُ في القَريَةِ السوسُ"],["لَم تَدرِ بُصرى بِما آلَيتَ مِن قَسَمٍ","وَلا دِمَشقُ إِذا ديسَ الكَداديسُ"],["عَيَّرتُموني بِلا ذَنبٍ جِوارَكُمُ","هَذا نَصيبٌ مِنَ الجِيرانِ مَحسوسُ"],["فَإِن تَبَدَّلتُ مِن قَومي عَدِيَّكُمُ","إِنِّي إِذاً لَضَعيفُ الرَأيِ مَألوسُ"],["كَم دونَ أَسماءَ مِن مُستَعمَلٍ قَذَفٍ","وَمِن فَلاةٍ بِها تُستَودَعُ العيسُ"],["وَمِن ذُرَى عَلَمٍ ناءٍ مَسافَتُهُ","كَأنَّهُ في حَبابِ الماءِ مَغموسُ"],["جاوَزتُهُ بِأَمُونٍ ذاتِ مَعجَمَةٍ","تَنجو بِكَلكَلِها وَالرَأسُ مَعكوسُ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%A2%D9%84_%D8%A8%D9%83%D8%B1_%D8%A3%D9%84%D8%A7_%D9%84%D9%84%D9%87_%D8%A3%D9%85%D9%83%D9%85"},"mutalammis-0043":{"t":"يعيرني أمي رجال ولا أرى","v":[["يُعيِّرُني أمِّي رِجالٌ ولا أَرى","أَخا كَرَمٍ إلِاّ بِأَن يَتَكَرَّما"],["وَمَن كانَ ذا عِرضٍ كَريمٍ فَلم يَصُن","لَهُ حَسَباً كانَ اللَئيمَ المُذَمَّما"],["أَحارِثُ إِنّا لَو تُشاطُ دِماؤُنا","تَزَيَّلنَ حَتّى لا يَمَسَّ دَمٌ دَما"],["أَمُنتَقِلاً مِن آلِ بُهثَةَ خِلتَني","أَلا إِنَّني مِنهُم وَإِن كُنتُ أَينَما"],["أَلا إنَّني مِنهُم وَعِرضِيَ عِرضَهُمُ","كَذي الأَنفِ يَحمي أَنفَهُ أَن يُكَشَّما"],["وَإِنَّ نِصابي إِن سَألتَ وَأُسرَتي","مِنَ الناسِ حَيٌّ يَقتَنونَ المُزَنَّما"],["إِذا اِختَلَفَت يَوماً رَبيعَةُ صادَفَت","لَنا حَكَماً عَدلاً وَجَيشاً عَرَمرَما"],["لِذي الحِلمِ قَبلَ اليَومِ ما تُقرَعُ العَصا","وَما عُلِّمَ الإِنسانُ إِلا لِيَعلَما"],["وَلو غَيرُ أَخوالي أَرادوا نَقيصَتي","جَعَلتُ لَهُم فَوقَ العَرانينِ ميسَما"],["وَهَل لِيَ أُمٌّ غَيرُها إِن تَرَكتُها","أَبَى اللَهُ إِلاّ أَن أَكونَ لَها اِبنَما"],["وَما كُنتُ إِلا مِثلَ قاطِعِ كَفِّهِ","بِكَفٍّ لَهُ أُخرى فَأَصبَحَ أَجذَما"],["فَلَمّا اِستَقادَ الكَفَّ بِالكَفِّ لَم يَجِد","لَهُ دَرَكاً في أَن تَبِينا فَأَحجَما"],["يَداهُ أَصابَت هَذِهِ حَتفَ هذهِ","فَلَم تَجِدِ الأُخرى عَلَيها مُقَدَّما"],["فَأَطرَقَ إِطراقَ الشُجاعِ وَلو يَرَى","مَساغاً لِنابَيهِ الشُجاعُ لَصَمَّما"],["وَقَد كُنتُ أَرجو أَن أَكونَ لِعَقبِهِم","زَنيماً فَما أُجرِرتُ أَن أَتَكَلَّما"],["لِأُورِثَ بَعدي سُنَّةً يُقتَدَى بِها","وَأَجلوَ عَن ذي شُبهَةٍ أَن تَوَهَّما"],["أَرى عُصَماً مِن نَصرِ بُهثَةَ دانِياً","وَيَدفَعُني عَن آلِ زَيدٍ فَبِئسَما"],["إِذا لَم يَزَل حَبلُ القَرينَينِ يَلتَوي","فَلا بُدَّ يَوماً مِن قُوىً أَن تُجَذَّما"],["إِذا ما أَديمُ القَومِ أنَهَجَهُ البِلَى","تَفَرَّى وَإِن كَتَّبتَهُ وَتَخَرَّما"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%B9%D9%8A%D8%B1%D9%86%D9%8A_%D8%A3%D9%85%D9%8A_%D8%B1%D8%AC%D8%A7%D9%84_%D9%88%D9%84%D8%A7_%D8%A3%D8%B1%D9%89"}}}