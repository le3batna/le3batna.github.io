,"لساكنهنَّ ليس إلى الربوعِ"],["ولو أني حننت إلى مغاني","أحبَّائي حننتُ إلى الضلوعِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%82%D9%81%D8%AA_%D8%B9%D9%84%D9%89_%D8%A7%D9%84%D8%B1%D8%A8%D9%88%D8%B9_%D9%88%D9%84%D9%8A_%D8%AD%D9%86%D9%8A%D9%86"},"ibn-zaqqaq-0072":{"t":"وليل قطعت دياجيره","v":[["وليل قطعت دياجيره","بعذراءَ حمراءَ كالأنجم"],["أديرت كواكب أقداحها","عليَّ فأغربتُها في فمي"],["تجلَّى الظلامُ سريعاً بها","كسرعةِ عَبْلِ الشَّوى أدهم"],["يقولُ وقد مال عرنينُهُ","ولونُ الدجى واضحُ المبسم"],["رأيتكَ تشربُ زُهرَ النجومِ","فولّيتُ خوفاً على أنجمي"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%84%D9%8A%D9%84_%D9%82%D8%B7%D8%B9%D8%AA_%D8%AF%D9%8A%D8%A7%D8%AC%D9%8A%D8%B1%D9%87"},"ibn-zaqqaq-0073":{"t":"ومسددين إلى الطعان ذوابلاومسددين إلى الطعان ذوابلا","v":[["ومسدِّدين إلى الطعانِ ذوابلاً","فازوا بها يوم الهيلج قداحا"],["مُتسربلي قُمُصِ الحديدِ كأنها","غدران ماء قد ملأن بطاحا"],["شبّوا ذبال الزرق في ليل الوغى","ناراً وكلَّ مذرَّبٍ مصباحا"],["سرج ترى الأرواح تطفي غيرها","عبثاً وهذي تطفئ الأرواحا"],["لا فرق بين النيرات وبينها","إلا بتسمية الوشيج رماحا"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D8%B3%D8%AF%D8%AF%D9%8A%D9%86_%D8%A5%D9%84%D9%89_%D8%A7%D9%84%D8%B7%D8%B9%D8%A7%D9%86_%D8%B0%D9%88%D8%A7%D8%A8%D9%84%D8%A7%D9%88%D9%85%D8%B3%D8%AF%D8%AF%D9%8A%D9%86_%D8%A5%D9%84%D9%89_%D8%A7%D9%84%D8%B7%D8%B9%D8%A7%D9%86_%D8%B0%D9%88%D8%A7%D8%A8%D9%84%D8%A7"},"ibn-zaqqaq-0075":{"t":"ومقلة شادن أودت بنفسي","v":[["ومقلة شادن أودت بنفسي","كأن السُّقمَ لي ولها لباسُ"],["يسلُّ اللحظُ منها مَشْرَفِيّاً","لقتلي ثم يغمده النعاس"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D9%82%D9%84%D8%A9_%D8%B4%D8%A7%D8%AF%D9%86_%D8%A3%D9%88%D8%AF%D8%AA_%D8%A8%D9%86%D9%81%D8%B3%D9%8A"},"ibn-zaqqaq-0076":{"t":"ومهفهف غنج تقسمت الظبا","v":[["ومهفهفٍ غنِجٍ تَقسّمَتِ الظَّبا","ألحاظَهُ لمّا رَنَتْ رُقَباؤُهُ"],["فليومه زرق المهند تنتضى","ولمقلتيه حدُّهُ ومضاؤهُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D9%87%D9%81%D9%87%D9%81_%D8%BA%D9%86%D8%AC_%D8%AA%D9%82%D8%B3%D9%85%D8%AA_%D8%A7%D9%84%D8%B8%D8%A8%D8%A7"},"ibn-zaqqaq-0077":{"t":"ومهند عضب براحة أغيد","v":[["ومهند عضب براحة أغيد","في جفنه عضب يقدّ مفاصلي"],["يسطو بذاكَ وذا فيغدو قِرْنُهُ","بهما صريعَ لواحظٍ ومناصل"],["ماض كلا السيفين لكن لحظه","أمضى وإلا فاسألنّ مقاتلي"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%85%D9%87%D9%86%D8%AF_%D8%B9%D8%B6%D8%A8_%D8%A8%D8%B1%D8%A7%D8%AD%D8%A9_%D8%A3%D8%BA%D9%8A%D8%AF"},"ibn-zaqqaq-0078":{"t":"وواضحة كمثل النصل تجري","v":[["وواضحةٍ كمثلِ النصلِ تجري","مع الأبصار كالماء القراح"],["ترى حُبكَ المدادِ بجسمِ نورٍ","كمخضّرِ الفرندِ على الصِّفاحِ"],["كأن سواده في صفحتيها","بقايا الليل في وجهِ الصباحِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%88%D8%A7%D8%B6%D8%AD%D8%A9_%D9%83%D9%85%D8%AB%D9%84_%D8%A7%D9%84%D9%86%D8%B5%D9%84_%D8%AA%D8%AC%D8%B1%D9%8A"},"ibn-zaqqaq-0079":{"t":"ويوم أنس راقنا أصيله","v":[["ويوم أنس راقنا أصيله","بنهر روض سندسي الورقِ"],["لما توارت بالحجاب شمسه","وابدرتْ ساعاتُهُ بالغَسَقِ"],["أطلَّ من أُفْقِ السماءِ كوكبٌ","على الخليج واضح التألق"],["والنهرُ صافٍ ماؤهُ مُفَضّضٌ","والنجم فيه كذبال مشرق"],["تحمله خَوْدٌ لدى لبَّتها","خوْفَ الصَّبا، تحت قَناعٍ أزرق"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%8A%D9%88%D9%85_%D8%A3%D9%86%D8%B3_%D8%B1%D8%A7%D9%82%D9%86%D8%A7_%D8%A3%D8%B5%D9%8A%D9%84%D9%87"},"ibn-zaqqaq-0080":{"t":"يا أبي من هواه أقسم لي","v":[["يا أبي من هواه أقسم لي","إلا يني القلب منه في شغل"],["هزت بريح الشباب قامته","وأدميت وجنتاه بالقبل"],["فانقدّ قدّ القضيبِ من دَهَشٍ","واحمر خد الشقيق من خجل"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%A3%D8%A8%D9%8A_%D9%85%D9%86_%D9%87%D9%88%D8%A7%D9%87_%D8%A3%D9%82%D8%B3%D9%85_%D9%84%D9%8A"},"ibn-zaqqaq-0081":{"t":"يا برق نجد هل شعرت بمتهم","v":[["يا برق نجد هل شعرت بمتهم","وهب الكرى لوميضك المتبسم"],["ما طالَعَتْهُ في الدجى لك لمحةٌ","إلا وقال لدمعِ مقلته کسْجم"],["ناشدتكَ اللَّه کسقينَّ رُبى الحمى","سُحُباً تطرِّزها بنوءِ المِرْزَم"],["وانفح بذي سلم نسيم ظلاله","وإذا مررتَ على العقيق فسلم"],["فيها جررتُ ذيول أبرادِ الصبى","طوعاً له، وعصيت لوم اللوّم"],["متنكباً زوراء مثل هلاله","نصّلت أسهمها بمثل الأنجم"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%A8%D8%B1%D9%82_%D9%86%D8%AC%D8%AF_%D9%87%D9%84_%D8%B4%D8%B9%D8%B1%D8%AA_%D8%A8%D9%85%D8%AA%D9%87%D9%85"},"ibn-zaqqaq-0082":{"t":"يا ثاويا بضلوعي ما يفارقها","v":[["يا ثاوياً بضلوعي ما يُفارقُها","وإن تحمّل عن أكناف أربعه"],["لأنتَ إنسانُ عيني فاعجبنَّ لمنْ","إِنسانُ مقلتهِ ما بينَ أضلُعِهِ"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%AB%D8%A7%D9%88%D9%8A%D8%A7_%D8%A8%D8%B6%D9%84%D9%88%D8%B9%D9%8A_%D9%85%D8%A7_%D9%8A%D9%81%D8%A7%D8%B1%D9%82%D9%87%D8%A7"},"ibn-zaqqaq-0085":{"t":"يا عالم السر مني","v":[["يا عالم السر مني","کصْفَحْ بفضلكَ عنّي"],["مَنَّيْتُ نفسي بعفوٍ","مولايَ منكَ ومني"],["وكان ظنّي جميلاً","فكن إذاً عند ظني"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D8%B9%D8%A7%D9%84%D9%85_%D8%A7%D9%84%D8%B3%D8%B1_%D9%85%D9%86%D9%8A"},"ibn-zaqqaq-0086":{"t":"يا كوكبا بهر الكواكب حسنه","v":[["يا كوكباً بهر الكواكب حسنه","لما أفلن وما عرفن أفولا"],["للَّه درُّك ان تقوَّلَ كاشحٌ","فرددت حد لسانه مفلولا"],["ما كنت أضمر غير ود صادق","لك كلّما هجر الخليلُ خليلا"],["فاقمعْ شرارَ الحاسدين فإنهم","طلبوا لتغيير الصفاءِ سبيلا"],["قلبي على العهد القديم فرد به","ظلَّ المودة يا خبيرُ ظليلا"],["لا تطلبن بي البديل فإنني","لم اتخذ بك في الاخاء بديلا"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%83%D9%88%D9%83%D8%A8%D8%A7_%D8%A8%D9%87%D8%B1_%D8%A7%D9%84%D9%83%D9%88%D8%A7%D9%83%D8%A8_%D8%AD%D8%B3%D9%86%D9%87"},"ibn-zaqqaq-0087":{"t":"يا من سبا رياه عرف الصبا","v":[["يا مَنْ سَبَا ريّاهُ عَرْفُ الصَّبا","وذرَّ من أزرارِهِ شَارِقُ"],["ذرني وعينيك أسائلهما","بأي ذنب قتل الوامقُ"],["تالله ما أملك نجواي يا","مملوكُ والدمعُ به ناطق"],["أنى لمثلي فيك كتم الهوى","والدمعُ سَكْبٌ والحشا خافق"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%85%D9%86_%D8%B3%D8%A8%D8%A7_%D8%B1%D9%8A%D8%A7%D9%87_%D8%B9%D8%B1%D9%81_%D8%A7%D9%84%D8%B5%D8%A8%D8%A7"},"ibn-zaqqaq-0088":{"t":"يا نازحا بوداده لما بدا","v":[["يا نازحاً بودادِهِ لمّا بدا","واش وليس عن الفؤاد بنازح"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%86%D8%A7%D8%B2%D8%AD%D8%A7_%D8%A8%D9%88%D8%AF%D8%A7%D8%AF%D9%87_%D9%84%D9%85%D8%A7_%D8%A8%D8%AF%D8%A7"},"ibn-zaqqaq-0089":{"t":"يذكرني تحنان شدو غنائه","v":[["يذكّرني تحنانُ شدوِ غنائه","على الأيك تحنان الحمام المغرّد"],["له نغماتٌ أفحمتْ كلَّ صادحٍ","وصوت نشيد قد شجا كلّ منشد"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%B0%D9%83%D8%B1%D9%86%D9%8A_%D8%AA%D8%AD%D9%86%D8%A7%D9%86_%D8%B4%D8%AF%D9%88_%D8%BA%D9%86%D8%A7%D8%A6%D9%87"},"ibn-zaqqaq-0090":{"t":"يفوقهم لأن الجهل فيهم","v":[["يفوقهم لأن الجهل فيهم","وجهل المرء يكفيه الملاما"],["فربَّ لئامِ قومٍ قد تسامَوْا","بلؤم عند الأمهم كراما"],["ومن يك للسوابق في رهان","وراءَ يكنْ لِسِكِّيتٍ أَماما"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D9%81%D9%88%D9%82%D9%87%D9%85_%D9%84%D8%A3%D9%86_%D8%A7%D9%84%D8%AC%D9%87%D9%84_%D9%81%D9%8A%D9%87%D9%85"}}}