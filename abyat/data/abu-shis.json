{"poet":{"id":"abu-shis","short":"أبو الشيص","name":"أبو الشيص الخزاعي","en":"Abu al-Shis al-Khuza'i","era":"abbasid"},"poems":{"abu-shis-0003":{"t":"إذا لم تكن طرق الهوى لي ذليلة","v":[["إذا لم تكن طُرْق الهوى لي ذَليلة","تنكْبُتها وانْحِزْتُ للجانب السَّهْلِ"],["وما ليَ أرضى منه بالجَوْر في الهوى","ولي مثْلُه إلْفٌ وليس له مِثْلي"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D9%84%D9%85_%D8%AA%D9%83%D9%86_%D8%B7%D8%B1%D9%82_%D8%A7%D9%84%D9%87%D9%88%D9%89_%D9%84%D9%8A_%D8%B0%D9%84%D9%8A%D9%84%D8%A9"},"abu-shis-0004":{"t":"إذا ما حمام المرء كان ببلدة","v":[["إذا ما حِمامُ المرء كان ببلدة","دَعَتْهُ إليها حاجَةٌ أو تطَرُّبُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%B0%D8%A7_%D9%85%D8%A7_%D8%AD%D9%85%D8%A7%D9%85_%D8%A7%D9%84%D9%85%D8%B1%D8%A1_%D9%83%D8%A7%D9%86_%D8%A8%D8%A8%D9%84%D8%AF%D8%A9"},"abu-shis-0007":{"t":"أعلل آمالي بكانت ولم تكن","v":[["أُعلّل آمالي بكانَت ولم تكنْ","وذلك طعم السُّم والشّهدُ في الكاس"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B9%D9%84%D9%84_%D8%A2%D9%85%D8%A7%D9%84%D9%8A_%D8%A8%D9%83%D8%A7%D9%86%D8%AA_%D9%88%D9%84%D9%85_%D8%AA%D9%83%D9%86"},"abu-shis-0008":{"t":"الحمدُ للَّه ربَّ العالمين على","v":[["الحمدُ للَّه ربَّ العالمين على","قرْبي وبعْدك منه يا بن إسحاقِ"],["يا ليت شِعْري متى تجدي عليَّ وقد","أصبحت ربَّ دنانيرٍ وأوراقِ"],["تجدي عليَّ إذا ما قيل من راق","والتفَّتِ السّاقُ عند الموتِ بالسّاقِ"],["يومٌ لِعَمْري تهمُّ الناس أَنْفُسُم","وليس تَنْفعُ فيه رُقْيَة الراقي"]],"src":"https://ar.wikisource.org/wiki/%D8%A7%D9%84%D8%AD%D9%85%D8%AF%D9%8F_%D9%84%D9%84%D9%8E%D9%91%D9%87_%D8%B1%D8%A8%D9%8E%D9%91_%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85%D9%8A%D9%86_%D8%B9%D9%84%D9%89"},"abu-shis-0011":{"t":"بالله قل يا طلل","v":[["باللّه قُلْ يا طَلَلُ","أهلُكَ ماذا فَعَلُوا"],["فإنَّ قَلْبي حَذِرٌ","من أنْ يبِنُوا وَجِلُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D8%A7%D9%84%D9%84%D9%87_%D9%82%D9%84_%D9%8A%D8%A7_%D8%B7%D9%84%D9%84"},"abu-shis-0012":{"t":"بغداد بعدا لا سقى","v":[["بغداد بعداً لا سَقَى","ساحاتها صوبُ السحابْ"],["عمر الإله ديارها","بالعاويات من الكلابْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D8%BA%D8%AF%D8%A7%D8%AF_%D8%A8%D8%B9%D8%AF%D8%A7_%D9%84%D8%A7_%D8%B3%D9%82%D9%89"},"abu-shis-0014":{"t":"تخشع شمس النهار طالعة","v":[["تخْشَعُ شمسُ النَّهار طالعةً","حين تراه. وَيَخْشَعُ القَمَرُ"],["تعرِفُه أنَّه يفوقُهُما","بالحُسْن في عْين مَنْ له بَصَرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%AE%D8%B4%D8%B9_%D8%B4%D9%85%D8%B3_%D8%A7%D9%84%D9%86%D9%87%D8%A7%D8%B1_%D8%B7%D8%A7%D9%84%D8%B9%D8%A9"},"abu-shis-0016":{"t":"تقول غداة البين إحدى نسائهم","v":[["تقولُ غَداة البَيْن إحدَى نِسائهم","ليَ الكِبدُ الحرّى فَسِرْ ولك الصَّبْرُ"],["وقد خَنَقَتْها عَبْرةٌ فدموعُها","على خدّها بيضٌ وفي نَحْرِها صُفْرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D9%82%D9%88%D9%84_%D8%BA%D8%AF%D8%A7%D8%A9_%D8%A7%D9%84%D8%A8%D9%8A%D9%86_%D8%A5%D8%AD%D8%AF%D9%89_%D9%86%D8%B3%D8%A7%D8%A6%D9%87%D9%85"},"abu-shis-0019":{"t":"جاء الرسول ببشرى منك تطمعني","v":[["جاءَ الرسولُ بُبشْرَى منك تطمعني","فكان أكبر وَهْمي إنّه وَهَما"],["فما فرِحْتُ ولكن زادني حزَناً","عِلْمي بأنَّ رسولي لم يكن فَهِمَا"],["كم من سريرة حُبّ قد خَلوْت بها","ودمْعةٍ تملأ القِرطاس والقَلَما"]],"src":"https://ar.wikisource.org/wiki/%D8%AC%D8%A7%D8%A1_%D8%A7%D9%84%D8%B1%D8%B3%D9%88%D9%84_%D8%A8%D8%A8%D8%B4%D8%B1%D9%89_%D9%85%D9%86%D9%83_%D8%AA%D8%B7%D9%85%D8%B9%D9%86%D9%8A"},"abu-shis-0020":{"t":"جارية تسحر عيناها","v":[["جارية تسْحَرُ عَيْناها","أسْفلُها يجْذِبُ أعلاها"],["أصبحتُ أهواها وأهوى الردى","لكلِّ مَنْ أصبح يَهْواها"],["نَفْسي على أمرَيْن مطبوعةٌ","حُبّي لها أو بُغْض مَوْلاها"],["قد مَلكتني وهي مملوكةٌ","فصرْت أخْشاهُ وأخْشاها"]],"src":"https://ar.wikisource.org/wiki/%D8%AC%D8%A7%D8%B1%D9%8A%D8%A9_%D8%AA%D8%B3%D8%AD%D8%B1_%D8%B9%D9%8A%D9%86%D8%A7%D9%87%D8%A7"},"abu-shis-0022":{"t":"جلا الصبح أوني الكرى عن جفونه","v":[["جلا الصّبْح أوْنيّ الكرى عن جفونه","وفي صدره مثلُ السّهام القواصِدِ"],["تمكّن من غِرّاته الحبُّ فانْتَحى","عليه بأيْدٍ أيّدات حواشدِ"],["إذا خَطَراتُ الشَّوْق قلَّبْنَ قلْبه","شدَدْن بأنْفاس شداد المصاعدِ"],["يُذكّرُه خفْضُ الهوىَ ونعيمُه","سَوالفَ أيامٍ وليس بعائدِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AC%D9%84%D8%A7_%D8%A7%D9%84%D8%B5%D8%A8%D8%AD_%D8%A3%D9%88%D9%86%D9%8A_%D8%A7%D9%84%D9%83%D8%B1%D9%89_%D8%B9%D9%86_%D8%AC%D9%81%D9%88%D9%86%D9%87"},"abu-shis-0023":{"t":"ختلته المنون بعد احتيال","v":[["ختَلتْهُ المَنُون بعْدَ احْتيالٍ","بين صفَّيْن من قنىً ونِصالِ"],["في رداءٍ من الصَّفيح ثَقيلٍ","وقميص من الحديد مُذَالِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AE%D8%AA%D9%84%D8%AA%D9%87_%D8%A7%D9%84%D9%85%D9%86%D9%88%D9%86_%D8%A8%D8%B9%D8%AF_%D8%A7%D8%AD%D8%AA%D9%8A%D8%A7%D9%84"},"abu-shis-0024":{"t":"خلع الصبا عن منكبيه مشيب","v":[["خَلع الصِّبا عن منكَبْيه مشيبُ","فطوى الذَّوائب رأسه المخضوبُ"],["نَشَر البِلى في عارِضَيْه عقارباً","بيضاً لهنَّ على القُرون دبيبُ"],["ما كان أنْضَر عيشه وأغضَّه","أيام فَضْل ردائه مسحوبُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AE%D9%84%D8%B9_%D8%A7%D9%84%D8%B5%D8%A8%D8%A7_%D8%B9%D9%86_%D9%85%D9%86%D9%83%D8%A8%D9%8A%D9%87_%D9%85%D8%B4%D9%8A%D8%A8"},"abu-shis-0025":{"t":"دعتني جفونك حتى عشقت","v":[["دَعتْني جُفونُك حتى عشقْتُ","وما كنتُ من قبلها أَعْشَقُ"],["فدمعي يسيلُ وصَبْري يزولُ","وجِسْميَ في عبْرتي يغرَقُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AF%D8%B9%D8%AA%D9%86%D9%8A_%D8%AC%D9%81%D9%88%D9%86%D9%83_%D8%AD%D8%AA%D9%89_%D8%B9%D8%B4%D9%82%D8%AA"},"abu-shis-0026":{"t":"ربع دار مدرس العرصات","v":[["ربعُ دارٍ مُدَرَّسِ العَرَصاتِ","وطُلول مَمْحُوَّة الآياتِ"],["خَفَق الدّهر فوقها بجناحَيْ","ن مَريشَيْن بالبلى والشَّتاتِ"]],"src":"https://ar.wikisource.org/wiki/%D8%B1%D8%A8%D8%B9_%D8%AF%D8%A7%D8%B1_%D9%85%D8%AF%D8%B1%D8%B3_%D8%A7%D9%84%D8%B9%D8%B1%D8%B5%D8%A7%D8%AA"},"abu-shis-0027":{"t":"سروا يخبطون الليل فوق ظهورها","v":[["سَرَوْا يَخْبطونَ اللَّيْلَ فوق ظُهورها","إلى أنْ بَدَا قَرْنٌ من الليل أبْلَجُ"],["وأَضْحَوْا وبَعْضٌ ما يقيمُ لسانه","وبعضٌ إذا ما حاول المشي يَعْرُجُ"]],"src":"https://ar.wikisource.org/wiki/%D8%B3%D8%B1%D9%88%D8%A7_%D9%8A%D8%AE%D8%A8%D8%B7%D9%88%D9%86_%D8%A7%D9%84%D9%84%D9%8A%D9%84_%D9%81%D9%88%D9%82_%D8%B8%D9%87%D9%88%D8%B1%D9%87%D8%A7"},"abu-shis-0028":{"t":"شددت أمير المؤمنين قوى الملك","v":[["شَددْت أمير المؤمنين قوى المُلْك","صَدَعْتَ بفتْح الروم أفئدة التُّرْكِ"],["فَريْتَ بسيف اللّه هام عدوّه","وطأطأت للإسلام ناصية الشّرْكِ"],["فأصبحت مسروراً بما كان ضاحكاً","وأصبح نقْفورٌ على مُلْكه يَبْكي"]],"src":"https://ar.wikisource.org/wiki/%D8%B4%D8%AF%D8%AF%D8%AA_%D8%A3%D9%85%D9%8A%D8%B1_%D8%A7%D9%84%D9%85%D8%A4%D9%85%D9%86%D9%8A%D9%86_%D9%82%D9%88%D9%89_%D8%A7%D9%84%D9%85%D9%84%D9%83"},"abu-shis-0030":{"t":"ضع السر في صماء ليست بصخرة","v":[["ضَع السِرَّ في صمّاء ليست بصخرة","صَلود كما عايَنْت من سائر الصَّخْر"],["ولكنّها قلب امرىءٍ ذي حفيظة","ترَى ضيْعة الأسرار قاصِمةَ الظَّهْر"],["يموتُ وما ماتَتْ كرائمُ فِعْله","ويبلَى وما يبلى ثناه علىَ الدّهر"],["فذاك ولا صمّاء من رام كسْرها","بمعوله ذلَّتْ بكفَّيهِ للكسْر"]],"src":"https://ar.wikisource.org/wiki/%D8%B6%D8%B9_%D8%A7%D9%84%D8%B3%D8%B1_%D9%81%D9%8A_%D8%B5%D9%85%D8%A7%D8%A1_%D9%84%D9%8A%D8%B3%D8%AA_%D8%A8%D8%B5%D8%AE%D8%B1%D8%A9"},"abu-shis-0034":{"t":"فأوردها بيضا ظماء صدورها","v":[["فأوردها بيضاً ظماءً صدورُها","وأصْدَرها بالرّيّ ألْوانُها حُمْرُ"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D8%A3%D9%88%D8%B1%D8%AF%D9%87%D8%A7_%D8%A8%D9%8A%D8%B6%D8%A7_%D8%B8%D9%85%D8%A7%D8%A1_%D8%B5%D8%AF%D9%88%D8%B1%D9%87%D8%A7"},"abu-shis-0035":{"t":"قل للطويلة موضع العقد","v":[["قُلْ للطّويلة موضع العِقْد","ولطيفة الأَحشاء والكْبدِ"],["ألا وقفتِ على مدامِعِهِ","فنظرتِ ما يَعْملن في الخدِ"],["لولا التْمنْطق والسّوار معاً","والحِجْلُ والدُّملوج في العضْدِ"],["لتزايَلَتْ من كلّ ناحية","لكنْ جُعِلْن لها على عَمْدِ"],["جاءَتْ إلى عينَيْك وجْنُتها","في خلْعة الخَيريّ والوْردِ"]],"src":"https://ar.wikisource.org/wiki/%D9%82%D9%84_%D9%84%D9%84%D8%B7%D9%88%D9%8A%D9%84%D8%A9_%D9%85%D9%88%D8%B6%D8%B9_%D8%A7%D9%84%D8%B9%D9%82%D8%AF"},"abu-shis-0038":{"t":"لا تغض الرياح من شأوها إل","v":[["لا تغضُّ الريّاح من شأْوها إلْ","لاَّ وهُنَّ الطَّلائح الأنْضَاءُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%A7_%D8%AA%D8%BA%D8%B6_%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%AD_%D9%85%D9%86_%D8%B4%D8%A3%D9%88%D9%87%D8%A7_%D8%A5%D9%84"},"abu-shis-0040":{"t":"لم تنصفي يا سمية الذهب","v":[["لم تَنْصفي يا سميّة الذَّهَبِ","تْتلفُ نَفْسي وأنتِ في لَعِبِ"],["يا بنة عمّ المسْك الزكي ومن","لولاكِ لم يُتَّخذ ولم يَطبِ"],["ناسَبَك المِسْك في السواد وفي الرْ","يح فأكرمْ بذاكَ من نسَبِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%85_%D8%AA%D9%86%D8%B5%D9%81%D9%8A_%D9%8A%D8%A7_%D8%B3%D9%85%D9%8A%D8%A9_%D8%A7%D9%84%D8%B0%D9%87%D8%A8"},"abu-shis-0041":{"t":"لها عن صلة البيض","v":[["لها عن صِلَة البيض","نَذيرٌ لذوي العَقْل"],["مصابيحُ مَشيبٍ و","سَمَتْني سِمَة الكهْل"],["وعهدي بربيباتٍ","مِلاحِ الدَّلّ والشَّكْل"],["إذا جئْتُ يُرقّعْنَ ال","كوى بالأعْيُن النُّجْل"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%87%D8%A7_%D8%B9%D9%86_%D8%B5%D9%84%D8%A9_%D8%A7%D9%84%D8%A8%D9%8A%D8%B6"},"abu-shis-0042":{"t":"لهون عن الإخوان إذ سفر الضحى","v":[["لَهوْن عن الإخْوان إذْ سَفَر الضُّحى","وفي كَبِدي من حرِّهنَّ حَرِيقُ"],["مزجْتُ دماً بالدّمع حتى كأنَّما","يُذابُ بعْيني لؤْلؤٌ وعَقيقُ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%87%D9%88%D9%86_%D8%B9%D9%86_%D8%A7%D9%84%D8%A5%D8%AE%D9%88%D8%A7%D9%86_%D8%A5%D8%B0_%D8%B3%D9%81%D8%B1_%D8%A7%D9%84%D8%B6%D8%AD%D9%89"},"abu-shis-0044":{"t":"ما فرق الأحباب بع","v":[["ما فرَّق الأَحبابَ بع","د اللّه إلاّ الإبلُ"],["والناسُ يَلْحَوْن غرا","ب البَيْن لما جَهِلوا"],["وما إذا صاحَ غرا","بٌ في الدِّيار احتملوا"],["وما على ظهر غرا","ب البَيْن تُطْوى الرِّحَلُ"],["وما غراب البَيْن إلْ","لا ناقةٌ أو جَمَلُ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7_%D9%81%D8%B1%D9%82_%D8%A7%D9%84%D8%A3%D8%AD%D8%A8%D8%A7%D8%A8_%D8%A8%D8%B9"},"abu-shis-0045":{"t":"ما كان مثلك في الورى فيمن مضى","v":[["ما كان مثلك في الورى فيمن مضى","أحدٌ وظَنّي أنَّه لا يُخْلَقُ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7_%D9%83%D8%A7%D9%86_%D9%85%D8%AB%D9%84%D9%83_%D9%81%D9%8A_%D8%A7%D9%84%D9%88%D8%B1%D9%89_%D9%81%D9%8A%D9%85%D9%86_%D9%85%D8%B6%D9%89"},"abu-shis-0046":{"t":"ما كان منكسر اللواء لطيرة","v":[["ما كان منكسر اللّواء لطَيْرة","تخشى ولا أمر يكون مُزيّلا"],["لكنَّ هذا الرُّمْح أضْعَف ركنَه","صِغَر الولاية واسْتقلَّ الموصلا"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7_%D9%83%D8%A7%D9%86_%D9%85%D9%86%D9%83%D8%B3%D8%B1_%D8%A7%D9%84%D9%84%D9%88%D8%A7%D8%A1_%D9%84%D8%B7%D9%8A%D8%B1%D8%A9"},"abu-shis-0049":{"t":"ملك لا يصرف الأمر والنه","v":[["مَلِكٌ لا يُصرف الأمر والنَّهْ","ي له دون رأيه الوزراءُ"],["حلَّ في الدَّوْحة التي طالت النا","س جميعاً فما إليها ارْتقاءُ"],["وَسُعَتْ كفُّه الخلائقَ جُوداً","فاستوى الأغنياءُ والفقراءُ"],["يا بني هاشم أفيقوا فإنَّ الْ","مُلْكَ منكم حيث العصا والرداءُ"],["ما لهارون في قريش كفيٌّ","وقريشٌ ليست لهم أكفاءُ"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D9%84%D9%83_%D9%84%D8%A7_%D9%8A%D8%B5%D8%B1%D9%81_%D8%A7%D9%84%D8%A3%D9%85%D8%B1_%D9%88%D8%A7%D9%84%D9%86%D9%87"},"abu-shis-0054":{"t":"وأبرز الخدر من ثنييه بيضته","v":[["وأبرز الخِدْر من ثَنَيْيه بيضته","وأعجل الرّوع نصل السّيْف يُخْتَرطُ"],["فثَّم تفديك مِنّا كلّ غانية","والشيخ يفديك والولدان والشمُط"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%A3%D8%A8%D8%B1%D8%B2_%D8%A7%D9%84%D8%AE%D8%AF%D8%B1_%D9%85%D9%86_%D8%AB%D9%86%D9%8A%D9%8A%D9%87_%D8%A8%D9%8A%D8%B6%D8%AA%D9%87"},"abu-shis-0055":{"t":"وخميس يلفه في خميس","v":[["وخميس يلفُّه في خَميسٍ","في سَحاب من الرَّدَى هَطّالِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%AE%D9%85%D9%8A%D8%B3_%D9%8A%D9%84%D9%81%D9%87_%D9%81%D9%8A_%D8%AE%D9%85%D9%8A%D8%B3"},"abu-shis-0056":{"t":"وشادن كالبدر يجلو الدجى","v":[["وشادِنٍ كالبَدْر يجلو الدُّجى","في الفَرْق منه المِسْك مَذْرورُ"],["يُحاذِر العَيْن علىَ صَدْره","فالجْيبُ عنه الدَّهْر مَزْرُورُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%B4%D8%A7%D8%AF%D9%86_%D9%83%D8%A7%D9%84%D8%A8%D8%AF%D8%B1_%D9%8A%D8%AC%D9%84%D9%88_%D8%A7%D9%84%D8%AF%D8%AC%D9%89"},"abu-shis-0060":{"t":"وكم من ميتة قد مت فيها","v":[["وكم مِنْ ميتة قد مِتُّ فيها","ولكن كان ذاك وما شَعَرْتُ"],["وكنتُ إذا رأيْتُ فتىً يبكّي","على شَجَن هزْأت إذا خَلوْتُ"],["وأحس