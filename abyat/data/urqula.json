{"poet":{"id":"urqula","short":"عرقلة الكلبي","name":"عرقلة الكلبي","en":"Urqula al-Kalbi","era":"ayyubid"},"poems":{"urqula-0001":{"t":"أأحداق بيض أم حديقة نرجس","v":[["أأحداق بيضٍ أم حديقة نرجسٍ","أَتت بين مصفرٍّ إِلينا ومبيضِّ"],["شربنا على التبريّ كأساً كلونه","وأُخرى على الفضي من ذلك الفضي"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%A3%D8%AD%D8%AF%D8%A7%D9%82_%D8%A8%D9%8A%D8%B6_%D8%A3%D9%85_%D8%AD%D8%AF%D9%8A%D9%82%D8%A9_%D9%86%D8%B1%D8%AC%D8%B3"},"urqula-0002":{"t":"أبا الوحش جملت أهل الأدب","v":[["أبا الوحش جمَّلتَ أهلَ الأدبْ","لأنك أطولُ قومي ذنبْ"],["وكيف تكونُ صغيرَ الَمحَلَّ","وبيتُك أَكبرُ ما في الخشب"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%A8%D8%A7_%D8%A7%D9%84%D9%88%D8%AD%D8%B4_%D8%AC%D9%85%D9%84%D8%AA_%D8%A3%D9%87%D9%84_%D8%A7%D9%84%D8%A3%D8%AF%D8%A8"},"urqula-0003":{"t":"أحبابنا خنتم عهودي وما","v":[["أَحبابنا خنتم عهودي وما","تركتمُ للصلح من موضعِ"],["منكم سلوِّي كان، لامن يدي","أَطفأتُمُ ناري بما أَدمعي"],["والآن قد أنصفنا دهرنا","معكمْ هواكم، وفؤادي معي"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%AD%D8%A8%D8%A7%D8%A8%D9%86%D8%A7_%D8%AE%D9%86%D8%AA%D9%85_%D8%B9%D9%87%D9%88%D8%AF%D9%8A_%D9%88%D9%85%D8%A7"},"urqula-0007":{"t":"أرى الصبر عن نجد أمر من الصبر","v":[["أرى الصبر عن نجدٍ أمرَّ من الصبرِ","ومذ بَعُدت ليلى فَلَيْلي بلا فجرِ"],["وقد كنت أَبكي من يد الهجر في الحمى","فلما تفرقنا، بكيتُ على الهجرِ"],["فلو كان قلبي صخرةً لبكيتهمْ","كما بكت الخنساءُ حيناً على صخرِ"],["أُعالج شوقاً في الأصائل والضحى","ببرد الهوى النجديِّ حيِّ الهوى العذري"],["أموت ولا ألفٌ أغيظ بنيلها","عدوّي، ولا ألف أشدُّ به أزري"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B1%D9%89_%D8%A7%D9%84%D8%B5%D8%A8%D8%B1_%D8%B9%D9%86_%D9%86%D8%AC%D8%AF_%D8%A3%D9%85%D8%B1_%D9%85%D9%86_%D8%A7%D9%84%D8%B5%D8%A8%D8%B1"},"urqula-0010":{"t":"أقبل يهتز في غلائله","v":[["أقبل يهتزّ في غلائلهٍ","من ليس يشفي لعاشِقٍ غُلَّهْ"],["فقال كل امرىء تأمَّلَهُ","ألف صلاةٍ على رسولِ اللهْ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%82%D8%A8%D9%84_%D9%8A%D9%87%D8%AA%D8%B2_%D9%81%D9%8A_%D8%BA%D9%84%D8%A7%D8%A6%D9%84%D9%87"},"urqula-0011":{"t":"أقسمت يا لائمي فيمن بليت به","v":[["أقسمت يا لائمي فيمن بليتُ به","وقد تحكم في هجري وإِبعادي"],["لو أَنه كلما سافرتُ ودّعني","بقبلةٍ لم أَزل في الرائح الغادي"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%82%D8%B3%D9%85%D8%AA_%D9%8A%D8%A7_%D9%84%D8%A7%D8%A6%D9%85%D9%8A_%D9%81%D9%8A%D9%85%D9%86_%D8%A8%D9%84%D9%8A%D8%AA_%D8%A8%D9%87"},"urqula-0012":{"t":"أقول والأتراك قد أزمعت","v":[["أقول والأتراك قد أزمعت","مصرَ إِلى حرب الأعاريبِ"],["ربِّ كما يوسفَ الصديقَ","ديقَ من أَولاد يعقوبِ"],["يملِكُها في عصرنا يوسفُ الصا","دقُ من أَولاد أَيوبِ"],["من لم يزلْ ضرّابَ هامِ العدا","حقاً وضرّابَ العراقيبِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%82%D9%88%D9%84_%D9%88%D8%A7%D9%84%D8%A3%D8%AA%D8%B1%D8%A7%D9%83_%D9%82%D8%AF_%D8%A3%D8%B2%D9%85%D8%B9%D8%AA"},"urqula-0013":{"t":"أقول والقلب في هم وتعذيب","v":[["أقول والقلبُ في همٍ وتعذيب","ياكلِّ يوسفَ إرحم نصف أيوبِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%82%D9%88%D9%84_%D9%88%D8%A7%D9%84%D9%82%D9%84%D8%A8_%D9%81%D9%8A_%D9%87%D9%85_%D9%88%D8%AA%D8%B9%D8%B0%D9%8A%D8%A8"},"urqula-0014":{"t":"إلام ألام فيك وكم أعادى","v":[["إلامَ ألامُ فيك وكم أعادى","وأَمرض من جفاك ولن أُعادا"],["لقد ألف الضنى والسقمَ جسمي","وعينايَ المدامعَ والسهادا"],["وها أنا قد وهى صبري، وشوقي","إذا ما قلتِ الأشواقُ، زادا"],["بقلبي ذاتَ خلخالٍ وقلبٍ","تملَّكَ فَوْدُها مني الفؤادا"],["مهفهفة كأنَّ قضيبَ بانٍ","تثنّى في غلائلها ومادا"],["بوجهٍ لم يزِد إِلاّ بياضاً","وشعرٍ لم يزد إلا سوادا"],["تعجب عاذلي من حَرِّ حُبي","ومن برد السّلُوِّ وقد تمادى"],["ولا عجبٌ إِ ذا ما آبَ حَرٌّ","بآب، ومن جماد في جُمادى"],["وقد أنسانيَ لاشيبُ الغواني","فلا سعدى أريدُ ولا سعادا"],["وهل أخشى من الأنواء بخلاً","إذا ما يوسفٌ بالمال جادا"],["فتى للدين لم يَبرَحْ صلاحاً","وللأَموال لم يبرح فسادا"],["هو المعروف بالمعروف حقاً","جوادٌ لم يهبْ إلا الجوادا"],["به الأشعارُ قد عاشت نفاقاً","وعند سواه قد ماتت كسادا"],["يحب الخمسة الأشباحَ ديناً","وما يهوى يزيداً أو زيادا"],["لَئِن أَعطاه نور الدين حِصناً","فإِن اللّهَ أَعطاه البلادا"],["إلى كم ذا التواني في دمشقٍ","وقد جاءتكم مِصرٌ تهادى"],["عروسُ بعلها أسدٌ هصورٌ","وراء لوائه تلقوا رشادا"],["وما كل امرئٍ صلّى مع النّاسِ","مأموناً كمن صلّى فرادى"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%84%D8%A7%D9%85_%D8%A3%D9%84%D8%A7%D9%85_%D9%81%D9%8A%D9%83_%D9%88%D9%83%D9%85_%D8%A3%D8%B9%D8%A7%D8%AF%D9%89"},"urqula-0016":{"t":"إلى كم أبيد البيد في طلب الغنى","v":[["إِلى كم أُبيد البيد في طلب الغنى","وأَقربُ رزقي فوق نجمِ سُهَيلِ"],["وقد وخط الشيبُ الشباب كأنّهُ","أَوائلُ صبحٍ في أَواخر لَيْلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%84%D9%89_%D9%83%D9%85_%D8%A3%D8%A8%D9%8A%D8%AF_%D8%A7%D9%84%D8%A8%D9%8A%D8%AF_%D9%81%D9%8A_%D8%B7%D9%84%D8%A8_%D8%A7%D9%84%D8%BA%D9%86%D9%89"},"urqula-0017":{"t":"إلى كم لا يفارقني الفراق","v":[["إِلى كم لا يفارقني الفراق","وأحمل في الهوى مالا يطاق"],["لئن دام المدى هجراً وبيناً","فلا شامٌ لديَّ ولا عراقُ"],["أقول لصاحبي ودموع عيني","تروق لحاسدي ودمي يُراقُ"],["أسرتُ، ولم تغرْ للسبي خيلٌ","قُتِلتُ، ولم تقمْ للحرب ساقٌ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%84%D9%89_%D9%83%D9%85_%D9%84%D8%A7_%D9%8A%D9%81%D8%A7%D8%B1%D9%82%D9%86%D9%8A_%D8%A7%D9%84%D9%81%D8%B1%D8%A7%D9%82"},"urqula-0018":{"t":"إليك صلاح الدين مولاي أشتكي","v":[["إِليك صلاح الدين مولاي أَشتكي","زماناً على الحرّ الكريم يجورُ"],["ترى أبصر الألف التي كنت واعدي","بها، في يدي، قبل المماتِ تصيرُ"],["وهيهاتَ والإفرانجُ يبني وبينكم","سياج؛ قتيل دونه وأسيرُ"],["ومن عجب الأيام أَنَك ذو غنى","بمصر، وأني في دمشق فقيرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%84%D9%8A%D9%83_%D8%B5%D9%84%D8%A7%D8%AD_%D8%A7%D9%84%D8%AF%D9%8A%D9%86_%D9%85%D9%88%D9%84%D8%A7%D9%8A_%D8%A3%D8%B4%D8%AA%D9%83%D9%8A"},"urqula-0019":{"t":"أما آن للغضبان أن يتعطفا","v":[["أَما آن للغضبان أَن يتعطّفا","لقد زاد ظلماً في القطيعة والحفا"],["بعادٌ ولا قربٌ، وسخطٌ ولا رضىً","وهجرٌ ولا وصلٌ وعذرٌ ولا وفا"],["كفاني غراماً كالغريم على النوى","وعندي من الشوق المبرح ما كفى"],["تكدَّر عيشي بعدما كان صافياً","وقلب الذي أهواه أقسى من الصفا"],["فيا خدَّه، لا زدت إلاّ تلهُّباً","ويا قدَّه لا زدتَ إلاّ تهفها"],["ويا ردفَهُ، لازال دِعْصُك مائلاً","ويا طرفه لازال جفنُكَ مُدْنفَا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%85%D8%A7_%D8%A2%D9%86_%D9%84%D9%84%D8%BA%D8%B6%D8%A8%D8%A7%D9%86_%D8%A3%D9%86_%D9%8A%D8%AA%D8%B9%D8%B7%D9%81%D8%A7"},"urqula-0020":{"t":"أمرث من عسرة ومن دين","v":[["أمرّث من عسرةٍ ومن دينْ","ومن صدود الحبيب والبينِ"],["طرف أَبي بكر وهو منطرفٌ","بكفِّهِ للقضاء والحينِ"],["لكَّنهُ زاد في ملاحتهِ","فانقلعت عينهُ من العيْنِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%85%D8%B1%D8%AB_%D9%85%D9%86_%D8%B9%D8%B3%D8%B1%D8%A9_%D9%88%D9%85%D9%86_%D8%AF%D9%8A%D9%86"},"urqula-0021":{"t":"إن أمير المؤمنين الذي","v":[["إن أمير المؤمنين الذي","مِصرُ حماهُ، وعليُّ أَبوه"],["نصَّ على شاوَرَ فِرعونُها","ونص موساها على شيركوه"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86_%D8%A3%D9%85%D9%8A%D8%B1_%D8%A7%D9%84%D9%85%D8%A4%D9%85%D9%86%D9%8A%D9%86_%D8%A7%D9%84%D8%B0%D9%8A"},"urqula-0022":{"t":"أنا سرج لمليك","v":[["أَنا سَرْجٌ لمليكٍ","حصنهُ في الشام شامة"],["تحتي البرق وفوقي","من أياديه غمامة"],["كتب اللّه عليه","كلما سار السلامة"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%86%D8%A7_%D8%B3%D8%B1%D8%AC_%D9%84%D9%85%D9%84%D9%8A%D9%83"},"urqula-0023":{"t":"أي هلال كسفا","v":[["أي هلالٍ كسفا","وأَي غصنٍ قُصِفا"],["كان سراجاً قد طفا","على الورى، ثم انطفا"],["لم يركب الخيل ولم","يقلِّدوه مُرْهفا"],["قل للنحاة ويحكم","أحمدكم قد صرفا"],["صبراً صلاح الدين يا","رب السّماحِ والوفا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%8A_%D9%87%D9%84%D8%A7%D9%84_%D9%83%D8%B3%D9%81%D8%A7"},"urqula-0024":{"t":"أيها السياف هيا","v":[["أيها السياف هيّا","لا تدع في البيت شيّا"],["داوِ قرناً صار ترساً","للدبابيس مهيَّا"],["كم نصحناك وقلنا","إِنتبه ما دمت حيَّا"],["كلُّ نحسٍ أَنت فيه","منْ حِراف ابن ثُريّا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%8A%D9%87%D8%A7_%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D9%81_%D9%87%D9%8A%D8%A7"},"urqula-0025":{"t":"بروق الغوادي أم بروق المباسم","v":[["بروق الغوادي أم بروق المباسم","أَشاقاكَ وهناً، أَم هديل الحماِئمِ"],["كأنّ بك الوجدَ الذي بي من الأسى","وقد عيل صبري بين واشٍ ولائمِ"],["تؤرِّقُ ورقُ الغوطتين لواحظي","ومُنحِل جسمي حب غزلان جاسِم"],["أَأَحبابنا إِن كنتم قد عزمتُمُ","على البعد عن أطلالكم والمعالمِ"],["فلا ترسلوا برقاً إِلى غير ساهرٍ","ولا تبعثوا طيفاً إلى غير نائمِ"],["أعاذلُ فيمن لست أسل وأذابني","فلو شئتُ من سُقمي تمنطقت خاتمي"],["ذَرِ العَذْلَ في تسكاب طَرْفي، لطَرفِهِ","ولا تدخُلَنْ ما بين ساجٍ وساجِمِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D8%B1%D9%88%D9%82_%D8%A7%D9%84%D8%BA%D9%88%D8%A7%D8%AF%D9%8A_%D8%A3%D9%85_%D8%A8%D8%B1%D9%88%D9%82_%D8%A7%D9%84%D9%85%D8%A8%D8%A7%D8%B3%D9%85"},"urqula-0026":{"t":"بكى لي حاسدي مينا وأدري","v":[["بكى لي حاسدي ميْناً وأَدري","بضحك فؤاده بين الضلوعِ"],["وأكذب ما يكون الحزن يوماً","إِذا كان البكاء بلا دموعِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A8%D9%83%D9%89_%D9%84%D9%8A_%D8%AD%D8%A7%D8%B3%D8%AF%D9%8A_%D9%85%D9%8A%D9%86%D8%A7_%D9%88%D8%A3%D8%AF%D8%B1%D9%8A"},"urqula-0027":{"t":"تراهم حين صدوا عن لقائي","v":[["تُراهْم حين صدّوا عن لقائي","على ذاك التقالي والتنائي"],["أَبِيتُ الليلَ مكروباً جلوباً","إلى حرّ الهوى يردَ الهواءِ"],["وهل تبرا الجوارحُ من جراحِ","اصابتها ظبى حدقِ الظباءِ"],["أَيجملُ أَن أُضامَ وَدُرُّ نظمي","وما شأن الدُّمى سفكَ الدِماءِ"],["بنفسي مُعرِضاً بعد اعتراضٍ","ملولاً مالداءٍ من دواءِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%B1%D8%A7%D9%87%D9%85_%D8%AD%D9%8A%D9%86_%D8%B5%D8%AF%D9%88%D8%A7_%D8%B9%D9%86_%D9%84%D9%82%D8%A7%D8%A6%D9%8A"},"urqula-0028":{"t":"ترى عند من أحببته لا عدمته","v":[["ترى عند من أحببتهُ، لا عدمتهُ","من الشوق ما عندي وما أنا صانع"],["جميعي، إذا حدَّثتُ عن ذاك ألسنٌ","وكلّي، إِذا حُدِّثتُ عنه، مسامع"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%B1%D9%89_%D8%B9%D9%86%D8%AF_%D9%85%D9%86_%D8%A3%D8%AD%D8%A8%D8%A8%D8%AA%D9%87_%D9%84%D8%A7_%D8%B9%D8%AF%D9%85%D8%AA%D9%87"},"urqula-0031":{"t":"تعلمت منك الغصون","v":[["تعلمت منك الغصون","الجود والقدَّ الرَّشقْ"],["لكنني قلت لها","عنك ومنك تسترقْ"],["ما من يجود بالورقْ","كمن يجود 