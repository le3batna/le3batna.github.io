{"poet":{"id":"adi-zayd","short":"عدي بن زيد","name":"عدي بن زيد العبادي","en":"Adi ibn Zayd","era":"pre-islamic"},"poems":{"adi-zayd-0001":{"t":"أبلغ أبيا على نأيه","v":[["أَبلِغ أُبَيّاً عَلى نَأيِهِ","وَهَل يَنفَعُ المَرءَ ما قَد عَلِم"],["بِأَنَّ أَخاكَ شَقيقَ الفُوا","دِ كُنتَ بِهِ وَاثِقاً ما سَلِم"],["لَدى مَلِكٍ موثَقٌ في الحَدي","د إِمّا بِحَقٍّ وَإِمّا ظُلِم"],["فَلا أَعرِفَنكَ كَدَأبِ الغُلا","م ما لَم يَجِد عارِماً يَعتَرِم"],["فَأَرضُكَ أَرضُكَ إِن تَأتِنا","نَنَم لَيلَةً لَيسَ فيها حُلُم"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%A8%D9%84%D8%BA_%D8%A3%D8%A8%D9%8A%D8%A7_%D8%B9%D9%84%D9%89_%D9%86%D8%A3%D9%8A%D9%87"},"adi-zayd-0002":{"t":"أبلغ النعمان عني مالكا","v":[["أَبلِغِ النُعمانَ عَنّي مَألَكاً","إِنَّني قَد طالَ حَبسي وَاِنتِظاري"],["لَو بِغَيرِ الماءِ حَلقي شَرِقٌ","كَنتُ كَالغَصّانِ بِالماءِ اِعتِصاري"],["وَعُداتي شَمِتَت أَعجَبَهُم","أَنَّني غُيِّبتُ عَنهُم في إِساري"],["فَلَئِن دَهرٌ تَوَلّى خَيرُهُ","وَجَرَت بِالنَحسِ لي مِنهُ الجَواري"],["لي بِما مِنهُ قَضَينا حاجَةٌ","وَحَياةُ المَرءِ كَالشَيءِ المُعارِ"],["لَثِقَ الريشُ تَدَلّى غُدوَةً","مِن أَعالي صَعبَةِ المَرقى طَمارِ"],["لَيتَ شِعري عَن دَخيلٍ يَفتَري","حَيثُما أَدرَكَ لَيلي وَنَهاري"],["لِاِمرِئٍ لَم يَبلُ مِنّي سَقطَةً","إِن أَصابَتهُ مُلِمّاتُ العِثارِ"],["قاعِداً يَكرُبُ نَفسي بَثُّها","وَحَراماً كانَ سِجني وَاِحتِصاري"],["نَحنُ كُنّا قَد عَلِمتُم قَبلَكُم","عُمُدَ البَيتِ وَأَوتادَ الإِصارِ"],["وَأَبوكَ المَرءُ لَم يُشنَأ بِهِ","يَومَ سيمَ الخَسفَ مِنّا ذو الخَسارِ"],["أَجَل نُعمى رَبُّها أَوَّلَكُم","وَدُنُوّي كانَ مِنكُم وَاِصطِهاري"],["أَجلَ إِنَّ اللَهَ قَد فَضَّلَكُم","فَوقَ مَن أَحكَأَ صُلباً بِإِزارِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%A8%D9%84%D8%BA_%D8%A7%D9%84%D9%86%D8%B9%D9%85%D8%A7%D9%86_%D8%B9%D9%86%D9%8A_%D9%85%D8%A7%D9%84%D9%83%D8%A7"},"adi-zayd-0005":{"t":"إجتنب أخلاق من لم ترضه","v":[["إِجتَنِب أَخلاقَ مَن لَم تَرضَهُ","لا تَعِبهُ ثُمَّ تَقفو في الأَثَر"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D8%AC%D8%AA%D9%86%D8%A8_%D8%A3%D8%AE%D9%84%D8%A7%D9%82_%D9%85%D9%86_%D9%84%D9%85_%D8%AA%D8%B1%D8%B6%D9%87"},"adi-zayd-0006":{"t":"أحسبت مجلسنا وحسن جدي","v":[["أَحَسِبتَ مَجلِسَنا وَحُسنَ جدي","ثِنا يودي بِمالِك"],["فَالمالُ وَالأَهلونَ مَصٌ","رعة لِأَمرِكَ أَو نَكالِك"],["ما تَأمُرَن فينا فَأَم","رك في يَمينِكَ أَو شِمالِك"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%AD%D8%B3%D8%A8%D8%AA_%D9%85%D8%AC%D9%84%D8%B3%D9%86%D8%A7_%D9%88%D8%AD%D8%B3%D9%86_%D8%AC%D8%AF%D9%8A"},"adi-zayd-0008":{"t":"أرواح مودع أم بكور","v":[["أَرواحٌ مُوَدِّعٌ أَم بُكورُ","لَكَ فَاِعمَد لِأَيِّ حالٍ تَصيرُ"],["وَسطَهُ كَاليَراعِ أَو سُرُجِ المجد","دل حيناً يَخبو وَحيناً يُنيرُ"],["مِثلُ نارِ الحَرّاضِ يَجلو ذثرى المُز","نِ لِمَن شامَهُ إِذا يَستَطيرُ"],["مَرِحٌ وَبلُهُ يَسُحُّ سُبوبَ الس","سَما مَجّاً كَأَنَّهُ مَنحورُ"],["زَجَلٌ عَجزُهُ يُجاوِبُهُ دُف","ف لِخُوانٍ مَأدوبَةٍ وَزَميرُ"],["كَدُمى العاجِ في المَحاريبِ أَو كَال","بَيضِ في الرَوضِ زَهرُهُ مُستَنيرُ"],["زَانَهُنَّ الشفُوفُ يَنضَحنَ بالمس","كِ وَعَيشٌ مُفانِقٌ وَحريرُ"],["وَيَقولُ العُداةَ أَودى عَدِيٌّ","وَعَدِيٌّ بِسُخطِ رَبٍّ أَسيرُ"],["أَيُّها الشامِتُ المُعَيِّرُ بِالدَه","ر أَ أَنتَ المُبَرَّأُ المَوفورُ"],["أَم لَدَيكَ العَهدُ الوَثيقُ مِنَ الأيْ","يامِ بَل أَنتَ جاهِلٌ مَغرورُ"],["إِن يُصِبني بَعضُ الهَناتِ فَلا وا","نٍ ضَعيفٌ وَلا أَكَبُّ عَثورُ"],["كَقَصيرٍ إِذ لَم يَجِد غَيرَ أَن جَد","دَعَ أَشرافَهُ لِمَكرٍ قَصيرُ"],["مَن رَأَيتَ المَنونَ خَلَّدنَ أَم مَن","ذا عَلَيهِ مِن أَن يُضامَ خَفيرُ"],["لا تُؤاتيكَ وَإِن صَحَوتَ وَإِن أج","هَدَ في العارِضَينِ مِنكَ القَتيرُ"],["أَينَ كِسرى كِسرى المُلوكِ أَنوشِر","وانُ أَم قَبلَهُ سابورُ"],["وَبَنو الأَصفَرِ الكِرامُ مُلوكُ الرو","م لَم يَبقَ مِنهُمُ مَذكورُ"],["وَأَخو الحَضرِ إِذ بَناهُ وَإِذ دِجْ","لة تُجنى إِلَيهِ وَالخابورُ"],["شادَهُ مَرمَراً وَجَلَّلَهُ كِلْ","سا فَلِلطَيرِ في ذُراهُ وُكورُ"],["لَم يَهَبهُ رَيبُ المَنونِ فَبادَ الْ","ملك عَنهُ فَبابُهُ مَهجورُ"],["وَتَذَكَّر رَبُّ الخَوَرنَقِ إِذ أَشْ","رفَ يَوماً لِلهُدى تَفكيرُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D8%B1%D9%88%D8%A7%D8%AD_%D9%85%D9%88%D8%AF%D8%B9_%D8%A3%D9%85_%D8%A8%D9%83%D9%88%D8%B1"},"adi-zayd-0010":{"t":"ألا من مبلغ النعمان عني","v":[["أَلا مَن مُبلِغُ النُعمانِ عَنّي","فَبَينا المَرءُ أَغرَبَ إِذ أَراحا"],["أَطَعتُ بَني نَفيلَةَ في وِثاقي","وَكُنّا مِن حُلوقِهِمِ ذُباحا"],["مَنَحتُهُمُ الفُراتَ وَجانِبَيهِ","وَتَسقينا الأَواجِنَ وَالمِلاحا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%84%D8%A7_%D9%85%D9%86_%D9%85%D8%A8%D9%84%D8%BA_%D8%A7%D9%84%D9%86%D8%B9%D9%85%D8%A7%D9%86_%D8%B9%D9%86%D9%8A"},"adi-zayd-0011":{"t":"إن للدهر صولة فاحذرنها","v":[["إِنَّ لِلدَهرِ صَولَةً فَاِحذَرنَها","لا تَنامَنَّ قَد أَمِنتَ الدُهورا"],["قَد يَبيتُ الفَتى صَحيحاً فَيَردى","بَعدَ ما كانَ آمِناً مَسرورا"],["إِنَّما الدَهرُ لَيِّنٌ وَنَطوحٌ","يَترُكُ العَظمَ واهِياً مَكسورا"],["فَسَلِ الناسَ أَينَ آلُ قُبَيسٍ","طَحطَحَ الدَهرُ قَبلَهُم سابورا"],["خَطَفَتهُ مَنِيَّةٌ فَتَرَدّى","وَهوَ في المُلكِ يَأمُلُ التَعميرا"],["وَبَنو الأَصفَرِ المُلوكُ كَذا لَم","يَترُكِ الدَهرُ مِنهُمُ مَذكورا"],["لا أَرى المَوتَ يَسبِقُ المَوتَ شَيءٌ","نَغَّصَ المَوتُ ذا الغِنى وَالفَقيرا"]],"src":"https://ar.wikisource.org/wiki/%D8%A5%D9%86_%D9%84%D9%84%D8%AF%D9%87%D8%B1_%D8%B5%D9%88%D9%84%D8%A9_%D9%81%D8%A7%D8%AD%D8%B0%D8%B1%D9%86%D9%87%D8%A7"},"adi-zayd-0012":{"t":"أنعم صباحا علقم بن عدي","v":[["أَنعِم صَباحاً عَلقَمَ بنِ عَدِيٍّ","إِذا نَوَيتَ اليَومَ لَم تَرحَلِ"],["قَد رَحَّلَ الشُبّانُ غَيرَهُمُ","وَاللَحمُ بِالغيطانِ لَم يُنشَلِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%86%D8%B9%D9%85_%D8%B5%D8%A8%D8%A7%D8%AD%D8%A7_%D8%B9%D9%84%D9%82%D9%85_%D8%A8%D9%86_%D8%B9%D8%AF%D9%8A"},"adi-zayd-0013":{"t":"أيا منذرا كافيت بالود سخطة","v":[["أَيا مُنذِراً كافَيتَ بِالوُدِّ سَخطَةً","فَماذا جَزاءُ المُجرِمِ المُتَبَغِّضِ"],["فَإِنَّ جَزاءً يَرجى مِنكَ كَرامَةٌ","وَلَستُ لِنُصحٍ فيكَ بِالمُتَعَرِّضِ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%8A%D8%A7_%D9%85%D9%86%D8%B0%D8%B1%D8%A7_%D9%83%D8%A7%D9%81%D9%8A%D8%AA_%D8%A8%D8%A7%D9%84%D9%88%D8%AF_%D8%B3%D8%AE%D8%B7%D8%A9"},"adi-zayd-0014":{"t":"أين أهل الديار من قوم نوح","v":[["أَينَ أَهلُ الدِيارِ مَن قَومِ نوحٍ","ثُمَّ عادٍ مِن بَعدِهِم وَثَمودُ"],["بَينَما هُم عَلى الأَسِرَّةِ وَالأَنما","ط أَفضَت إِلى التُرابِ الجُلودُ"],["وَالأَطِبّاءُ بَعدَهُم لَحِقوهُم","ضَلَّ عَنهُم سَعوطُهُم وَاللَدودُ"],["وَصَحيحٌ أَضحى يَعودُ مَريضاً","وَهوَ أَدنى لِلمَوتِ مِمَّن يَعودُ"],["ثُمَّ لَم يَنقَضِ الحَديثُ وَلَكِن","بَعدَ ذا كُلِّهِ وَذاكَ الوَعيدُ"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%8A%D9%86_%D8%A3%D9%87%D9%84_%D8%A7%D9%84%D8%AF%D9%8A%D8%A7%D8%B1_%D9%85%D9%86_%D9%82%D9%88%D9%85_%D9%86%D9%88%D8%AD"},"adi-zayd-0015":{"t":"أيها الركب المخبو","v":[["أَيُّها الرَكبُ المَخِبّو","نَ عَلى الأَرضِ المُجِدّونا"],["كَما أَنتُم كَذا كُنّا","كَما نَحنُ تَكونونا"]],"src":"https://ar.wikisource.org/wiki/%D8%A3%D9%8A%D9%87%D8%A7_%D8%A7%D9%84%D8%B1%D9%83%D8%A8_%D8%A7%D9%84%D9%85%D8%AE%D8%A8%D9%88"},"adi-zayd-0017":{"t":"تزود من الشبعان خلفك نظرة","v":[["تَزَوَّد مِنَ الشَبعانِ خَلفَكَ نَظرَةً","فَإِنَّ بِلادَ الجوعِ حَيثُ تَميمُ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%B2%D9%88%D8%AF_%D9%85%D9%86_%D8%A7%D9%84%D8%B4%D8%A8%D8%B9%D8%A7%D9%86_%D8%AE%D9%84%D9%81%D9%83_%D9%86%D8%B8%D8%B1%D8%A9"},"adi-zayd-0018":{"t":"تضيف الحزن فانجابت عقيقته","v":[["ضَيِفَ الحُزنَ فَاِنجابَت عَقيقَتُهُ","فيها خِناذٌ وَتَقريبٌ بِلا تِيَمِ"],["يَنتابُ بِالعِراقِ مِن بُقعانَ مَعهَدَهُ","ماءَ الشَريعَةِ أَو فَيضاً مِنَ الأَجَمِ"],["أَهبَطَتَّهُ الرَكبَ يَعديني وَاُلجِمُهُ","لِلنائِباتِ بِسَيرٍ مَجذَمِ الأَكَمِ"]],"src":"https://ar.wikisource.org/wiki/%D8%AA%D8%B6%D9%8A%D9%81_%D8%A7%D9%84%D8%AD%D8%B2%D9%86_%D9%81%D8%A7%D9%86%D8%AC%D8%A7%D8%A8%D8%AA_%D8%B9%D9%82%D9%8A%D9%82%D8%AA%D9%87"},"adi-zayd-0022":{"t":"سما صقر فأشعل جانبيها","v":[["سَما صَقرٌ فأشعل جانِبَيها","وَالهاكَ المُرَوَّحُ وَالغَريبُ"],["وَثَبن لَدى المَثوبَةِ مُلجَماتٍ","وَصَبَّحنَ العِبادَ وَهُنَّ شيبُ"],["أَلا تِلكَ الغَنيمَةُ لا إِفالٌ","تُرَجّيها مَسَوَّمَةٌ وَنيبُ"],["تُرجّيها وَقَد صابَت بِقَرٍّ","كَما تَرجو أَصاغِرَها عَتيبُ"]],"src":"https://ar.wikisource.org/wiki/%D8%B3%D9%85%D8%A7_%D8%B5%D9%82%D8%B1_%D9%81%D8%A3%D8%B4%D8%B9%D9%84_%D8%AC%D8%A7%D9%86%D8%A8%D9%8A%D9%87%D8%A7"},"adi-zayd-0023":{"t":"طال الليل علينا واعتكر","v":[["طالَ اللَيلُ عَلَينا وَاِعتَكَر","وَكَأَنّي ناذِرُ الصُبحِ سَمَر"],["إِذ أَتاني نَبَأٌ مِن مُنعِمٍ","لَم أَخُنهُ وَالَّذي أَعطى الشَبَر"],["مِن نَجِيِّ الهَمِّ عَندي ثاوِياً","فَوقَ ما أُعلِنُ مِنهُ وَأُسِر"],["وَكأنَّ اللَيلَ فيهِ مِثلُهُ","وَلَقِدماً طُنَّ بِاللَيلِ القِصَر"],["لَم أُغَمِّض طولَهُ حَتّى اِنقَضى","أَتَمَنّى لَو أَرى الصُبحَ حَسَر"],["شَئِزٌ جَنبي كَأَنّي مُهدَأٌ","جَعَلَ القَينُ عَلى الدَفِّ الأَبَر"],["غَيرُ ما عِشقٍ وَلَكِن طارِقٌ","خَلَسَ النَومَ وَأَجداني السَهَر"],["أَبلِغِ النُعمانَ عَنّي مَألَكاً","فَولَ مَن قَد خافَ ظَنّاً فَاِعتَذَر"],["إِنَّني وَاللَهِ فَأَقبَل حِلفي","لَأَبيلٌ كُلَّما صَلّى جَأَر"],["مُرعَدٌ أَحشاؤُهُ في هَيكَلٍ","حَسَنٌ لِمَّتُهُ وافي الشَعَر"],["ما حَمَلتُ الغُلَّ مِن أَعدائِكُم","وَلَدى اللَهِ مِنَ العِلمِ المُسَر"],["لا تَكونَنَّ كَآسي عَظمِهِ","بِأَسىً حَتّى إِذا العَظمُ جُبِر"],["عادَ بَعدَ الجَبرِ يَنعى وَهنَهُ","يَنحُوَنَّ المَشيَ مِنهُ فَاِنكَسَر"],["وَاِذكُرِ النُعمى الَّتي لَم أَنسَها","لَكِ في السَعيِ إِذا العَبدُ كَفَر"]],"src":"https://ar.wikisource.org/wiki/%D8%B7%D8%A7%D9%84_%D8%A7%D9%84%D9%84%D9%8A%D9%84_%D8%B9%D9%84%D9%8A%D9%86%D8%A7_%D9%88%D8%A7%D8%B9%D8%AA%D9%83%D8%B1"},"adi-zayd-0024":{"t":"فإن لم تندموا فثكلت عمرا","v":[["فَإِن لَم تَندَموا فَثَكَلتُ عَمراً","وَهاجَرتُ المُرَوَّقَ وَالسَماعا"],["وَلا وَضَعَت يَدايَ عَنانَ طِرفٍ","وَلا أَبصَرتُ مِن شَمسٍ شُعاعا"]],"src":"https://ar.wikisource.org/wiki/%D9%81%D8%A5%D9%86_%D9%84%D9%85_%D8%AA%D9%86%D8%AF%D9%85%D9%88%D8%A7_%D9%81%D8%AB%D9%83%D9%84%D8%AA_%D8%B9%D9%85%D8%B1%D8%A7"},"adi-zayd-0025":{"t":"لبس جديدك إني لابس خلقي","v":[["لبَس جَديدَكَ إِنّي لابِسٌ خَلَقي","وَلا جَديدَ لِمَن لَم يَلبَسِ الخَلَقا"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D8%A8%D8%B3_%D8%AC%D8%AF%D9%8A%D8%AF%D9%83_%D8%A5%D9%86%D9%8A_%D9%84%D8%A7%D8%A8%D8%B3_%D8%AE%D9%84%D9%82%D9%8A"},"adi-zayd-0026":{"t":"للشرف العود فأكنافه","v":[["للشَرَفُ العَودُ فَأَكنافُهُ","ما بَينَ حُمرانَ فَيَنصوبِ"],["خَيرٌ لَها إِن خَشِيَت حَجرَةً","مِن رَبِّها زَيدُ بنُ أَيّوبِ"],["مُتَّكِئاً تَخفِقُ أَبوابُهُ","يَسعى عَلَيهِ الغَيدُ بِالكوبِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%84%D8%B4%D8%B1%D9%81_%D8%A7%D9%84%D8%B9%D9%88%D8%AF_%D9%81%D8%A3%D9%83%D9%86%D8%A7%D9%81%D9%87"},"adi-zayd-0028":{"t":"لمن الدار تعفت بخيم","v":[["لَمِنَ الدارُ تَعَفَّت بِخِيم","أَصبَحَت غَيَّرَها طولُ القِدَم"],["ما تَبينُ العَينُ مِن آياتِها","غَيرَ نُؤيٍ مِثلِ خَطٍّ بِالقَلَم"],["وَثَلاثٍ كَالحَماماتِ بِها","بَينَ مَجثاهُنَّ تَوشيمُ الحِمَم"],["أَسأَلُ الدارَ وَقَد أَنكَرتُها","عَن حَبيبٍ فَإِذا فيها صَمَم"],["صالِحاً قَد لَفَّها فَاِستَوثَقَت","لَفَّ بَأزِيٍّ حَماماً في سَلَم"],["فَهوَ كَالدَلوِ بِكَفِّ المُستَقي","خَذَلَت عَنهُ العَراقي فَاِنجَذَم"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%85%D9%86_%D8%A7%D9%84%D8%AF%D8%A7%D8%B1_%D8%AA%D8%B9%D9%81%D8%AA_%D8%A8%D8%AE%D9%8A%D9%85"},"adi-zayd-0029":{"t":"ليت شعري عن الهمام ويأتي","v":[["لَيتَ شِعري عَنِ الهُمامِ وَيَأتي","ك بِخَيرِ الأَنباءِ عَطفُ السُؤالِ"],["أَينَ عَنّا إِخطارُنا المالَ وَالأَن","فس إِذ ناهَدوا لِيَومِ المَجالِ"],["وَنِضالي في جَنبِكَ الناسَ يَرمو","نَ وَأَرمي وَكُلُّنا غَيرُ آلِ"],["فَأُصيبُ الَّذي تُريدُ بِلا غِش","شٍ وَأُربي عَلَيهِمِ وَأُوالي"],["وَبِعَينيكَ كُلُّ ذاكَ تَخَطْرا","كَ وَيُمضيكَ نَبلُهُم في النِضالِ"],["جاعِلاً سِرَّكَ التُخومَ فَما أَح","فل قَولَ الوُشاةِ وَالأَنذالِ"],["لَيتَ أَنّي أَخَذتُ حَتفي بِكَفّي","وَلَم أُلقَ مَنِيَّتي في القِتالِ"],["مَحَلوا مَحلَهُم لِصَرعَتِنا العا","مَ فَقَد أَوقَعوا الرَحا بِالثِقالِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%8A%D8%AA_%D8%B4%D8%B9%D8%B1%D9%8A_%D8%B9%D9%86_%D8%A7%D9%84%D9%87%D9%85%D8%A7%D9%85_%D9%88%D9%8A%D8%A3%D8%AA%D9%8A"},"adi-zayd-0030":{"t":"ليس شيء على المنون بباق","v":[["لَيسَ شَيءٌ عَلى المَنونِ بِباقِ","غَيرُ وَجهِ المُسَبَّحِ الخَلّاقِ"],["إِن نَكُن آمِنينَ فَأَجَأَنا شَر","ر مُصيبٌ ذا الوُدِّ وَالإِشفاقِ"],["فَبَرِيءٌ صَدري مِنَ الظُلمِ لِلرَب","ب وَحِنثٍ بِمُمقَدِ الميثاقِ"],["وَلَقَد ساءَني زِيارَةُ ذي قُر","بى حَبيبٍ لِوُدِّنا مُشتاقِ"],["ساءَهُ ما بِنا تَبَيَّنَ في الأَيدي","وَاِشناقُها إِلى الأَعناقِ"],["وَاِذهَبي يا أُمَيمَ إِن يَشَإِ اللَهُ","يُنَفِّس مِن أَزمِ هَذا الخِناقِ"],["أَو تَكُن وُجهَةٌ فَتِلكَ سَبيلُ النا","س لا تَمنَعُ الحُتوفَ الرَواقي"],["وَتَقولُ العُداة أَو دى عَدِيٌّ","وَبَنوهُ قَد أَيقَنوا بِعَلاقِ"],["يا أَبا مُسهِرٍ فَأَبلِغ رَسولاً","إِخوَتي أَن أَتَيتَ صَحنَ العِراقِ"],["فَاِركَبوا في الحَرامِ فُكّوا أَخاكُم","إِنَّ عَيراً قَد جُهِّزَت لِاِنطِلاقِ"],["في حَديدِ القِسطاس يَرقُبُني الحا","رِسُ وَالمَرءُ كُلَّ شَيءٍ يُلاقي"],["في حَديدٍ مُضاعِفٍ وَغُلولٍ","وَثِيابٍ مُنَضَّحاتٍ خَلاقِ"]],"src":"https://ar.wikisource.org/wiki/%D9%84%D9%8A%D8%B3_%D8%B4%D9%8A%D8%A1_%D8%B9%D9%84%D9%89_%D8%A7%D9%84%D9%85%D9%86%D9%88%D9%86_%D8%A8%D8%A8%D8%A7%D9%82"},"adi-zayd-0031":{"t":"ماذا ترجون إن أودى ربيعكم","v":[["ماذا تُرَجّونَ إِن أَودى رَبيعُكُم","بَعدَ الإِلَهِ وَمَن أَذكى لَكُم نارا"],["كَلّا يَميناً بِذاتِ الوَرعِ لَو حَدَثَت","فيكُم وَقابَلَ قَبرُ الماجِدِ الزارا"],["بِتَلِّ حَجوَشَ ما يَدعو امُؤذِّنُهُم","لِأَمرِ دَهرٍ وَلا يَحتَثُّ أَنفارا"],["وَأَحوَرُ العَينِ مَربوبٍ لَهُ غُسَنٌ","مُقَلَّدٍ مِن نَظامِ الدُرِّ تَقصارا"],["عَفِّ المَكاسِبِ ما تُكدى حُسافَتُهُ","كَالبَحرِ يَقذِفُ بِالتَيّارِ تَيّارا"],["وَذي تَناويرَ مَمعونٌ لَهُ صَبَحٌ","يَغذو أَوابِدَ قَد أَفلَينَ أَمهارا"],["كَأَنَّ رَيِّقَهُ شُؤبوبُ غادِيَةٍ","لَمّا تَقَفّى رَقيبُ النَفعِ مُسطارا"],["وَلا تَحُلُّ نَبِيَّ البِشرِ قُبَّتُهُ","تَسومُهُ الرومُ إِن تُعطوهُ قِنطارا"],["فَأَيُّكُم لَم يَنَلهُ عُرفُ نائِلِهِ","دَثراً سَواماً وَفي الأَريافِ أَوصارا"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%A7%D8%B0%D8%A7_%D8%AA%D8%B1%D8%AC%D9%88%D9%86_%D8%A5%D9%86_%D8%A3%D9%88%D8%AF%D9%89_%D8%B1%D8%A8%D9%8A%D8%B9%D9%83%D9%85"},"adi-zayd-0032":{"t":"مضمم أطراف العظام محنبا","v":[["مُضَمِّمُ أَطرافَ العِظامِ مُحَنَّباً","يُهَزهِزُ غُصناً ذا ذَوائِبَ مائِعا"],["أَجالَ عَلَيهِ بِالقَناةِ غُلامُنا","فَأَذرَعنَهُ لِخِلَّةِ الشاةِ راقِعا"],["فَضافَ يُعَرّي جُلَّهُ عَن سَراتِهِ","يَبُدُّ الجِيادَ فارِهاً مُتَتابِعا"],["فَآضَ كَصَدرِ الرُمحِ نَهداً مُصَدِّراً","يُكَفكِفُ مِنهُ خُنزُواناً مُنازِعا"],["وَما خُنتُ ذا عَهدٍ وَأُبتُ بِعهدِهِ","وَلَم أَحرِمِ المُضطَرَّ إِذ جاءَ قانِعا"],["أَراهُم بِحَمدِ اللَهِ بَعدَ خَجيفِهِم","غُرابُهُم إِذ مَسَّهُ الفَترُ واقِعا"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D8%B6%D9%85%D9%85_%D8%A3%D8%B7%D8%B1%D8%A7%D9%81_%D8%A7%D9%84%D8%B9%D8%B8%D8%A7%D9%85_%D9%85%D8%AD%D9%86%D8%A8%D8%A7"},"adi-zayd-0034":{"t":"من يكن ذا لقح راخيات","v":[["مَن يَكُن ذا لُقَحٍ راخِياتٍ","فَلِقاحي ما تَذوقُ الشَعيرا"],["بَل حَوابٍ في ظِلالِ فَسيلٍ","مُلِئَت أَجوافُهُنَّ عَصيرا"],["فَتَهادَرنَ كَذاكَ زَماناً","ثمَّ مُوِّتنَ فَكُنَّ قُبورا"]],"src":"https://ar.wikisource.org/wiki/%D9%85%D9%86_%D9%8A%D9%83%D9%86_%D8%B0%D8%A7_%D9%84%D9%82%D8%AD_%D8%B1%D8%A7%D8%AE%D9%8A%D8%A7%D8%AA"},"adi-zayd-0036":{"t":"ناشدتنا بكتاب الله حرمتنا","v":[["ناشَدتَنا بِكتابِ اللَهِ حُرمَتَنا","وَلَم تَكُن بِكِتابِ اللَهِ تَرتَفِعُ"]],"src":"https://ar.wikisource.org/wiki/%D9%86%D8%A7%D8%B4%D8%AF%D8%AA%D9%86%D8%A7_%D8%A8%D9%83%D8%AA%D8%A7%D8%A8_%D8%A7%D9%84%D9%84%D9%87_%D8%AD%D8%B1%D9%85%D8%AA%D9%86%D8%A7"},"adi-zayd-0037":{"t":"نرقع دنيانا بتمزيق ديننا","v":[["نُرَقِّعُ دُنيانا بِتَمزيقِ دينِنا","فَلا دينُنا يَبقى وَلا ما نُرَقِّعُ"]],"src":"https://ar.wikisource.org/wiki/%D9%86%D8%B1%D9%82%D8%B9_%D8%AF%D9%86%D9%8A%D8%A7%D9%86%D8%A7_%D8%A8%D8%AA%D9%85%D8%B2%D9%8A%D9%82_%D8%AF%D9%8A%D9%86%D9%86%D8%A7"},"adi-zayd-0038":{"t":"وتفكر رب الخورنق إذ أش","v":[["وَتَفَكَّر رَبَّ الخَوَرنَقِ إِذ أش","رَفَ يَوماً وَلِلهُدى تَفكيرُ"],["سَرَّهُ حالُهُ وَكَثرَةُ ما يَم","لك وَالبَحرُ مُعرَضاً وَالسَديرُ"],["فَاِرعَوى قَلبُهُ وَقالَ فَما غَبْ","طة حَيٍّ إِلى المَماتِ يَصيرُ"],["ثُمَّ بَعدَ القَلاحِ وَالمُلكِ وَالنِع","مة وَأَرَتهُم هُناكَ القُبورُ"],["ثُمَّ صاروا كَأَنَّهُم وَرَقٌ جَف","ف فَأَلوَت بِهِ الصَبا وَالدَبورُ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%AA%D9%81%D9%83%D8%B1_%D8%B1%D8%A8_%D8%A7%D9%84%D8%AE%D9%88%D8%B1%D9%86%D9%82_%D8%A5%D8%B0_%D8%A3%D8%B4"},"adi-zayd-0040":{"t":"وغصن على الحيقار وسط جنوده","v":[["وَغُصنَ عَلى الحَيقارِ وَسطَ جُنودِهِ","وَبَيَّنَ في فَيداشِهِ رَبُّ مارِدِ"],["سَلَبنَ قُباذاً رَبَّ فارِسَ مُلكَهُ","وَحَشَّت بِكَفَّيهِ بَوارِقُ آمِدِ"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D8%BA%D8%B5%D9%86_%D8%B9%D9%84%D9%89_%D8%A7%D9%84%D8%AD%D9%8A%D9%82%D8%A7%D8%B1_%D9%88%D8%B3%D8%B7_%D8%AC%D9%86%D9%88%D8%AF%D9%87"},"adi-zayd-0041":{"t":"ولا تأمنن من مبغض قرب داره","v":[["وَلا تَأمَنَن مِن مُبغِضٍ قُربَ دارِهِ","وَلا مِن مُحِبٍّ إِن يَمَلَّ فَيَبعُدا"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%84%D8%A7_%D8%AA%D8%A3%D9%85%D9%86%D9%86_%D9%85%D9%86_%D9%85%D8%A8%D8%BA%D8%B6_%D9%82%D8%B1%D8%A8_%D8%AF%D8%A7%D8%B1%D9%87"},"adi-zayd-0042":{"t":"ويح أم دار حللنا بها","v":[["وَيحَ أُمِّ دارٍ حَلَلنا بِها","بَينَ الثُوَيَّةِ وَالمَردَمَه"],["بَرِيَّةٍ غُرِسَت في السَوادِ","كَغَرسِ المَضيفَةِ في اللِهزِمَه"],["لِسانٌ لِعُربَةَ ذو وَلغَةٍ","تُوَلَّعُ في الريفِ بِالهَندَمَه"]],"src":"https://ar.wikisource.org/wiki/%D9%88%D9%8A%D8%AD_%D8%A3%D9%85_%D8%AF%D8%A7%D8%B1_%D8%AD%D9%84%D9%84%D9%86%D8%A7_%D8%A8%D9%87%D8%A7"},"adi-zayd-0044":{"t":"يا لرهطي أو قدوا نارا","v":[["يا لِرَهطي أَو قِدوا نارا","إِنَّ الَّذي تَهوَونَ قَد حارا"],["رُبَّ نارٍ بِتُّ أَرمِقُها","تَقضَمُ الهِندِيَّ وَالغارا"],["عِندَها خِلٌّ يُثَوِّرُها","عاقِدٌ في الجيدِ تِقصارا"]],"src":"https://ar.wikisource.org/wiki/%D9%8A%D8%A7_%D9%84%D8%B1%D9%87%D8%B7%D9%8A_%D8%A3%D9%88_%D9%82%D8%AF%D9%88%D8%A7_%D9%86%D8%A7%D8%B1%D8%A7"}}}